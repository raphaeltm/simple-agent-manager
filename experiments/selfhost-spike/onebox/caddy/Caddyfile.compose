{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	admin off
}

# Compose ingress: everything to the one celld Worker (web UI via the Worker assets binding).
*.{$DOMAIN} {
	# Local proof. Production: `tls { dns <provider> {env.DNS_API_TOKEN} }` (DNS-01, wildcard).
	tls internal
	encode zstd gzip

	# s3.<domain>: public endpoint for presigned R2 URLs only (bucket key prefix r2/).
	@s3 host s3.{$DOMAIN}
	handle @s3 {
		@notr2 not path /celld-fleet/r2/*
		respond @notr2 403
		reverse_proxy {$OBJECTSTORE_UPSTREAM}
	}

	handle {
		reverse_proxy {$CELLD_UPSTREAM} {
			header_up CF-Connecting-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up -True-Client-IP
			header_up -CF-Ray
		}
	}
}
