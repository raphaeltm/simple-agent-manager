# One public port (443) on the box: Caddy terminates TLS for the Worker (celld), the node tunnel
# (frp over WebSocket at frp's fixed path /~!frp), and (experiment) node WebSockets proxied by
# Caddy itself after the Worker authorizes them via forward_auth.
{
	local_certs
	skip_install_trust
	auto_https disable_redirects
}

box.spike.test:443 {
	tls internal
	@frp path /~!frp
	reverse_proxy @frp 127.0.0.1:7000
	reverse_proxy 127.0.0.1:8787
}

# Experiment: ws-{node}.spike.test — Worker decides auth and the upstream, Caddy carries the bytes.
*.spike.test:443 {
	tls internal
	forward_auth 127.0.0.1:8787 {
		uri /fwdauth
		copy_headers X-Node-Upstream
	}
	reverse_proxy {http.request.header.X-Node-Upstream}
}
