---
import ThemeToggle from './ThemeToggle.astro';
const { compact = false, home = '/', icon = '/favicon.png' } = Astro.props;

const getStartedUrl = 'https://www.simple-agent-manager.org/self-host/';

const navLinks = [
  { label: 'Features', href: '/features/' },
  { label: 'How It Works', href: '/#how-it-works' },
  { label: 'Comparison', href: '/#comparison' },
  { label: 'Enterprise', href: '/enterprise/' },
  { label: 'Integrations', href: '/integrations/' },
  { label: 'Docs', href: '/docs/' },
  { label: 'Blog', href: '/blog/' },
];
---

<!-- A floating glass bar. It stays inside the 64px `--header-height` band that pages offset by. -->
<header class:list={[{ compact }, "header sam-glass sam-glass--chrome sam-glass-rim sam-glass-live"]}>
  <a href={home} class="logo" aria-label="SAM Home">
    <img src={icon} width="30" height="30" alt="" aria-hidden="true" class="logo-icon" />
    <span class="logo-text">SAM</span>
  </a>

  {!compact && <nav class="nav" aria-label="Main navigation">
    {navLinks.map(({ label, href }) => (
      <a href={href} class="nav-link">{label}</a>
    ))}
  </nav>}

  <div class="header-actions">
    <ThemeToggle />
    {!compact && <a href="https://github.com/raphaeltm/simple-agent-manager" class="icon-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
    </a>}
    {!compact && <a href={getStartedUrl} class="sam-btn sam-btn--primary sam-btn--sm">Deploy SAM</a>}
  </div>

  {!compact && <button class="mobile-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
    <span></span>
    <span></span>
    <span></span>
  </button>}
</header>

<!-- Mobile menu: a glass sheet under the bar -->
{!compact && <div class="mobile-nav sam-glass sam-glass-rim sam-glass-live" id="mobile-nav">
  <nav aria-label="Main navigation">
    {navLinks.map(({ label, href }) => (
      <a href={href} class="mobile-nav-link">{label}</a>
    ))}
    <a href={getStartedUrl} class="sam-btn sam-btn--primary mobile-cta">Deploy SAM</a>
    <div class="mobile-theme">
      <span class="mobile-theme-label">Theme</span>
      <ThemeToggle />
    </div>
  </nav>
</div>}

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    mobileNav?.classList.toggle('is-open', open);
    toggle?.classList.toggle('is-active', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!mobileNav?.classList.contains('is-open')));
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

