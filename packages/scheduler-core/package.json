{
  "name": "@simple-agent-manager/scheduler-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure placement and capacity decisions of the SAM scheduler (no storage, no Cloudflare runtime)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scheduler": "vitest run tests/simulation/*.test.ts",
    "test:scheduler:nightly": "SCHEDULER_SIM_PROFILE=nightly vitest run tests/simulation/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@simple-agent-manager/shared": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "4.9.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
