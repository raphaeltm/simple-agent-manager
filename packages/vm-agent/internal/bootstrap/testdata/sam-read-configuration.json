{
  "configuration": {
    "name": "Simple Agent Manager",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
    "containerEnv": {
      "CODEX_HOME": "/workspaces/simple-agent-manager/.codex"
    },
    "features": {
      "ghcr.io/devcontainers/features/docker-in-docker:4": {},
      "ghcr.io/devcontainers/features/github-cli:1": {},
      "ghcr.io/devcontainers/features/go:1": {
        "version": "1.26.6",
        "golangciLintVersion": "2.11.4"
      }
    },
    "forwardPorts": [
      8787,
      5173,
      3001
    ],
    "portsAttributes": {
      "3001": {
        "label": "CloudCLI",
        "onAutoForward": "notify"
      },
      "5173": {
        "label": "Web UI",
        "onAutoForward": "notify"
      },
      "8787": {
        "label": "API",
        "onAutoForward": "notify"
      }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "bash .devcontainer/post-start.sh",
    "customizations": {
      "vscode": {
        "extensions": [
          "dbaeumer.vscode-eslint",
          "esbenp.prettier-vscode",
          "bradlc.vscode-tailwindcss",
          "golang.go"
        ],
        "settings": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    },
    "configFilePath": {
      "$mid": 1,
      "fsPath": "/workspaces/sam-pr-2274/.devcontainer/devcontainer.json",
      "path": "/workspaces/sam-pr-2274/.devcontainer/devcontainer.json",
      "scheme": "vscode-fileHost"
    }
  },
  "mergedConfiguration": {
