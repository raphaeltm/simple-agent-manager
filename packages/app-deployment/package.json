{
  "name": "@simple-agent-manager/app-deployment",
  "version": "0.1.0",
  "private": true,
  "description": "Worker side of SAM app deployments: compose rendering and publish, release routing, volumes, custom domains, environment config, publish jobs, image tag resolution and their sweeps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scheduled": {
      "types": "./dist/scheduled/index.d.ts",
      "import": "./dist/scheduled/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@simple-agent-manager/providers": "workspace:*",
    "@simple-agent-manager/shared": "workspace:*",
    "@simple-agent-manager/worker-core": "workspace:*",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
