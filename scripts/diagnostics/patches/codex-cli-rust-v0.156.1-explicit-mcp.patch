+#[tokio::test]
+async fn url_completion_notification_requires_capability_and_valid_id() -> anyhow::Result<()> {
+    for url_enabled in [false, true] {
+        let (completed_tx, mut completed_rx) = mpsc::unbounded_channel();
+        let mut info = ClientInfo::default();
+        if url_enabled {
+            info.capabilities.elicitation = Some(
+                ElicitationCapability::new().with_url(UrlElicitationCapability::new()),
+            );
+        }
+        let service = ElicitationClientService::new(
+            info,
+            Box::new(|_, _| Box::pin(async { anyhow::bail!("unexpected elicitation") })),
+            ElicitationPauseState::new(),
+        )
+        .with_completion_sender(Some(Arc::new(Box::new(move |id| {
+            let tx = completed_tx.clone();
+            Box::pin(async move { let _ = tx.send(id); })
+        }))));
+        let (client_transport, server_transport) = tokio::io::duplex(4096);
+        let client = serve_directly(service, client_transport, None);
+        let mut server = IntoTransport::<RoleServer, _, _>::into_transport(server_transport);
+        for (method, params) in [
+            ("notifications/elicitation/complete", json!({"elicitationId": "valid-id"})),
+            ("notifications/elicitation/complete", json!({"elicitationId": ""})),
+            ("notifications/other", json!({"elicitationId": "wrong-method"})),
+        ] {
+            server.send(ServerJsonRpcMessage::notification(
+                ServerNotification::CustomNotification(CustomNotification::new(method, Some(params))),
+            )).await?;
+        }
+        if url_enabled {
+            assert_eq!(timeout(Duration::from_secs(5), completed_rx.recv()).await?, Some("valid-id".to_string()));
+        }
+        tokio::task::yield_now().await;
+        assert!(completed_rx.try_recv().is_err());
+        client.cancel().await?;
+    }
+    Ok(())
+}
+
