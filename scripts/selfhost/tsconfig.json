{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../deploy/tsconfig.json",
  "compilerOptions": { "allowImportingTsExtensions": true },
  "include": ["**/*.ts"],
  // live/ imports API modules that resolve workspace packages through their built dist/, so it
  // has its own project, checked by the Self-host Live job after it builds them.
  "exclude": ["node_modules", "dist", "live"]
}
