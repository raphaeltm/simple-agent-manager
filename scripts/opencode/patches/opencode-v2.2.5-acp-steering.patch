new file mode 100644
index 0000000..c351f89
--- /dev/null
+++ b/packages/cli/src/acp/steering.ts
@@ -0,0 +1,49 @@
+import { RequestError, type ContentBlock } from "@agentclientprotocol/sdk"
+
+/**
+ * `_session/steering` adds input to the session's running ACP prompt turn. The request and
+ * response shapes match the Claude and Codex ACP adapters so one client handles all three.
+ * The turn that is already running stays the only prompt owner: steering never starts one.
+ */
+export const Method = "_session/steering"
+
+export type Request = {
+  readonly sessionId: string
+  readonly prompt: ReadonlyArray<ContentBlock>
+  readonly _meta?: { readonly steering?: { readonly idleBehavior?: "promptRequired" } }
+}
+
+export type Response = { readonly outcome: "injected" } | { readonly outcome: "promptRequired"; readonly reason: "noRunningTurn" }
+
+export const injected: Response = { outcome: "injected" }
+export const noRunningTurn: Response = { outcome: "promptRequired", reason: "noRunningTurn" }
+
+/**
+ * Advertised in `initialize._meta.steering`. Idle input is always returned unconsumed:
+ * this adapter has no detached-turn fallback, so `promptRequired` is the only idle behavior.
+ */
+export const capability = { supported: true, idleBehaviors: ["promptRequired"] } as const
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+
+export function parse(params: unknown): Request {
+  if (!isRecord(params)) throw RequestError.invalidParams(undefined, "steering params must be an object")
+  const { sessionId, prompt } = params
+  if (typeof sessionId !== "string" || sessionId.length === 0)
+    throw RequestError.invalidParams(undefined, "steering sessionId must be a non-empty string")
+  if (!Array.isArray(prompt) || prompt.length === 0)
+    throw RequestError.invalidParams(undefined, "steering prompt must be a non-empty array")
+  const meta = params["_meta"]
+  if (meta !== undefined && meta !== null && !isRecord(meta))
+    throw RequestError.invalidParams(undefined, "steering _meta must be an object")
+  const steering = isRecord(meta) ? meta["steering"] : undefined
+  if (steering !== undefined && !isRecord(steering))
+    throw RequestError.invalidParams(undefined, "steering _meta.steering must be an object")
+  const idleBehavior = isRecord(steering) ? steering["idleBehavior"] : undefined
+  if (idleBehavior !== undefined && idleBehavior !== "promptRequired")
+    throw RequestError.invalidParams(undefined, "unsupported steering idleBehavior")
+  return { sessionId, prompt: prompt as ContentBlock[] }
+}
+
+export * as ACPSteering from "./steering"
