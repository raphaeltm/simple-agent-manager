index 0000000..2c91774
--- /dev/null
+++ b/packages/cli/test/acp/steering.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, test } from "bun:test"
+import { delivered, interrupted, rpcError, startSession, startWire, succeeded, textDelta } from "./wire-fixture"
+
+const injected = { outcome: "injected" }
+const noRunningTurn = { outcome: "promptRequired", reason: "noRunningTurn" }
+
+// The first submission starts a turn that stays open until the test ends it; later
+// submissions are steers the test delivers explicitly.
+const openTurn = (prompts: () => number) => ({
+  onPrompt: ({ sessionID, id }: { readonly sessionID: string; readonly id: string }) =>
+    prompts() === 1 ? [delivered(sessionID, id)] : [],
+})
+
+describe("acp _session/steering", () => {
+  test("advertises steering with prompt-required idle behavior", async () => {
+    await using acp = await startWire()
+    const initialized = (await acp.initialize()) as { _meta?: unknown }
+    expect(initialized._meta).toEqual({ steering: { supported: true, idleBehaviors: ["promptRequired"] } })
+  })
+
+  test("returns idle input unconsumed and submits nothing", async () => {
+    await using acp = await startSession()
+    expect(await acp.steer(acp.sessionId, "no turn yet")).toEqual(noRunningTurn)
+    expect(acp.server.prompts).toHaveLength(0)
+  })
+
+  test("adds input to the running turn without a second prompt owner", async () => {
+    await using acp = await startSession(openTurn(() => acp.server.prompts.length))
+    let responded = false
+    const prompt = acp.prompt(acp.sessionId, "long task").then((response) => {
+      responded = true
+      return response
+    })
+    await acp.until(() => acp.server.prompts.length === 1, "original prompt submission")
+
+    expect(await acp.steer(acp.sessionId, "use tabs, not spaces")).toEqual(injected)
+    const [original, steer] = acp.server.prompts
+    expect(steer).toMatchObject({ sessionID: original.sessionID, text: "use tabs, not spaces", delivery: "steer" })
+    expect(steer.id).not.toBe(original.id)
+    // A concurrent ACP prompt is still refused while the turn runs.
+    expect((await rpcError(acp.prompt(acp.sessionId, "second owner"))).message).toBeDefined()
+
+    acp.server.send(delivered(original.sessionID, steer.id), textDelta(original.sessionID, "msg_a", "tabs"))
+    expect(responded).toBe(false)
+    acp.server.send(succeeded(original.sessionID))
+    expect((await prompt).stopReason).toBe("end_turn")
+    expect(acp.server.prompts).toHaveLength(2)
+  })
+
+  test("keeps the turn as owner when a steer lands after the loop decided to finish", async () => {
+    await using acp = await startSession(openTurn(() => acp.server.prompts.length))
+    let responded = false
+    const prompt = acp.prompt(acp.sessionId, "long task").then((response) => {
+      responded = true
+      return response
+    })
+    await acp.until(() => acp.server.prompts.length === 1, "original prompt submission")
+    expect(await acp.steer(acp.sessionId, "one more thing")).toEqual(injected)
+    const [original, steer] = acp.server.prompts
+
+    // Core finished the first execution before it saw the steer; it starts a successor.
+    acp.server.send(succeeded(original.sessionID))
+    await Bun.sleep(50)
+    expect(responded).toBe(false)
+    expect(await acp.steer(acp.sessionId, "and this too")).toEqual(injected)
+    const third = acp.server.prompts[2]
+
+    acp.server.send(
+      delivered(original.sessionID, steer.id),
+      delivered(original.sessionID, third.id),
+      textDelta(original.sessionID, "msg_b", "handled"),
+      succeeded(original.sessionID),
+    )
+    expect((await prompt).stopReason).toBe("end_turn")
+    expect(acp.server.cancelledInbox).toEqual([])
+    expect(await acp.steer(acp.sessionId, "after the turn")).toEqual(noRunningTurn)
+  })
+
+  test("ends the turn when the only steer holding it open fails admission", async () => {
+    let release: () => void = () => {}
+    const gate = new Promise<void>((resolve) => (release = resolve))
+    await using acp = await startSession({
+      ...openTurn(() => acp.server.prompts.length),
+      fetch: async (request) => {
+        const body = request.body as { text?: string } | undefined
+        if (request.path.endsWith("/prompt") && body?.text === "rejected steer") {
+          await gate
+          return Response.json({ _tag: "SessionNotFoundError", message: "gone" }, { status: 500 })
+        }
+        return undefined
+      },
+    })
+    const prompt = acp.prompt(acp.sessionId, "long task")
+    await acp.until(() => acp.server.prompts.length === 1, "original prompt submission")
+    const steer = acp.steer(acp.sessionId, "rejected steer").then(
+      (value) => ({ ok: true as const, value }),
+      (error: unknown) => ({ ok: false as const, error }),
+    )
+    await acp.until(
+      () => acp.server.requests.some((item) => (item.body as { text?: string })?.text === "rejected steer"),
+      "steer admission request",
+    )
+    acp.server.send(succeeded(acp.server.prompts[0].sessionID))
+    await Bun.sleep(50)
+    release()
+    expect((await steer).ok).toBe(false)
+    expect((await prompt).stopReason).toBe("end_turn")
+  })
+
+  test("cancels undelivered steers when the turn is interrupted", async () => {
+    await using acp = await startSession(openTurn(() => acp.server.prompts.length))
+    const prompt = acp.prompt(acp.sessionId, "long task")
+    await acp.until(() => acp.server.prompts.length === 1, "original prompt submission")
+    expect(await acp.steer(acp.sessionId, "never delivered")).toEqual(injected)
+    const [original, steer] = acp.server.prompts
+
+    acp.server.send(interrupted(original.sessionID))
+    expect((await prompt).stopReason).toBe("cancelled")
+    expect(acp.server.cancelledInbox).toEqual([{ sessionID: original.sessionID, inboxID: steer.id }])
+    expect(await acp.steer(acp.sessionId, "too late")).toEqual(noRunningTurn)
+  })
+
+  test("refuses slash commands and unsupported idle behaviors", async () => {
+    await using acp = await startSession(openTurn(() => acp.server.prompts.length))
+    const prompt = acp.prompt(acp.sessionId, "long task")
+    await acp.until(() => acp.server.prompts.length === 1, "original prompt submission")
+
+    expect(await rpcError(acp.steer(acp.sessionId, "/compact"))).toMatchObject({
+      code: -32602,
+      message: "Invalid params: slash commands cannot steer a running turn",
+    })
+    expect((await rpcError(acp.steer(acp.sessionId, "x", { steering: { idleBehavior: "startDetachedTurn" } }))).code).toBe(
+      -32602,
+    )
+    expect((await rpcError(acp.steer(acp.sessionId, []))).code).toBe(-32602)
+    expect(acp.server.prompts).toHaveLength(1)
+
+    acp.server.send(succeeded(acp.server.prompts[0].sessionID))
+    expect((await prompt).stopReason).toBe("end_turn")
+  })
+})
