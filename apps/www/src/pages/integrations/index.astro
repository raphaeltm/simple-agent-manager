---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CtaFooter from '../../components/CtaFooter.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import IntegrationCard from '../../components/integrations/IntegrationCard.astro';
import LinkCard from '../../components/integrations/LinkCard.astro';
import {
  agentIntegrations,
  agentMatrix,
  automationLinks,
  cloudIntegrations,
  cloudMatrix,
  codeHostingIntegrations,
  connectLinks,
  getBySlug,
  integrations,
  modelAccessIntegrations,
  modelAccessLinks,
  runtimeLinks,
  sections,
} from '../../data/integrations';

const baseDomain = import.meta.env.PUBLIC_BASE_DOMAIN || 'simple-agent-manager.org';
const siteUrl = `https://www.${baseDomain}`;

const section = (id: string) => {
  const found = sections.find((s) => s.id === id);
  if (!found) throw new Error(`Unknown integrations section: ${id}`);
  return found;
};

const nameOf = (slug: string) => getBySlug(slug)?.name ?? slug;

const agentRows = agentMatrix.map((row) => ({
  label: nameOf(row.slug),
  href: `/integrations/${row.slug}/`,
  cells: [row.apiKey, row.subscription, row.proxy, row.customEndpoint],
}));

const cloudRows = cloudMatrix.map((row) => ({
  label: nameOf(row.slug),
  href: `/integrations/${row.slug}/`,
  cells: [row.locations, row.volumes, row.credential],
}));

const agentNames = agentIntegrations.map((i) => i.shortName ?? i.name).join(', ');
const cloudNames = cloudIntegrations.map((i) => i.shortName ?? i.name).join(', ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SAM Integrations',
  numberOfItems: integrations.length,
  itemListElement: integrations.map((integration, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: integration.name,
    url: `${siteUrl}/integrations/${integration.slug}/`,
  })),
};
---

<Base
  title="Integrations: Agents, Clouds, Git Hosts and Triggers | SAM"
  description={`What SAM works with: ${agentNames} on ${cloudNames} or Cloudflare Containers, with GitHub, GitLab, webhooks and more.`}
>
  <Header />
  <main>
    <section class="hub-hero">
      <div class="container hub-hero-content">
        <span class="section-label animate-on-scroll">Integrations</span>
        <h1 class="hub-title animate-on-scroll">What SAM works with</h1>
        <p class="hub-subtitle animate-on-scroll">
          {agentIntegrations.length} coding agents, {cloudIntegrations.length} cloud providers plus Cloudflare
          Containers, GitHub and GitLab, and the triggers and tools around them. All of it runs on a SAM
          installation you deploy to your own Cloudflare account.
        </p>
        <nav class="jump-nav animate-on-scroll" aria-label="Integration sections">
          {sections.map((s) => <a href={`#${s.id}`}>{s.question}</a>)}
        </nav>
      </div>
    </section>

    <section class="section hub-section" id="ai-agents">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('ai-agents').label}</span>
          <h2 class="section-title">{section('ai-agents').question}</h2>
          <p class="section-subtitle">{section('ai-agents').description}</p>
        </div>
        <div class="card-grid">
          {agentIntegrations.map((i) => <IntegrationCard integration={i} />)}
        </div>
        <ComparisonTable
          caption="How each agent can sign in. Every option is per user, and a user can connect several accounts."
          rowHeader="Agent"
          columns={['Your API key', 'Subscription sign-in', 'Installation AI proxy', 'Custom endpoint']}
          rows={agentRows}
        />
      </div>
    </section>

    <hr class="divider" />

    <section class="section hub-section" id="cloud-providers">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('cloud-providers').label}</span>
          <h2 class="section-title">{section('cloud-providers').question}</h2>
          <p class="section-subtitle">{section('cloud-providers').description}</p>
        </div>
        <div class="card-grid">
          {cloudIntegrations.map((i) => <IntegrationCard integration={i} />)}
        </div>
        <ComparisonTable
          caption="Every provider runs workspaces and app deployments. Persistent volumes keep deployment data across node replacement."
          rowHeader="Provider"
          columns={['Locations', 'Persistent volumes', 'Credential']}
          rows={cloudRows}
        />
        <p class="note animate-on-scroll">
          SAM uses a project's cloud account first, then the user's, then one the installation administrator
          connected. Without any of them, work can still run on Cloudflare Containers.
        </p>
        <div class="card-grid">
          {runtimeLinks.map((l) => <LinkCard link={l} />)}
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section hub-section" id="model-access">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('model-access').label}</span>
          <h2 class="section-title">{section('model-access').question}</h2>
          <p class="section-subtitle">{section('model-access').description}</p>
        </div>
        <div class="card-grid">
          {modelAccessIntegrations.map((i) => <IntegrationCard integration={i} />)}
          {modelAccessLinks.map((l) => <LinkCard link={l} />)}
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section hub-section" id="code-hosting">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('code-hosting').label}</span>
          <h2 class="section-title">{section('code-hosting').question}</h2>
          <p class="section-subtitle">{section('code-hosting').description}</p>
        </div>
        <div class="card-grid">
          {codeHostingIntegrations.map((i) => <IntegrationCard integration={i} />)}
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section hub-section" id="automation">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('automation').label}</span>
          <h2 class="section-title">{section('automation').question}</h2>
          <p class="section-subtitle">{section('automation').description}</p>
        </div>
        <div class="card-grid">
          {automationLinks.map((l) => <LinkCard link={l} />)}
        </div>
        <ShotFrame
          src="/images/features/sam-triggers-sources.png"
          alt="The SAM Automation page listing a nightly scheduled audit, reactions to Datadog and Stripe webhooks, CI results, new GitHub issues and labelled pull requests, plus upcoming and recent runs."
          caption="A project's Automation page: schedules, webhook and GitHub reactions, and recent runs in one place."
        />
      </div>
    </section>

    <hr class="divider" />

    <section class="section hub-section" id="connect">
      <div class="container">
        <div class="hub-section-header animate-on-scroll">
          <span class="section-label">{section('connect').label}</span>
          <h2 class="section-title">{section('connect').question}</h2>
          <p class="section-subtitle">{section('connect').description}</p>
        </div>
        <div class="card-grid">
          {connectLinks.map((l) => <LinkCard link={l} />)}
        </div>
      </div>
    </section>

    <hr class="divider" />
    <CtaFooter />
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  .hub-hero {
    padding: 140px 0 40px;
  }

  @media (min-width: 768px) {
    .hub-hero {
      padding: 170px 0 56px;
    }
  }

  .hub-hero-content {
    max-width: 820px;
  }

  .hub-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    margin: 12px 0 20px;
  }

  .hub-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin-bottom: 28px;
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .jump-nav a {
    font-size: 0.875rem;
    padding: 8px 14px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .jump-nav a:hover {
    color: var(--color-fg-primary);
    border-color: var(--glass-border-hover);
  }

  .hub-section {
    scroll-margin-top: calc(var(--header-height) + 16px);
  }

  .hub-section-header {
    max-width: 720px;
    margin-bottom: 28px;
  }

  .hub-section-header .section-subtitle {
    margin: 0;
  }

  .card-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    margin-bottom: 28px;
  }

  .note {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
    margin: 20px 0;
    max-width: 760px;
  }

</style>
