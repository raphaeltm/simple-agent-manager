---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CtaFooter from '../../components/CtaFooter.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import { getRelated, integrations, sections } from '../../data/integrations';
import type { Integration } from '../../data/integrations';

export function getStaticPaths() {
  return integrations.map((integration) => ({
    params: { slug: integration.slug },
    props: { integration },
  }));
}

interface Props {
  integration: Integration;
}

const { integration } = Astro.props;
const related = getRelated(integration);
const sectionLabel = sections.find((s) => s.id === integration.category)?.label ?? 'Integration';
const displayName = integration.shortName || integration.name;
const steps = integration.howItWorks;

// One real UI capture per category, from the marketing screenshot pipeline (apps/web marketing-shots specs).
const screenshotByCategory: Partial<Record<Integration['category'], { src: string; alt: string; caption: string }>> = {
  'ai-agents': {
    src: '/images/features/sam-chat-tool-stream.png',
    alt: 'A project chat in SAM: the user asks for a ledger migration, the agent replies with a plan, and each file read, edit and test command appears as an expandable step.',
    caption: `Every agent, ${displayName} included, streams its work into project chat, where you can follow and steer it.`,
  },
  'cloud-providers': {
    src: '/images/features/sam-nodes-multi-provider.png',
    alt: 'The SAM Nodes page showing machines on Vultr, Scaleway and Hetzner with their location, hardware, monthly price, resource use and the workspaces running on each.',
    caption: 'Machines from every connected provider appear on one Nodes page, with hardware, price and the workspaces each one runs.',
  },
};
const screenshot = screenshotByCategory[integration.category];

const baseDomain = import.meta.env.PUBLIC_BASE_DOMAIN || 'simple-agent-manager.org';
const siteUrl = `https://www.${baseDomain}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Integrations', item: `${siteUrl}/integrations/` },
    { '@type': 'ListItem', position: 3, name: integration.name },
  ],
};
---

<Base title={integration.seoTitle} description={integration.seoDescription}>
  <Header />
  <main>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/integrations/">Integrations</a></li>
          <li aria-current="page">{integration.name}</li>
        </ol>
      </div>
    </nav>

    <section class="detail-hero">
      <div class="container">
        <div class="detail-hero-grid">
        <div class="hero-logo animate-on-scroll">
          <img src={integration.logoPath} alt="" width="72" height="72" />
        </div>
        <div class="hero-text">
          <span class="section-label animate-on-scroll">{sectionLabel}</span>
          <h1 class="detail-title animate-on-scroll">{integration.name}</h1>
          <p class="detail-tagline animate-on-scroll">{integration.tagline}</p>
          <p class="detail-subtitle animate-on-scroll">{integration.description}</p>
          {integration.models && (
            <ul class="model-badges animate-on-scroll" aria-label="Example models">
              {integration.models.map((model) => <li class="model-badge">{model}</li>)}
            </ul>
          )}
          <div class="hero-actions animate-on-scroll">
            {integration.docsPath && (
              <a href={integration.docsPath} class="sam-btn sam-btn--primary">Read the setup guide</a>
            )}
            <a href={integration.externalUrl} class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">
              {integration.externalLabel}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <h2 class="section-title block-title animate-on-scroll">What you get</h2>
        <div class="card-grid">
          {integration.features.map((f) => (
            <div class="info-card animate-on-scroll">
              <h3>{f.title}</h3>
              <p>{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {screenshot && (
      <section class="section section--tight">
        <div class="container">
          <ShotFrame src={screenshot.src} alt={screenshot.alt} caption={screenshot.caption} />
        </div>
      </section>
    )}

    <section class="section section--tight">
      <div class="container"><div class="narrow">
        <h2 class="section-title block-title animate-on-scroll">
          Set it up in {steps.length} {steps.length === 1 ? 'step' : 'steps'}
        </h2>
        <ol class="step-list">
          {steps.map((item, i) => (
            <li class="step-item animate-on-scroll">
              <span class="step-number" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{item.step}</h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div></div>
    </section>

    {integration.useCases.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <h2 class="section-title block-title animate-on-scroll">Good for</h2>
          <div class="card-grid">
            {integration.useCases.map((uc) => (
              <div class="info-card animate-on-scroll">
                <h3>{uc.title}</h3>
                <p>{uc.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {integration.faq.length > 0 && (
      <section class="section section--tight">
        <div class="container"><div class="narrow">
          <h2 class="section-title block-title animate-on-scroll">Questions</h2>
          <div class="faq-list">
            {integration.faq.map((item) => (
              <details class="faq-item animate-on-scroll">
                <summary class="faq-question">{item.question}</summary>
                <p class="faq-answer">{item.answer}</p>
              </details>
            ))}
          </div>
        </div></div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <h2 class="section-title block-title animate-on-scroll">Related integrations</h2>
          <div class="related-grid">
            {related.map((rel) => (
              <a href={`/integrations/${rel.slug}/`} class="related-card animate-on-scroll">
                <img src={rel.logoPath} alt="" width="36" height="36" loading="lazy" />
                <span>
                  <span class="related-name">{rel.name}</span>
                  <span class="related-tagline">{rel.tagline}</span>
                </span>
              </a>
            ))}
          </div>
          <p class="all-link"><a href="/integrations/">All integrations</a></p>
        </div>
      </section>
    )}

    <hr class="divider" />
    <CtaFooter />
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Base>

<style>
  .breadcrumb {
    padding-top: calc(var(--header-height) + 16px);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-dim);
  }

  .breadcrumb-list li:not(:last-child)::after {
    content: '/';
    margin-left: 8px;
  }

  .breadcrumb-list a {
    color: var(--color-fg-muted);
  }

  .detail-hero {
    padding: 40px 0 24px;
  }

  .detail-hero-grid {
    display: grid;
    gap: 24px;
    max-width: 880px;
  }

  @media (min-width: 768px) {
    .detail-hero-grid {
      grid-template-columns: 72px 1fr;
      gap: 32px;
    }
  }

  .hero-logo img {
    display: block;
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.25);
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-fg-primary);
    margin: 8px 0 8px;
  }

  .detail-tagline {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .detail-subtitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    max-width: 680px;
    margin-bottom: 20px;
  }

  .model-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .model-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    padding: 4px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-actions .sam-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .section--tight {
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .block-title {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    margin-bottom: 24px;
  }

  .narrow {
    max-width: 760px;
  }

  .card-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .info-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .info-card h3,
  .step-item h3 {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-fg-primary);
    margin-bottom: 8px;
  }

  .info-card p,
  .step-item p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }


  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .step-item {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    align-items: start;
    padding: 20px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .faq-list {
    display: grid;
    gap: 8px;
  }

  .faq-item {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
  }

  .faq-question {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 16px 20px;
    font-weight: 500;
    color: var(--color-fg-primary);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--color-fg-dim);
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 20px 16px;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .related-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .related-card {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    text-decoration: none;
  }

  .related-card:hover {
    border-color: var(--glass-border-hover);
  }

  .related-card img {
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .related-name {
    display: block;
    font-weight: 600;
    color: var(--color-fg-primary);
  }

  .related-tagline {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
  }

  .all-link {
    margin-top: 20px;
    font-size: 0.9375rem;
  }
</style>
