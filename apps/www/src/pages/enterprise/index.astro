---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CtaFooter from '../../components/CtaFooter.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import WhatRunsWhere from '../../components/enterprise/WhatRunsWhere.astro';
import { enterprisePages, SUPPORT_EMAIL } from '../../data/enterprise';

const answers = [
  {
    topic: 'Sign-in and roles',
    answer: 'GitHub, Google or GitLab sign-in and email codes, optional signup approval. Installation roles (superadmin, admin, user) and project roles (owner, admin, maintainer, viewer).',
    href: '/enterprise/governance/',
  },
  {
    topic: 'Isolation',
    answer: 'The VM is the boundary. A machine belongs to one user; devcontainers may be privileged so agents can run Docker.',
    href: '/enterprise/security/',
  },
  {
    topic: 'Network',
    answer: 'The agent port admits only Cloudflare, or a tunnel removes it. SSH is dropped, and containers cannot reach the cloud metadata endpoint. Outbound traffic is open.',
    href: '/enterprise/security/',
  },
  {
    topic: 'Secrets',
    answer: 'AES-256-GCM with a unique IV per credential. Machines never hold cloud provider tokens. Node and workspace tokens are short-lived and scoped.',
    href: '/enterprise/compliance/',
  },
  {
    topic: 'Data location',
    answer: 'Control plane, chat history and snapshots in your Cloudflare account. Code on your machines and your Git host. Prompts at your model provider.',
    href: '/enterprise/compliance/',
  },
  {
    topic: 'Cost controls',
    answer: 'No SAM fee. Per-user budgets on proxied AI traffic, monthly vCPU-hour quotas on shared compute, and an admin cost page.',
    href: '/enterprise/cost-control/',
  },
  {
    topic: 'Backups',
    answer: 'D1 point-in-time restore for 30 days, a recovery bookmark before every migration, and a deploy that stops if a migration loses rows.',
    href: '/docs/guides/self-hosting/',
  },
  {
    topic: 'Source and updates',
    answer: 'AGPL-3.0, one public repository. Self-hosted installations take new releases when you run the update workflow.',
    href: '/enterprise/open-source/',
  },
];

const notYet = [
  { item: 'SSO with SAML or a generic OIDC provider', detail: 'Sign-in is GitHub, Google, GitLab or email codes, so Okta or Entra ID cannot be connected directly.' },
  { item: 'SCIM provisioning and organizations', detail: 'There is no organization or team level above projects.' },
  { item: 'Exportable audit log', detail: 'Chat and tool history is kept per project, but user actions cannot be exported to a SIEM.' },
  { item: 'Outbound network allowlisting', detail: 'Agent machines can reach any internet address.' },
  { item: 'Enforced policies', detail: 'Project policies are instructions agents read, not technical controls.' },
  { item: 'Chat history outside Cloudflare', detail: 'Messages and snapshots are stored in your Cloudflare account; there is no option to use your own database.' },
  { item: 'Bedrock, Vertex AI or Azure OpenAI', detail: 'Only compatible endpoints for Claude Code, Codex and OpenCode.' },
  { item: 'GitHub Enterprise Server', detail: 'GitHub.com, GitLab.com and self-managed GitLab are supported.' },
];
---

<Base
  title="SAM for Teams and Enterprises: Self-Hosted Agent Infrastructure"
  description="A security and platform review of SAM: what runs where, where data is stored, sign-in and roles, isolation, cost controls, and what SAM does not do yet."
>
  <Header />
  <main>
    <section class="ent-hero">
      <div class="container ent-hero-content">
        <span class="section-label animate-on-scroll">Enterprise</span>
        <h1 class="ent-hero-title animate-on-scroll">Run your team's coding agents on infrastructure you own</h1>
        <p class="ent-hero-subtitle animate-on-scroll">
          SAM is open-source software you deploy to your own Cloudflare account. Agents run on cloud machines you
          connect, with the models and Git hosts you already use. There is no hosted service. This page is for the
          person doing the platform and security review.
        </p>
        <div class="ent-hero-actions animate-on-scroll">
          <a href="/self-host/" class="sam-btn sam-btn--primary">Self-host SAM</a>
          <a href="/docs/architecture/security/" class="sam-btn sam-btn--glass">Security architecture</a>
          <a href={`mailto:${SUPPORT_EMAIL}`} class="sam-btn sam-btn--glass">Get support</a>
        </div>
        <dl class="ent-facts animate-on-scroll">
          <div><dt>Hosting</dt><dd>Self-hosted only</dd></div>
          <div><dt>Install</dt><dd>About 30 minutes</dd></div>
          <div><dt>Licence</dt><dd>AGPL-3.0</dd></div>
          <div><dt>SAM fee</dt><dd>None</dd></div>
        </dl>
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="what-runs-where">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">Architecture</span>
          <h2 class="section-title">What runs where</h2>
          <p class="section-subtitle">
            Three places, all under contracts you hold. The SAM project operates none of them.
          </p>
        </div>
        <WhatRunsWhere />
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="review">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">Security review</span>
          <h2 class="section-title">Short answers to the usual questions</h2>
        </div>
        <div class="answer-grid">
          {answers.map((a) => (
            <a href={a.href} class="answer-card animate-on-scroll">
              <h3>{a.topic}</h3>
              <p>{a.answer}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="product">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">In the product</span>
          <h2 class="section-title">Membership and spend, from the real app</h2>
        </div>
        <div class="shot-grid">
          <ShotFrame
            src="/images/features/sam-collab-members-access.png"
            alt="A project's Members page with an owner and admins, two pending access requests marked GitHub verified and no repo access, and an invite link."
            caption="Project owners approve access requests, with a repository-access check on each."
          />
          <ShotFrame
            src="/images/features/sam-admin-costs.png"
            alt="Admin Costs page showing month-to-date model cost, a projection, estimated compute cost, a daily cost chart, cost by model and cost by user."
            caption="Admin → Costs: proxied model spend by model and user, plus estimated compute cost."
          />
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="not-yet">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">Not yet</span>
          <h2 class="section-title">What SAM does not do yet</h2>
          <p class="section-subtitle">
            Better to know now than in week three of a rollout. If one of these blocks you, email
            <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> so it gets counted.
          </p>
        </div>
        <ul class="not-yet-list">
          {notYet.map((n) => (
            <li class="animate-on-scroll">
              <strong>{n.item}</strong>
              <span>{n.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="comparison">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">Comparison</span>
          <h2 class="section-title">SAM, a managed platform, or building your own</h2>
          <p class="section-subtitle">Typical trade-offs. Individual managed products vary.</p>
        </div>
        <ComparisonTable
          caption="How SAM compares with a typical managed agent platform and an internal build."
          rowHeader="Question"
          columns={['SAM', 'Managed agent platform', 'Build your own']}
          highlightColumn={0}
          rows={[
            { label: 'Where agents run', cells: ['Cloud accounts you connect, or Cloudflare Containers', 'The vendor\'s infrastructure', 'Your infrastructure'] },
            { label: 'Control plane', cells: ['Your Cloudflare account', 'Run by the vendor', 'Yours to build and run'] },
            { label: 'Agent choice', cells: ['Seven agents, chosen per profile', 'Usually the vendor\'s agent', 'Whatever you integrate'] },
            { label: 'Model billing', cells: ['Your keys and subscriptions', 'Usually bundled', 'Your keys'] },
            { label: 'Source code', cells: ['Open source, AGPL-3.0', 'Closed', 'Yours'] },
            { label: 'Enterprise SSO', cells: ['Not yet', 'Usually included', 'Whatever you build'] },
            { label: 'Setup', cells: ['About 30 minutes with the installer, then connect a cloud', 'Sign up', 'Months of engineering'] },
            { label: 'Support', cells: ['Email support, best effort', 'Vendor support contract', 'Your team'] },
          ]}
        />
      </div>
    </section>

    <hr class="divider" />

    <section class="section" id="deep-dives">
      <div class="container">
        <div class="ent-section-header animate-on-scroll">
          <span class="section-label">Details</span>
          <h2 class="section-title">Go deeper</h2>
        </div>
        <div class="deep-grid">
          {enterprisePages.map((p) => (
            <a href={`/enterprise/${p.slug}/`} class="deep-card animate-on-scroll">
              <h3>{p.label}</h3>
              <p>{p.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <hr class="divider" />
    <CtaFooter variant="support" />
  </main>
</Base>

<style>
  .ent-hero {
    padding: 140px 0 56px;
  }

  @media (min-width: 768px) {
    .ent-hero {
      padding: 170px 0 72px;
    }
  }

  .ent-hero-content {
    max-width: 820px;
  }

  .ent-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    margin: 12px 0 20px;
  }

  .ent-hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin-bottom: 28px;
  }

  .ent-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 36px;
  }

  .ent-facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
  }

  @media (min-width: 640px) {
    .ent-facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ent-facts div {
    padding: 14px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
  }

  .ent-facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-dim);
  }

  .ent-facts dd {
    margin: 4px 0 0;
    font-weight: 600;
    color: var(--color-fg-primary);
  }

  .ent-section-header {
    max-width: 720px;
    margin-bottom: 28px;
  }

  .ent-section-header .section-subtitle {
    margin: 0;
  }

  .ent-section-header a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .answer-grid,
  .deep-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  .answer-card,
  .deep-card {
    display: block;
    padding: 20px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .answer-card:hover,
  .deep-card:hover {
    border-color: var(--glass-border-hover);
  }

  .answer-card h3,
  .deep-card h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-fg-primary);
    margin-bottom: 8px;
  }

  .answer-card p,
  .deep-card p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }

  .shot-grid {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .shot-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .not-yet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }

  .not-yet-list li {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1px dashed var(--glass-border);
    border-radius: var(--radius-md);
  }

  .not-yet-list strong {
    color: var(--color-fg-primary);
    font-weight: 600;
  }

  .not-yet-list span {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
</style>
