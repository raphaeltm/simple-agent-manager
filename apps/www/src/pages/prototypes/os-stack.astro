---
/**
 * PROTOTYPE OS-1 "Exploded stack" (2026-11-11): homepage as "the open-source operating system
 * for scalable software factories", with animated real UI. Not linked, noindex, not for merge.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import FactoryCta from '../../components/prototypes/factory/FactoryCta.astro';
import OsCode from '../../components/prototypes/os/OsCode.astro';
import OsPillars from '../../components/prototypes/os/OsPillars.astro';
import StackHero from '../../components/prototypes/os/StackHero.astro';
import SystemMonitor from '../../components/prototypes/os/SystemMonitor.astro';
import { proofStrip } from '../../data/proof-strip';
import '../../components/prototypes/factory/factory.css';

const img = (name: string) => `/images/prototypes/os/${name}.webp`;
const githubUrl = 'https://github.com/raphaeltm/simple-agent-manager';

const monitor = [
  { os: 'Process', sam: 'Agent sessions', what: 'One agent on one task, in its own workspace, streaming every step.', src: img('sam-hero-live-session'), alt: 'A live agent session streaming its plan and tool calls', from: '60% 0%', to: '90% 40%' },
  { os: 'Scheduler', sam: 'Compute pools', what: 'Puts each job on a machine that fits, reuses warm ones, and says why.', src: img('sam-compute-placement-decision'), alt: 'Placement decision for a session', from: '100% 0%', to: '100% 60%' },
  { os: 'Scheduled jobs', sam: 'Triggers', what: 'Starts work on a schedule, a GitHub event, a webhook, or when something happens, like CI finishing.', src: img('sam-events-watches'), alt: 'An event watch that starts an investigator chat when CI finishes', from: '30% 0%', to: '70% 50%' },
  { os: 'Processes talking', sam: 'Subtasks and messages', what: 'Agents start, message, interrupt and stop other agents.', src: img('sam-agents-orchestration'), alt: 'A lead agent and the subtasks it started', from: '50% 0%', to: '50% 60%' },
  { os: 'Shared files', sam: 'Library and memory', what: 'Files and project facts every agent can read and add to.', src: img('sam-context-memory'), alt: 'Project memory entries with confidence and source', from: '40% 0%', to: '80% 50%' },
  { os: 'Users', sam: 'Members and profiles', what: 'Who is on the project, and which agent and account each kind of job uses.', src: img('sam-collab-members-access'), alt: 'Project members and pending access requests', from: '50% 0%', to: '50% 70%' },
  { os: 'System log', sam: 'Activity and usage', what: 'Every run and its chat, machine hours per person, and tokens for work sent through SAM’s AI proxy.', src: img('sam-admin-costs'), alt: 'Installation cost summary', from: '40% 0%', to: '60% 70%' },
];
---

<Base
  title="SAM: the open-source operating system for scalable software factories"
  description="SAM puts coding agents on your machines, gives them your project's rules and memory, lets them coordinate, and records what ran. Open source, on your own cloud."
  noindex
>
  <Header />
  <main class="fx-page">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1 class="hero-title">The open-source operating system for scalable <span class="gradient-text">software factories</span></h1>
          <p class="fx-lede">
            In a software factory, work arrives from issues, schedules and webhooks, and agents turn
            it into pull requests for a whole team. SAM runs that underneath: it puts each agent on
            a machine, gives it the project's rules and memory, lets agents coordinate, and records
            what ran. On your own cloud.
          </p>
          <div class="fx-actions">
            <a href="/self-host/" class="sam-btn sam-btn--primary">Deploy SAM</a>
            <a href={githubUrl} class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">Read the source</a>
          </div>
          <p class="fx-proof">{proofStrip.map((p) => <span>{p}</span>)}</p>
        </div>
        <div class="hero-figure">
          <StackHero
            back={{ label: 'Machines', src: img('sam-nodes-multi-provider'), alt: '', focus: '0% 0%' }}
            middle={{ label: 'Agents', src: img('sam-agents-orchestration'), alt: '', focus: '50% 0%' }}
            front={{
              label: 'Interface',
              shots: [
                { src: img('sam-hero-live-session'), alt: '', focus: '0% 0%' },
                { src: img('sam-comments-chat-thread'), alt: '', focus: '0% 0%' },
                { src: img('sam-events-watches'), alt: '', focus: '0% 0%' },
              ],
            }}
            toasts={[
              { tone: 'wait', title: 'Claude Code needs your input', meta: 'Refund webhook · Priya' },
              { tone: 'info', title: 'Placed on a warm machine', meta: 'gcp europe-west1 · reused' },
              { tone: 'done', title: 'Task complete: PR #1931 ready', meta: 'Codex · backend-worker' },
            ]}
          />
          <p class="fx-note hero-note">Real SAM screens · sample project</p>
        </div>
      </div>
    </section>

    <section class="fx-section">
      <div class="container">
        <div class="fx-head">
          <p class="fx-kicker">If you know an operating system, you know SAM</p>
          <h2 class="fx-h2">Agents are the programs. SAM runs them.</h2>
          <p class="fx-lede">Built for teams running agents across many repos and many people.</p>
        </div>
        <SystemMonitor rows={monitor} />
      </div>
    </section>

    <section class="fx-section">
      <div class="container split">
        <div class="fx-head">
          <p class="fx-kicker">Programmable from the inside</p>
          <h2 class="fx-h2">Agents can run the factory too</h2>
          <p class="fx-lede">
            Agents use the same tools you do to start work, message running agents and set
            schedules, through SAM's MCP server. A lead agent splits a job across workers, steers
            them while they run, and sets up the schedule that keeps the work going.
          </p>
        </div>
        <OsCode />
      </div>
    </section>

    <section class="fx-section">
      <div class="container">
        <div class="fx-head fx-head--center">
          <p class="fx-kicker">Every layer is yours</p>
          <h2 class="fx-h2">Your machines, your agents, your control plane</h2>
        </div>
        <OsPillars />
      </div>
    </section>

    <FactoryCta
      title="Deploy SAM on your own cloud"
      body="Deploy it to your Cloudflare account, connect a cloud and an agent, and start your first job. Add repos, people and triggers from there."
    />
  </main>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: calc(var(--header-height) + 64px) 0 72px;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 74% 48%, rgb(34 197 94 / 0.18), transparent 70%),
      radial-gradient(50% 60% at 8% 8%, rgb(6 78 59 / 0.38), transparent 72%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 10fr) minmax(0, 13fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.125rem, 4.2vw, 3.375rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-figure {
    display: grid;
    gap: 10px;
  }

  .hero-note {
    justify-self: end;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: center;
  }

  .split .fx-head {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-note {
      justify-self: start;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: calc(var(--header-height) + 40px);
    }
  }
</style>
