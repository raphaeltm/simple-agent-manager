---
/**
 * PROTOTYPE A (2026-11-10): homepage reframed around "building blocks for a software factory".
 * Not linked from navigation, noindex. Do not ship without explicit approval.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import FactoryCta from '../../components/prototypes/factory/FactoryCta.astro';
import FactoryLine from '../../components/prototypes/factory/FactoryLine.astro';
import { proofStrip } from '../../data/proof-strip';
import '../../components/prototypes/factory/factory.css';

const deployUrl = '/self-host/';
const githubUrl = 'https://github.com/raphaeltm/simple-agent-manager';

const stations = [
  {
    step: '01',
    title: 'Work arrives on its own',
    body: 'Start agents from GitHub issues, comments, pull requests and pushes, on a schedule, or from any system that can send a webhook. Or write an idea with a plan and hand it over when it is ready.',
    img: 'sam-triggers-sources',
    alt: 'Automation page listing schedules, GitHub triggers and webhooks',
  },
  {
    step: '02',
    title: 'Every agent starts with the same playbook',
    body: 'Profiles pin the agent, model and account for a kind of job. Skills hold the steps for repeatable work. Project rules and memory reach every session, so the hundredth run follows the same conventions as the first.',
    img: 'sam-context-policies',
    alt: 'Project policies that every agent session receives',
  },
  {
    step: '03',
    title: 'Each job gets its own machine',
    body: 'Every task runs in its own workspace on a server SAM picks from your compute pool. Pools span seven cloud providers, reuse machines that still have room, and record why each job landed where it did.',
    img: 'sam-compute-placement-decision',
    alt: 'Placement decision showing which machine a task was sent to and why',
  },
  {
    step: '04',
    title: 'Agents run other agents',
    body: 'A lead agent can split a big job, start agents for each part, send them messages, stop them, and read what they report back. You talk to one agent. It keeps the rest on track.',
    img: 'sam-agents-orchestration',
    alt: 'A lead agent with its running subtasks',
  },
  {
    step: '05',
    title: 'People step in where judgment matters',
    body: 'Agents ask when they are stuck, and you answer from your phone. Comment on a sentence an agent wrote and send the thread back to it. Nothing merges because a timer ran out.',
    img: 'sam-comments-chat-thread',
    alt: 'A comment thread on an agent reply, ready to send back to the agent',
  },
  {
    step: '06',
    title: 'See the whole floor',
    body: 'Every member’s sessions in one list, which keys pay for shared work, and token and machine usage per person. Admins get costs for the whole installation.',
    img: 'sam-admin-costs',
    alt: 'Admin cost summary with token and machine spend per person'
  },
];

const blocks = [
  { name: 'Projects', text: 'A repo, its people, its rules, its history.' },
  { name: 'Profiles', text: 'Agent, model, account and machine size for a kind of job.' },
  { name: 'Skills', text: 'Repeatable instructions for work you do often.' },
  { name: 'Rules and memory', text: 'Conventions and facts every session receives.' },
  { name: 'Triggers', text: 'Schedules, GitHub events and webhooks that start work.' },
  { name: 'Workspaces', text: 'An isolated environment per task, with your devcontainer.' },
  { name: 'Compute pools', text: 'Which clouds and machine types work may use.' },
  { name: 'Subtasks and messages', text: 'Agents starting and talking to other agents.' },
  { name: 'Library', text: 'Shared files, reports and reference docs.' },
  { name: 'Usage', text: 'Tokens and machine hours, per person and per model.' },
];
---

<Base
  title="SAM: building blocks for your software factory"
  description="SAM is an open-source platform for teams that want many coding agents turning a steady flow of work into shipped code, on their own cloud."
  noindex
>
  <Header />
  <main class="fx-page">
    <section class="a-hero">
      <div class="a-hero-glow" aria-hidden="true"></div>
      <div class="container a-hero-inner">
        <div class="a-hero-copy">
          <h1 class="a-title">
            The building blocks for your <span class="gradient-text">software factory</span>
          </h1>
          <p class="fx-lede">
            SAM is open source. It gives your team the parts to turn a steady stream of work into
            shipped code: triggers that start agents, a workspace for every task, agents that manage
            other agents, and one place to review it all. You run it on your own cloud.
          </p>
          <div class="fx-actions">
            <a href={deployUrl} class="sam-btn sam-btn--primary">Deploy SAM</a>
            <a href={githubUrl} class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">Read the source</a>
          </div>
          <p class="fx-proof">{proofStrip.map((p) => <span>{p}</span>)}</p>
        </div>
        <div class="a-hero-figure">
          <FactoryLine />
          <p class="fx-note">Sample project · illustrative</p>
        </div>
      </div>
    </section>

    <section class="fx-section">
      <div class="container">
        <div class="fx-head">
          <p class="fx-kicker">How work moves through SAM</p>
          <h2 class="fx-h2">Six stations, each one a feature you can use today</h2>
          <p class="fx-lede">
            A software factory is less about one clever agent and more about the line around it:
            where work comes from, who picks it up, where it runs, and who checks it.
          </p>
        </div>

        <ol class="a-stations">
          {stations.map((s, i) => (
            <li class={`a-station ${i % 2 ? 'a-station--flip' : ''}`}>
              <div class="a-station-copy">
                <span class="a-step">{s.step}</span>
                <h3 class="a-station-title">{s.title}</h3>
                <p class="a-station-body">{s.body}</p>
              </div>
              <div class="fx-shot">
                <img src={`/images/features/${s.img}.webp`} alt={s.alt} loading="lazy" width="1920" height="1200" />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="fx-section a-blocks-section">
      <div class="container">
        <div class="fx-head fx-head--center">
          <p class="fx-kicker">The blocks</p>
          <h2 class="fx-h2">Put them together the way your team works</h2>
          <p class="fx-lede">
            Every block is something people use in the app and agents use through SAM's MCP tools.
            An agent can start another agent, add a schedule, write a skill or file an idea, so the
            factory can improve while it runs.
          </p>
        </div>
        <ul class="a-blocks">
          {blocks.map((b) => (
            <li class="a-block sam-glass sam-glass-rim">
              <span class="a-block-name">{b.name}</span>
              <span class="a-block-text">{b.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="fx-section">
      <div class="container a-split">
        <div class="fx-head">
          <p class="fx-kicker">Built for many people</p>
          <h2 class="fx-h2">One installation for the whole team</h2>
          <ul class="a-list">
            <li>Invite people to a project. An owner approves each request.</li>
            <li>Share profiles, skills, environment variables and files across members.</li>
            <li>Switch between your sessions and everyone's.</li>
            <li>See when shared automation is running on someone's personal key, and fix it.</li>
            <li>Preview what a person owns before they leave the team.</li>
          </ul>
        </div>
        <div class="fx-shot">
          <img src="/images/features/sam-collab-credential-attribution.webp" alt="Credential attribution panel showing which member's key pays for shared work" loading="lazy" width="1920" height="1200" />
        </div>
      </div>
    </section>

    <section class="fx-section fx-section--tight">
      <div class="container">
        <div class="a-own sam-glass sam-glass-rim">
          <div>
            <p class="fx-kicker">Yours to run</p>
            <h2 class="fx-h2">No vendor between you and your factory</h2>
          </div>
          <dl class="a-own-grid">
            <div><dt>The code</dt><dd>AGPL-3.0. Read it, change it, run it.</dd></div>
            <div><dt>The control plane</dt><dd>Deploys to your own Cloudflare account.</dd></div>
            <div><dt>The machines</dt><dd>Your accounts on seven cloud providers.</dd></div>
            <div><dt>The agents</dt><dd>Your subscriptions or API keys, per profile.</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <FactoryCta
      title="Start with one line. Add more as you grow."
      body="Deploy SAM to your Cloudflare account, connect a cloud and an agent, and point your first trigger at a repo."
    />
  </main>
</Base>

<style>
  .a-hero {
    position: relative;
    isolation: isolate;
    padding: calc(var(--header-height) + 64px) 0 72px;
  }

  .a-hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 78% 40%, rgb(34 197 94 / 0.16), transparent 70%),
      radial-gradient(50% 60% at 10% 10%, rgb(6 78 59 / 0.35), transparent 72%);
  }

  .a-hero-inner {
    display: grid;
    gap: 48px;
  }

  .a-hero-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 1000px;
  }

  .a-hero-copy .fx-lede {
    max-width: 64ch;
  }

  .a-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .a-hero-figure {
    display: grid;
    gap: 12px;
  }

  .a-stations {
    list-style: none;
    display: grid;
    gap: 88px;
  }

  .a-station {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: center;
  }

  .a-station--flip .a-station-copy {
    order: 2;
  }

  .a-station-copy {
    display: grid;
    gap: 12px;
  }

  .a-step {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-strong);
  }

  .a-station-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.625rem;
    line-height: 1.15;
  }

  .a-station-body {
    color: var(--color-fg-muted);
    line-height: 1.65;
  }

  .a-blocks {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .a-block {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px 16px;
    border-radius: var(--radius-lg);
  }

  .a-block-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .a-block-text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }

  .a-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: center;
  }

  .a-split .fx-head {
    margin-bottom: 0;
  }

  .a-list {
    display: grid;
    gap: 10px;
    padding-left: 18px;
    color: var(--color-fg-muted);
    line-height: 1.55;
  }

  .a-list li::marker {
    color: var(--color-accent-strong);
  }

  .a-own {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    padding: 40px;
    border-radius: var(--radius-xl);
  }

  .a-own-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 28px;
  }

  .a-own-grid dt {
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .a-own-grid dd {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 1100px) {
    .a-blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .a-hero {
      padding-top: calc(var(--header-height) + 48px);
    }

    .a-station,
    .a-split,
    .a-own {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .a-station--flip .a-station-copy {
      order: 0;
    }

    .a-stations {
      gap: 56px;
    }

    .a-blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .a-own {
      padding: 24px;
    }

    .a-own-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
