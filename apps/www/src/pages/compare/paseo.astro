---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CtaFooter from '../../components/CtaFooter.astro';

const updatedDate = 'September 1, 2026';

const comparisonRows = [
  {
    label: 'Best fit',
    paseo: 'A polished local-first cockpit for watching and steering agents that already run on your devices.',
    sam: 'A control plane for provisioning, isolating, recovering, and governing agent work across projects and teams.',
  },
  {
    label: 'Compute model',
    paseo: 'Connects to local computers and online daemons you already run.',
    sam: 'Creates and manages cloud workspaces, nodes, containers, scheduling, cleanup, and recovery.',
  },
  {
    label: 'Cross-device UX',
    paseo: 'Excellent: desktop, mobile, and web clients are a core part of the product.',
    sam: 'Web-first today, optimized around durable workspace and project operations.',
  },
  {
    label: 'Team governance',
    paseo: 'Organization roles exist in Paseo Hub, with the product still early in its hosted collaboration arc.',
    sam: 'Project membership, policies, profiles, credentials, library files, audit trails, and shared operational context.',
  },
  {
    label: 'Automation',
    paseo: 'Paseo Hub adds remote access and automation over online daemons.',
    sam: 'Built around dispatched tasks, durable sessions, triggers, wake/resume, and managed execution lifecycle.',
  },
  {
    label: 'Isolation',
    paseo: 'Depends on the machine or daemon environment the user provides.',
    sam: 'Every workspace is isolated in managed runtime infrastructure with explicit credential and workspace boundaries.',
  },
  {
    label: 'Agent support',
    paseo: 'Strong multi-agent client focus.',
    sam: 'Agent-agnostic infrastructure for Claude Code, Codex, Gemini CLI, Amp, Mistral Vibe, OpenCode, and more.',
  },
];

const samStrengths = [
  'Cloud workspace provisioning instead of assuming a machine is already online',
  'Durable sleep, wake, resume, and recovery for long-running agent work',
  'Project policies, shared library files, agent profiles, and organization-level operating context',
  'Infrastructure visibility across nodes, workspaces, costs, sessions, tasks, and activity',
  'Open-source, self-hostable control plane for teams that need auditability and ownership',
];

const paseoStrengths = [
  'A fast, focused client for staying close to active agents',
  'Native cross-device ergonomics across desktop, mobile, and web',
  'A clean model for connecting to local and remote daemons',
  'A product direction that makes agent supervision feel personal and immediate',
];
---

<Base
  title="SAM vs Paseo — Agent Infrastructure vs Local Agent Cockpit"
  description="Compare SAM and Paseo for AI coding agents. Paseo is a strong local-first agent cockpit; SAM is built for cloud provisioning, team governance, recovery, isolation, and open-source control."
>
  <Header />
  <main>
    <section class="compare-hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-content">
        <span class="section-label animate-on-scroll">SAM vs Paseo</span>
        <h1 class="hero-title animate-on-scroll">
          Paseo is a great agent cockpit.<br />
          <span class="gradient-text">SAM is agent infrastructure.</span>
        </h1>
        <p class="hero-subtitle animate-on-scroll">
          The Paseo team is building something genuinely cool: a local-first, cross-device way to supervise and steer coding agents.
          SAM comes at the problem from the infrastructure side: provisioning workspaces, enforcing boundaries,
          recovering sessions, and giving teams a control plane they can own.
        </p>
        <div class="hero-actions animate-on-scroll">
          <a href="/self-host/" class="btn-page btn-page-primary">Self-host SAM</a>
          <a href="https://github.com/raphaeltm/simple-agent-manager" class="btn-page btn-page-secondary" target="_blank" rel="noopener noreferrer">View source</a>
        </div>
        <p class="source-note animate-on-scroll">
          Based on public Paseo and Paseo Hub repository evidence reviewed on {updatedDate}.
        </p>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container split-section">
        <div class="narrative animate-on-scroll">
          <span class="section-label">Short Version</span>
          <h2 class="section-title">Different bets, different winners</h2>
          <p>
            Paseo is strongest when you already have agents running somewhere and want a beautiful, low-friction way
            to monitor and steer them from your laptop, phone, or browser. That is a real need, and Paseo treats it
            with a lot of care.
          </p>
          <p>
            SAM is strongest when the hard part is not the chat UI. It is the operational layer around agents:
            creating clean workspaces, choosing runtime infrastructure, keeping sessions alive, resuming them after
            failure, controlling credentials, tracking costs, and letting multiple people work inside one project
            without losing the thread.
          </p>
        </div>
        <div class="verdict-panel animate-on-scroll" aria-label="SAM and Paseo positioning summary">
          <div class="verdict-row">
            <span>Paseo</span>
            <strong>Agent cockpit</strong>
          </div>
          <div class="verdict-row">
            <span>SAM</span>
            <strong>Agent control plane</strong>
          </div>
          <div class="verdict-row">
            <span>Choose Paseo for</span>
            <strong>Cross-device local supervision</strong>
          </div>
          <div class="verdict-row">
            <span>Choose SAM for</span>
            <strong>Provisioning, isolation, recovery, governance</strong>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container">
        <div class="comparison-header animate-on-scroll">
          <span class="section-label">Comparison</span>
          <h2 class="section-title">SAM vs Paseo for AI coding agents</h2>
          <p class="section-subtitle">
            Paseo makes the active agent experience feel close at hand. SAM makes the agent operating model durable,
            auditable, and manageable for real projects.
          </p>
        </div>

        <div class="table-wrapper animate-on-scroll">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Paseo</th>
                <th class="sam-col">SAM</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <td class="row-label" data-label="Category">{row.label}</td>
                  <td data-label="Paseo">{row.paseo}</td>
                  <td class="sam-col" data-label="SAM">{row.sam}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container strength-grid">
        <div class="strength-block animate-on-scroll">
          <span class="section-label">What Paseo Nails</span>
          <h2>They understand the operator experience</h2>
          <p>
            Paseo is impressive because it starts from the human side of agent work. Agents can run for a long time,
            ask for attention, produce noise, and drift away from the device you are currently using. A cross-device
            cockpit is a smart answer to that problem.
          </p>
          <ul>
            {paseoStrengths.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="strength-block strength-sam animate-on-scroll">
          <span class="section-label">Where SAM Goes Deeper</span>
          <h2>We handle the infrastructure beneath the cockpit</h2>
          <p>
            SAM is built for teams that need the work to keep existing after the browser closes, the node dies,
            the session sleeps, or the project gets handed from one agent to another. That requires more than a
            remote UI. It requires a control plane.
          </p>
          <ul>
            {samStrengths.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container">
        <div class="comparison-header animate-on-scroll">
          <span class="section-label">When SAM Wins</span>
          <h2 class="section-title">The jobs SAM can definitely do better</h2>
        </div>
        <div class="wins-grid">
          <article class="win-card animate-on-scroll">
            <h3>Starting from zero</h3>
            <p>
              Paseo is best when a daemon or local machine already exists. SAM can create the workspace, attach the
              repository, select the runtime, inject platform context, and give the agent a clean place to work.
            </p>
          </article>
          <article class="win-card animate-on-scroll">
            <h3>Recovering long-running work</h3>
            <p>
              Real agent sessions are messy. SAM treats task state, chat history, snapshots, wake delivery, and
              recovery as platform responsibilities instead of leaving the operator to reconstruct what happened.
            </p>
          </article>
          <article class="win-card animate-on-scroll">
            <h3>Running as a team</h3>
            <p>
              SAM has project-level primitives for members, profiles, library files, credentials, policies, costs,
              task dispatch, and audit history. Those primitives matter once agent work moves beyond one person
              watching one machine.
            </p>
          </article>
          <article class="win-card animate-on-scroll">
            <h3>Owning the control plane</h3>
            <p>
              SAM is open source and self-hostable. Teams can inspect how workspaces are created, how credentials
              are scoped, how nodes are cleaned up, and how the platform behaves under failure.
            </p>
          </article>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container final-cta animate-on-scroll">
        <span class="section-label">Bottom Line</span>
        <h2 class="section-title">Use Paseo to stay close to agents. Use SAM to run them as infrastructure.</h2>
        <p>
          We like what Paseo is building. The product has taste, focus, and a clear feel for how developers want to
          supervise agent work. SAM is aiming at a different layer: the cloud runtime, operational controls, recovery
          model, governance surface, and open-source infrastructure needed when agents become part of how a team ships.
        </p>
        <div class="hero-actions">
          <a href="/docs/overview/" class="btn-page btn-page-primary">Read the SAM docs</a>
          <a href="/enterprise/" class="btn-page btn-page-secondary">See enterprise controls</a>
        </div>
        <p class="source-links">
          Sources:
          <a href="https://github.com/getpaseo/paseo" target="_blank" rel="noopener noreferrer">Paseo</a>,
          <a href="https://github.com/getpaseo/hub" target="_blank" rel="noopener noreferrer">Paseo Hub</a>,
          and <a href="https://github.com/raphaeltm/simple-agent-manager" target="_blank" rel="noopener noreferrer">SAM</a>.
        </p>
      </div>
    </section>

    <hr class="divider" />
    <CtaFooter />
  </main>
</Base>

<style>
  .compare-hero {
    position: relative;
    padding: 140px 0 72px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .compare-hero {
      padding: 168px 0 88px;
    }
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    width: 760px;
    height: 460px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(22, 163, 74, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  :global(html[data-theme='light']) .hero-glow {
    background: radial-gradient(ellipse, rgba(21, 128, 61, 0.08) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.12;
    color: var(--color-fg-primary);
    margin-bottom: 24px;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-success) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    max-width: 720px;
    margin: 0 auto 28px;
    color: var(--color-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .btn-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 22px;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.2s;
  }

  .btn-page-primary {
    background: var(--color-accent);
    color: white;
    box-shadow: 0 0 18px var(--shadow-accent-soft);
  }

  .btn-page-primary:hover {
    background: var(--color-accent-hover);
    color: white;
    transform: translateY(-1px);
  }

  .btn-page-secondary {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--color-fg-primary);
  }

  .btn-page-secondary:hover {
    border-color: var(--glass-border-hover);
    color: var(--color-fg-primary);
  }

  .source-note {
    margin-top: 18px;
    color: var(--color-fg-dim);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .split-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 860px) {
    .split-section {
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    }
  }

  .narrative {
    max-width: 720px;
  }

  .narrative .section-title {
    margin-bottom: 20px;
  }

  .narrative p,
  .final-cta p {
    color: var(--color-fg-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .verdict-panel,
  .strength-block,
  .win-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .verdict-panel {
    padding: 8px;
  }

  .verdict-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 16px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .verdict-row:last-child {
    border-bottom: 0;
  }

  .verdict-row span {
    color: var(--color-fg-dim);
    font-size: 0.8125rem;
  }

  .verdict-row strong {
    color: var(--color-fg-primary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .comparison-header {
    max-width: 760px;
    margin: 0 auto 44px;
    text-align: center;
  }

  .comparison-header .section-subtitle {
    margin: 0 auto;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
  }

  .comparison-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 16px 18px;
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: top;
    line-height: 1.5;
  }

  .comparison-table tr:last-child td {
    border-bottom: 0;
  }

  .comparison-table th {
    font-family: var(--font-display);
    color: var(--color-fg-primary);
    font-weight: 600;
  }

  .comparison-table td {
    color: var(--color-fg-muted);
  }

  .comparison-table .row-label {
    color: var(--color-fg-primary);
    font-weight: 600;
    white-space: nowrap;
  }

  .comparison-table .sam-col {
    color: var(--color-fg-primary);
  }

  .strength-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 860px) {
    .strength-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .strength-block {
    padding: 30px;
  }

  .strength-sam {
    border-color: rgba(22, 163, 74, 0.35);
  }

  .strength-block h2 {
    font-family: var(--font-display);
    color: var(--color-fg-primary);
    font-size: 1.5rem;
    line-height: 1.25;
    margin: 8px 0 14px;
  }

  .strength-block p {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  .strength-block ul {
    display: grid;
    gap: 10px;
    padding-left: 20px;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .wins-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .wins-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .win-card {
    padding: 28px;
  }

  .win-card h3 {
    font-family: var(--font-display);
    color: var(--color-fg-primary);
    font-size: 1.125rem;
    margin-bottom: 10px;
  }

  .win-card p {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .final-cta {
    max-width: 780px;
    text-align: center;
  }

  .final-cta .section-title {
    margin-bottom: 20px;
  }

  .final-cta p {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 28px;
  }

  .source-links {
    color: var(--color-fg-dim);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin-top: 20px;
    margin-bottom: 0;
  }

  .source-links a {
    color: var(--color-accent);
  }

  .source-links a:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 520px) {
    .verdict-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .btn-page {
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .table-wrapper {
      overflow-x: visible;
      border: 0;
      border-radius: 0;
    }

    .comparison-table,
    .comparison-table tbody,
    .comparison-table tr,
    .comparison-table td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .comparison-table thead {
      display: none;
    }

    .comparison-table {
      border-collapse: separate;
      border-spacing: 0 12px;
      font-size: 0.875rem;
    }

    .comparison-table tr {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 4px 0;
    }

    .comparison-table td {
      border-bottom: 1px solid var(--color-border-subtle);
      padding: 12px 16px;
    }

    .comparison-table td:last-child {
      border-bottom: 0;
    }

    .comparison-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      color: var(--color-fg-dim);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .comparison-table .row-label {
      white-space: normal;
    }
  }
</style>
