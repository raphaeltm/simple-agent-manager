---
const steps = [
  {
    number: '01',
    title: 'Choose where agents run',
    description: 'Start with Instant workspaces for quick jobs, which need no cloud account, or connect Hetzner, Scaleway, GCP, or four other providers for full environments with Docker.',
  },
  {
    number: '02',
    title: 'Add your repo and your team',
    description: 'Link a GitHub repository and invite teammates. Chats, tasks, and agent setups live in the project, shared with everyone you approve.',
  },
  {
    number: '03',
    title: 'Ask, or let a schedule ask',
    description: 'Type what you need, or have a schedule, a GitHub event, or a webhook start it. SAM starts a fresh workspace and runs your agent there. For bigger jobs, an agent can start helper agents and check on them.',
  },
  {
    number: '04',
    title: 'Follow along from anywhere',
    description: 'Watch every step as it happens, comment to steer the agent, and get a notification on your phone when it needs you or finishes.',
  },
];
---

<section id="how-it-works" class="section">
  <div class="container">
    <div class="hiw-header animate-on-scroll">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">Set it up once, then just ask</h2>
      <p class="section-subtitle">
        Four steps from a GitHub repo to agents working through your backlog.
      </p>
    </div>

    <div class="steps">
      {steps.map((step, i) => (
        <div class="step animate-on-scroll" style={`transition-delay: ${i * 120}ms`}>
          <div class="step-number-col">
            <span class="step-number sam-glass sam-glass-rim">{step.number}</span>
            {i < steps.length - 1 && <div class="step-connector" />}
          </div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hiw-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .hiw-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .steps {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .step {
    display: flex;
    gap: 24px;
  }

  .step-number-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  /* Each step is a lit node, like the tiles on the hero floor. */
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global(html[data-theme='light']) .step-number {
    color: var(--color-accent);
  }

  .step-connector {
    width: 1px;
    flex: 1;
    min-height: 40px;
    background: linear-gradient(to bottom, rgb(34 197 94 / 0.45), transparent);
  }

  .step-content {
    padding-bottom: 48px;
  }

  .step:last-child .step-content {
    padding-bottom: 0;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-fg-primary);
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
    margin-bottom: 8px;
  }

</style>
