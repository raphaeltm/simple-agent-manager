---
import FeatureScene from './scenes/FeatureScene.astro';
import { featureSections } from '../data/features';
import { scenes } from '../data/scenes';

// The homepage showcase is a curated tour, not the full feature catalog — see
// /features/ for every section. The tour is the sections that have an animated
// real-UI preview (src/data/scenes, in story order); each renders only its
// first detail row beside that preview.
const curatedSections = scenes.map((scene) => {
  const section = featureSections.find((candidate) => candidate.slug === scene.slug);
  if (!section) throw new Error(`Feature scene "${scene.slug}" has no section in src/data/features`);
  return section;
});
---

<div class="showcase-index animate-on-scroll">
  {curatedSections.map((section) => (
    <a href={`#feature-${section.slug}`} class="showcase-pill sam-glass sam-glass--chrome sam-glass-rim">{section.label}</a>
  ))}
</div>

{curatedSections.map((section, sectionIdx) => {
  const detail = section.details[0];
  const flip = sectionIdx % 2 === 1;
  return (
    <section class="showcase-section" id={`feature-${section.slug}`}>
      <div class="container">
        <div class="showcase-header animate-on-scroll">
          <span class="section-label">{section.label}</span>
          <h2 class="section-title" set:html={section.title.replace('\n', '<br />')} />
          <p class="section-subtitle">{section.subtitle}</p>
        </div>

        <div class="editorial-rows">
          <div class={`editorial-row animate-on-scroll${flip ? ' is-flipped' : ''}`}>
            <div class="editorial-copy">
              <h3 class="editorial-headline">{detail.headline}</h3>
              <p class="editorial-body">{detail.body}</p>
              <a href={`/features/${section.slug}/`} class="editorial-link">
                Explore {section.label}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>

            <div class="editorial-preview">
              <FeatureScene
                slug={section.slug}
                side={flip ? 'left' : 'right'}
                href={`/features/${section.slug}/`}
                label={detail.headline}
                caption={detail.screenshot.caption}
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  );
})}

<div class="showcase-more animate-on-scroll">
  <a href="/features/" class="showcase-more-link">
    See every feature
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
</div>

<style>
  /* The row follows the divider above #features, so it needs space on both sides. */
  .showcase-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 48px 20px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .showcase-pill {
    padding: 6px 14px;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .showcase-pill:hover {
    color: var(--color-fg-primary);
    transform: translateY(-1px);
  }

  .showcase-more {
    text-align: center;
    padding: 8px 0 40px;
  }

  .showcase-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .showcase-more-link:hover {
    color: var(--color-accent-hover);
    gap: 12px;
  }

  .showcase-section {
    padding: 80px 0;
  }

  @media (min-width: 768px) {
    .showcase-section {
      padding: 120px 0;
    }
  }

  .showcase-section + .showcase-section {
    border-top: 1px solid var(--glass-border);
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 56px;
  }

  @media (min-width: 768px) {
    .showcase-header {
      margin-bottom: 88px;
    }
  }

  .showcase-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- Editorial rows ---- */

  .editorial-rows {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  @media (min-width: 768px) {
    .editorial-rows {
      gap: 120px;
    }
  }

  .editorial-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .editorial-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
    }

    .editorial-row.is-flipped {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    /* Keep the copy column on the left visually, image on the right —
       when flipped, swap source order so the image sits on the left. */
    .editorial-row.is-flipped .editorial-copy {
      order: 2;
    }

    .editorial-row.is-flipped .editorial-preview {
      order: 1;
    }
  }

  /* ---- Copy ---- */

  .editorial-copy {
    max-width: 520px;
  }

  .editorial-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    margin: 0 0 16px;
  }

  .editorial-body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin: 0 0 24px;
  }

  .editorial-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .editorial-link svg {
    transition: transform 0.2s ease;
  }

  .editorial-link:hover {
    color: var(--color-accent-hover);
    gap: 12px;
  }

  .editorial-link:hover svg {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-pill {
      transition: none;
    }

    .showcase-pill:hover {
      transform: none;
    }
  }
</style>
