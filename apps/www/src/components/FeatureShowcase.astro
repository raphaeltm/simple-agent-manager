---
import OptimizedFeatureImage from './OptimizedFeatureImage.astro';
import { featureSections } from '../data/features';

// The homepage showcase is a curated tour, not the full feature catalog — see
// /features/ for every section. Each entry below renders only its first
// detail row, in the order that tells the clearest product story.
const CURATED_SLUGS = [
  'chat',
  'multiplayer',
  'comments',
  'compute-pools',
  'events',
  'durable-sessions',
  'agent-context',
];

const curatedSections = CURATED_SLUGS.map((slug) =>
  featureSections.find((section) => section.slug === slug)
).filter((section): section is (typeof featureSections)[number] => Boolean(section));
---

<div class="showcase-index animate-on-scroll">
  {curatedSections.map((section) => (
    <a href={`#feature-${section.slug}`} class="showcase-pill sam-glass sam-glass--chrome sam-glass-rim">{section.label}</a>
  ))}
</div>

{curatedSections.map((section, sectionIdx) => {
  const detail = section.details[0];
  const flip = sectionIdx % 2 === 1;
  const eager = sectionIdx === 0;
  return (
    <section class="showcase-section" id={`feature-${section.slug}`}>
      <div class="container">
        <div class="showcase-header animate-on-scroll">
          <span class="section-label">{section.label}</span>
          <h2 class="section-title" set:html={section.title.replace('\n', '<br />')} />
          <p class="section-subtitle">{section.subtitle}</p>
        </div>

        <div class="editorial-rows">
          <div class={`editorial-row animate-on-scroll${flip ? ' is-flipped' : ''}`}>
            <div class="editorial-copy">
              <h3 class="editorial-headline">{detail.headline}</h3>
              <p class="editorial-body">{detail.body}</p>
              <a href={`/features/${section.slug}/`} class="editorial-link">
                Explore {section.label}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>

            <a href={`/features/${section.slug}/`} class="spotlight" aria-label={detail.headline}>
              <span class="spotlight-glow" aria-hidden="true"></span>
              <span class="spotlight-frame sam-glass sam-glass-rim">
                <span class="spotlight-shot">
                  <OptimizedFeatureImage
                    src={detail.screenshot.src}
                    alt={detail.screenshot.alt}
                    loading={eager ? 'eager' : 'lazy'}
                  />
                  <span class="spotlight-caption">{detail.screenshot.caption}</span>
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  );
})}

<div class="showcase-more animate-on-scroll">
  <a href="/features/" class="showcase-more-link">
    See every feature
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
</div>

<style>
  .showcase-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 0 20px 48px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .showcase-pill {
    padding: 6px 14px;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .showcase-pill:hover {
    color: var(--color-fg-primary);
    transform: translateY(-1px);
  }

  .showcase-more {
    text-align: center;
    padding: 8px 0 40px;
  }

  .showcase-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .showcase-more-link:hover {
    color: var(--color-accent-hover);
    gap: 12px;
  }

  .showcase-section {
    padding: 80px 0;
  }

  @media (min-width: 768px) {
    .showcase-section {
      padding: 120px 0;
    }
  }

  .showcase-section + .showcase-section {
    border-top: 1px solid var(--glass-border);
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 56px;
  }

  @media (min-width: 768px) {
    .showcase-header {
      margin-bottom: 88px;
    }
  }

  .showcase-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- Editorial rows ---- */

  .editorial-rows {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  @media (min-width: 768px) {
    .editorial-rows {
      gap: 120px;
    }
  }

  .editorial-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .editorial-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
    }

    .editorial-row.is-flipped {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    /* Keep the copy column on the left visually, image on the right —
       when flipped, swap source order so the image sits on the left. */
    .editorial-row.is-flipped .editorial-copy {
      order: 2;
    }

    .editorial-row.is-flipped .spotlight {
      order: 1;
    }
  }

  /* ---- Copy ---- */

  .editorial-copy {
    max-width: 520px;
  }

  .editorial-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    margin: 0 0 16px;
  }

  .editorial-body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin: 0 0 24px;
  }

  .editorial-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .editorial-link svg {
    transition: transform 0.2s ease;
  }

  .editorial-link:hover {
    color: var(--color-accent-hover);
    gap: 12px;
  }

  .editorial-link:hover svg {
    transform: translateX(2px);
  }

  /* ---- Spotlight: the real screenshot in a glass bezel, lit from below ---- */

  .spotlight {
    position: relative;
    display: block;
    isolation: isolate;
  }

  .spotlight-glow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -40px;
    z-index: -1;
    height: 120px;
    background: radial-gradient(closest-side, rgb(34 197 94 / 0.22), transparent 75%);
    filter: blur(10px);
    opacity: 0.8;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  :global(html[data-theme='light']) .spotlight-glow {
    opacity: 0.45;
  }

  .spotlight:hover .spotlight-glow {
    opacity: 1;
  }

  .spotlight-frame {
    display: block;
    padding: 8px;
    border-radius: 18px;
    transition: transform 0.3s ease;
  }

  .spotlight:hover .spotlight-frame {
    transform: translateY(-3px);
  }

  .spotlight-shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 11px;
  }

  .spotlight-shot :global(picture),
  .spotlight-shot :global(img) {
    display: block;
  }

  .spotlight-shot :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.5s ease;
  }

  .spotlight:hover .spotlight-shot :global(img) {
    transform: scale(1.02);
  }

  .spotlight-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px 20px 18px;
    font-size: 0.875rem;
    line-height: 1.4;
    /* Sits over a screenshot beneath a dark scrim — keep text light in both themes */
    color: #eef5f2;
    background: linear-gradient(to top, rgb(8 14 12 / 0.92) 0%, rgb(8 14 12 / 0.7) 45%, transparent 100%);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .spotlight:hover .spotlight-caption,
  .spotlight:focus-visible .spotlight-caption {
    opacity: 1;
    transform: translateY(0);
  }

  /* On touch / small screens the caption is always visible since there's no hover */
  @media (max-width: 899px) {
    .spotlight-caption {
      opacity: 1;
      transform: none;
      padding: 40px 16px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-pill,
    .spotlight-frame,
    .spotlight-shot :global(img) {
      transition: none;
    }

    .showcase-pill:hover,
    .spotlight:hover .spotlight-frame,
    .spotlight:hover .spotlight-shot :global(img) {
      transform: none;
    }
  }
</style>
