---
import Badge from "../../../../packages/ui/src/brand/Badge.astro";
import { proofStrip } from '../data/proof-strip';
import HeroBackdrop from './hero/HeroBackdrop.astro';
import HeroPhone from './hero/HeroPhone.astro';
import HeroStack from './hero/HeroStack.astro';

const getStartedUrl = 'https://www.simple-agent-manager.org/self-host/';
const githubUrl = 'https://github.com/raphaeltm/simple-agent-manager';
---

<section class="hero" data-hero data-motion="still" aria-labelledby="hero-title">
  <!-- Pre-paint: start from the exploded intro frame unless the visitor prefers reduced motion. -->
  <script is:inline>
    (function (hero) {
      if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) hero.dataset.motion = 'intro';
    })(document.currentScript && document.currentScript.parentElement);
  </script>
  <HeroBackdrop />

  <div class="hero-copy">
    <Badge>
      Open Source & Self-Hosted
    </Badge>

    <h1 id="hero-title" class="hero-title">
      Run AI coding agents <span class="gradient-text">in parallel</span> on your own cloud
    </h1>

    <p class="hero-subtitle">
      Simple Agent Manager gives every task its own cloud workspace with the agent you already use,
      like Claude Code or Codex. Close your laptop and answer the agent's questions from your phone.
    </p>

    <div class="hero-actions">
      <a href={getStartedUrl} class="sam-btn sam-btn--primary">
        Deploy SAM
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href={githubUrl} class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        View on GitHub
      </a>
    </div>

    <p class="hero-proof">
      {proofStrip.map((item, i) => (
        <>
          {i > 0 && <span class="hero-proof-dot" aria-hidden="true">·</span>}
          <span class="hero-proof-item">{item}</span>
        </>
      ))}
    </p>

    <div class="hero-note">
      <span aria-hidden="true"><b>Real SAM interface</b> · sample project · timing simulated</span>
      <button type="button" class="hero-toggle sam-glass sam-glass--chrome sam-glass-rim" data-hero-toggle data-paused="false" hidden>
        <svg class="icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
        <svg class="icon-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z"/></svg>
        <span data-hero-toggle-label>Pause animation</span>
      </button>
    </div>
  </div>

  <figure class="hero-figure">
    <HeroStack />
    <HeroPhone />
    <figcaption class="sr-only">
      Animated preview of SAM's real interface with a sample project: a project chat streams an
      agent's plan and tool calls while it adds idempotency keys to a refund webhook, beside a comment
      thread, the server SAM picked for the work, and the servers running the workspaces.
      Notifications show one agent needing input and the task completing. Timing is simulated.
    </figcaption>
  </figure>
</section>

<script>
  import { initHero } from './hero/hero-motion';

  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) initHero(hero);
</script>

<style>
  .hero {
    --hero-bg: #050a08;
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: 900px;
    padding: calc(var(--header-height) + 92px) 0 96px;
    background: var(--hero-bg);
  }

  :global(html[data-theme='light']) .hero {
    --hero-bg: var(--color-bg-body);
  }

  /* Blend the hero into the page below it. */
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    height: 140px;
    background: linear-gradient(to bottom, transparent, var(--color-bg-body));
    pointer-events: none;
  }

  /* ---- Copy ---- */
  .hero-copy {
    position: relative;
    z-index: 5;
    display: grid;
    gap: 22px;
    justify-items: start;
    width: 500px;
    margin-left: max(48px, calc(50% - 624px));
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    color: var(--color-fg-dim);
  }

  .hero-proof-item {
    white-space: nowrap;
  }

  .hero-proof-dot {
    color: var(--color-accent);
  }

  /* ---- Figure ---- */
  /* Real-UI layers are themed backgrounds (see hero/layers.ts). */
  .hero :global(.hero-img) {
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  /* The stage starts just right of the copy column and is scaled per width band so the
     resting frame always fits the viewport (rule 56: the hero clips, so nothing may rely on
     content spilling past it). The copy column is max(48px, 50% - 624px) + its width. */
  .hero-figure {
    --copy-width: 500px;
    --stage-scale: 1;
    position: absolute;
    z-index: 4;
    top: 84px;
    left: calc(max(48px, 50% - 624px) + var(--copy-width) + 20px);
    width: 860px;
    height: 800px;
    margin: 0;
  }

  .hero-figure :global(.hero-stack) {
    position: absolute;
    inset: 0;
  }

  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    letter-spacing: 0.04em;
    color: var(--color-fg-dim);
  }

  .hero-note b {
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .hero-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 32px;
    padding: 6px 12px;
    border: 0;
    border-radius: 10px;
    font: inherit;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
    cursor: pointer;
  }

  .hero-toggle:hover {
    color: var(--color-fg-primary);
  }

  .hero-toggle .icon-play,
  .hero-toggle[data-paused='true'] .icon-pause {
    display: none;
  }

  .hero-toggle[data-paused='true'] .icon-play {
    display: block;
  }

  .hero-toggle[hidden] {
    display: none;
  }

  .hero-figure :global(.hero-phone) {
    display: none;
  }

  /* ---- Laptop: same composition, smaller stage ---- */
  @media (max-width: 1599.98px) {
    .hero-figure {
      --stage-scale: 0.94;
    }
  }

  @media (max-width: 1439.98px) {
    .hero-copy {
      width: 460px;
    }

    .hero-figure {
      --copy-width: 460px;
      --stage-scale: 0.9;
    }
  }

  @media (max-width: 1359.98px) {
    .hero-figure {
      --stage-scale: 0.84;
    }
  }

  @media (max-width: 1279.98px) {
    .hero-figure {
      --stage-scale: 0.76;
    }
  }

  /* ---- Tablet: copy above, stage below ---- */
  @media (max-width: 1199.98px) {
    .hero {
      min-height: 0;
      padding-bottom: 72px;
    }

    .hero-copy {
      width: auto;
      max-width: 640px;
      margin: 0 auto;
      padding: 0 32px;
      justify-items: center;
      text-align: center;
    }

    .hero-actions,
    .hero-proof,
    .hero-note {
      justify-content: center;
    }

    .hero-figure {
      --stage-scale: 0.9;
      --stage-left: calc(50% - 430px * var(--stage-scale));
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: calc(760px * var(--stage-scale));
      margin-top: 24px;
    }
  }

  @media (max-width: 959.98px) {
    .hero-figure {
      --stage-scale: 0.74;
    }
  }

  /* ---- Phone: the session on SAM's mobile UI ---- */
  @media (max-width: 699.98px) {
    .hero {
      padding-top: calc(var(--header-height) + 28px);
      padding-bottom: 40px;
    }

    .hero-copy {
      gap: 16px;
      padding: 0 22px;
      justify-items: start;
      text-align: left;
    }

    .hero-actions,
    .hero-proof,
    .hero-note {
      justify-content: flex-start;
    }

    .hero-toggle {
      min-height: 44px;
    }

    .hero-actions {
      flex-wrap: nowrap;
      gap: 10px;
    }

    .hero-actions :global(.sam-btn) {
      padding: 13px 16px;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .hero-figure {
      height: auto;
      margin-top: 34px;
    }

    .hero-figure :global(.hero-stack) {
      display: none;
    }

    .hero-figure :global(.hero-phone) {
      display: block;
    }
  }
</style>
