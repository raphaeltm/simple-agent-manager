---
/**
 * 08 Voice: how SAM writes. Trait dials, before-and-after copy (the old line is struck
 * through as it scrolls in), house rules, words to avoid, and the glossary.
 */
import { BANNED_WORDS, COPY_PAIRS, GLOSSARY } from '../../data/brand';
import SectionHead from './SectionHead.astro';

const traits = [
  { left: 'Plain', right: 'Clever', at: 18 },
  { left: 'Specific', right: 'Grand', at: 14 },
  { left: 'Confident', right: 'Hyped', at: 26 },
  { left: 'Warm', right: 'Cute', at: 34 },
];

const rules = [
  ['Lead with what the reader wants to do.', 'Say what they can get done, then how SAM does it.'],
  ['Sentence case everywhere.', 'Headings, buttons, menus and titles.'],
  ['No em dashes.', 'Use a full stop, a comma or a colon instead.'],
  ['Write "SAM" in capitals.', 'Spell out "Simple Agent Manager" on first mention in long pieces. Never "Sam" or "S.A.M."'],
  ['Name agents by their product names.', 'Claude Code, Codex, Gemini CLI, OpenCode. Not "the AI".'],
  ['Use numerals.', '"3 workspaces", "in 5 minutes". Spell out only at the start of a sentence.'],
  ['Only describe what ships.', 'Experimental features say so. Plans are written as plans.'],
  ['Explain technical terms once.', 'Precise words are fine. Assume the reader does not know how SAM is built.'],
];
---

<section id="voice" class="bg-section" aria-labelledby="voice-title">
  <div class="container">
    <SectionHead id="voice" title="Plain words, real details">
      SAM writes like a good colleague explaining their work: clear, specific and a little warm.
      We would rather show one real example than make three big claims.
    </SectionHead>

    <ul class="bg-traits">
      {traits.map((trait, index) => (
        <li data-reveal style={`--i:${index};--at:${trait.at}%`}>
          <span class="l">{trait.left}</span>
          <span class="bar" aria-hidden="true"><span class="knob"></span></span>
          <span class="r">{trait.right}</span>
          <span class="sr-only">Closer to {trait.left.toLowerCase()} than {trait.right.toLowerCase()}.</span>
        </li>
      ))}
    </ul>

    <h3 class="bg-sub">Instead of this, write that</h3>
    <ol class="bg-pairs">
      {COPY_PAIRS.map((pair) => (
        <li class="bg-pair sam-glass sam-glass-rim" data-reveal>
          <p class="bg-pair-ctx">{pair.context}</p>
          <p class="bg-pair-avoid"><span class="sr-only">Avoid: </span><s>{pair.avoid}</s></p>
          <p class="bg-pair-write"><span class="sr-only">Write: </span>{pair.write}</p>
        </li>
      ))}
    </ol>

    <h3 class="bg-sub">House rules</h3>
    <ul class="bg-rules">
      {rules.map(([title, body]) => (
        <li class="sam-glass sam-glass-rim"><strong>{title}</strong> {body}</li>
      ))}
    </ul>

    <div class="bg-voice-split">
      <div>
        <h3 class="bg-sub">Words we avoid</h3>
        <ul class="bg-banned">
          {BANNED_WORDS.map((word, index) => <li data-reveal="scale" style={`--i:${index % 5}`}><s>{word}</s></li>)}
        </ul>
        <p class="bg-banned-note">They promise a feeling instead of describing a result. Say what actually happens.</p>
      </div>
      <div>
        <h3 class="bg-sub">Glossary</h3>
        <dl class="bg-glossary">
          {GLOSSARY.map((entry) => (
            <div data-reveal="left"><dt>{entry.term}</dt><dd>{entry.meaning}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Trait dials --- */
  .bg-traits {
    display: grid;
    gap: 18px;
    list-style: none;
  }

  @media (min-width: 900px) {
    .bg-traits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }

  .bg-traits li {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) 64px;
    align-items: center;
    gap: 16px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .bg-traits .r {
    color: var(--color-fg-dim);
    text-align: right;
  }

  .bg-traits .bar {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--color-border-subtle);
  }

  .bg-traits .knob {
    position: absolute;
    top: 50%;
    left: var(--at);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px var(--color-accent-glow);
    transform: translate(-50%, -50%);
  }

  :global(html.bg-motion) .bg-traits li .knob {
    transition: left 1.1s var(--ease-spring) 0.3s;
  }

  :global(html.bg-motion) .bg-traits li:not(.is-in) .knob {
    left: 50%;
  }

  /* --- Before and after --- */
  .bg-pairs {
    display: grid;
    gap: 14px;
    list-style: none;
  }

  @media (min-width: 900px) {
    .bg-pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bg-pair {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 26px;
    border-radius: var(--radius-xl);
  }

  .bg-pair-ctx {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }

  .bg-pair-avoid {
    color: var(--color-fg-muted);
  }

  .bg-pair-avoid s {
    text-decoration: none;
    background: linear-gradient(#f87171, #f87171) no-repeat 0 55% / 100% 2px;
  }

  :global(html.bg-motion) .bg-pair-avoid s {
    transition: background-size 0.8s var(--ease-glide) 0.5s;
  }

  :global(html.bg-motion) .bg-pair:not(.is-in) .bg-pair-avoid s {
    background-size: 0% 2px;
  }

  .bg-pair-write {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* --- Words to avoid and glossary --- */
  .bg-voice-split {
    display: grid;
    gap: 0 56px;
  }

  @media (min-width: 900px) {
    .bg-voice-split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .bg-banned {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .bg-banned li {
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .bg-banned s {
    text-decoration-color: #f87171;
    text-decoration-thickness: 2px;
  }

  .bg-banned-note {
    margin-top: 18px;
    color: var(--color-fg-muted);
  }

  .bg-glossary {
    display: grid;
    border-top: 1px solid var(--color-border-subtle);
  }

  .bg-glossary div {
    display: grid;
    gap: 4px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 640px) {
    .bg-glossary div {
      grid-template-columns: 150px minmax(0, 1fr);
    }
  }

  .bg-glossary dt {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .bg-glossary dd {
    color: var(--color-fg-muted);
  }
</style>
