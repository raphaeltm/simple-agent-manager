---
/**
 * 09 Imagery: a layered composition of real app captures (mock-data captures in
 * public/images/hero/) that slide in from different sides at different depths as the section
 * scrolls. Theme-matched: each layer ships a dark and a light capture.
 */
import SectionHead from './SectionHead.astro';
---

<section id="imagery" class="bg-section" aria-labelledby="imagery-title">
  <div class="container">
    <SectionHead id="imagery" title="Show the real product">
      Every picture of SAM is the real app, captured with mock data for a fictional team, Northwind
      Labs. No stock photos, no invented screens, no people generated by AI.
    </SectionHead>

    <figure class="bg-collage" data-progress>
      <div class="bg-collage-stage">
      <div class="bg-collage-desk sam-glass sam-glass-rim">
        <img class="shot-dark" src="/images/hero/desktop.webp" width="1560" height="1138" alt="The SAM app on a desktop: a project's chat list beside an agent working through a plan." loading="lazy" decoding="async" />
        <img class="shot-light" src="/images/hero/desktop-light.webp" width="1560" height="1138" alt="The SAM app on a desktop in light mode: a project's chat list beside an agent working through a plan." loading="lazy" decoding="async" />
      </div>
      <div class="bg-collage-phone sam-glass sam-glass-rim">
        <img class="shot-dark" src="/images/hero/phone.webp" width="780" height="1688" alt="The same conversation on a phone." loading="lazy" decoding="async" />
        <img class="shot-light" src="/images/hero/phone-light.webp" width="780" height="1688" alt="The same conversation on a phone, in light mode." loading="lazy" decoding="async" />
      </div>
      <div class="bg-collage-note sam-glass sam-glass-rim" aria-hidden="true">
        <img class="shot-dark" src="/images/hero/comment.webp" width="398" height="576" alt="" loading="lazy" decoding="async" />
        <img class="shot-light" src="/images/hero/comment-light.webp" width="398" height="576" alt="" loading="lazy" decoding="async" />
      </div>
      </div>
      <figcaption>Desktop, phone and a detail, layered at three depths. Each layer moves at its own speed.</figcaption>
    </figure>

    <ul class="bg-rules">
      <li class="sam-glass sam-glass-rim"><strong>Capture the real UI.</strong> Use the marketing screenshot specs in apps/web with mock data. Never draw a screen that the app does not have.</li>
      <li class="sam-glass sam-glass-rim"><strong>Ship dark and light.</strong> Every capture comes as a pair so it matches the reader's theme.</li>
      <li class="sam-glass sam-glass-rim"><strong>Frame in glass, crop with intent.</strong> Show the part that tells the story. A detail at readable size beats a whole page shrunk down.</li>
      <li class="sam-glass sam-glass-rim"><strong>Keep it sharp and light.</strong> Export at 2x, serve WebP, and give every image its width and height so nothing jumps.</li>
    </ul>
  </div>
</section>

<style>
  .bg-collage {
    margin: 0 0 40px;
  }

  .bg-collage-stage {
    position: relative;
    padding-bottom: 12%;
  }

  .bg-collage img {
    width: 100%;
    border-radius: inherit;
  }

  .bg-collage-stage > div {
    overflow: hidden;
  }

  .bg-collage-desk {
    width: 86%;
    border-radius: 20px;
    padding: 6px;
  }

  .bg-collage-desk img {
    border-radius: 15px;
  }

  .bg-collage-phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    border-radius: 26px;
    padding: 5px;
  }

  .bg-collage-phone img {
    border-radius: 22px;
  }

  .bg-collage-note {
    position: absolute;
    left: -2%;
    bottom: 4%;
    width: 18%;
    border-radius: 18px;
    padding: 4px;
  }

  .bg-collage-note img {
    border-radius: 14px;
  }

  @media (max-width: 639px) {
    .bg-collage-note {
      display: none;
    }

    .bg-collage-phone {
      width: 34%;
    }
  }

  /* Three depths, three speeds. */
  :global(html.bg-motion) .bg-collage-desk {
    transform: translate3d(calc((0.5 - var(--p, 0.5)) * -80px), 0, 0);
  }

  :global(html.bg-motion) .bg-collage-phone {
    transform: translate3d(calc((0.5 - var(--p, 0.5)) * 160px), calc((0.5 - var(--p, 0.5)) * 140px), 0);
  }

  :global(html.bg-motion) .bg-collage-note {
    transform: translate3d(0, calc((0.5 - var(--p, 0.5)) * 220px), 0) rotate(calc((0.5 - var(--p, 0.5)) * -8deg));
  }

  .bg-collage figcaption {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg-dim);
  }
</style>
