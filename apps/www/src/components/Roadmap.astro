---
const phases = [
  {
    title: 'Cloud workspaces',
    status: 'complete',
    description: 'Sign in with GitHub, keep keys encrypted, and get a fresh workspace for each task',
  },
  {
    title: 'Chat and terminal in the browser',
    status: 'complete',
    description: 'Talk to the agent, or open a terminal in its workspace',
  },
  {
    title: 'Six coding agents',
    status: 'complete',
    description: 'Claude Code, Codex, Gemini CLI, Mistral Vibe, OpenCode, Amp',
  },
  {
    title: 'Several agents per server',
    status: 'complete',
    description: 'Isolated workspaces share one machine, so you need fewer servers',
  },
  {
    title: 'Projects',
    status: 'complete',
    description: 'Chats, tasks, and history organized around each repository',
  },
  {
    title: 'More clouds and ways to work',
    status: 'complete',
    description: 'Six more cloud providers, phone notifications, and voice input',
  },
  {
    title: 'Agents that delegate',
    status: 'complete',
    description: 'An agent can start other agents, message them, and wait on their results',
  },
  {
    title: 'Command line',
    status: 'complete',
    description: 'Start tasks and chats and check on them from your terminal',
  },
  {
    title: 'App deployments',
    status: 'complete',
    description: 'Run what the agent built as an app, with environments, logs, and settings',
  },
  {
    title: 'Teams',
    status: 'complete',
    description: 'Shared projects, invite links, and roles',
  },
  {
    title: 'Comments',
    status: 'complete',
    description: 'Comment on agent messages and project files',
  },
  {
    title: 'Choose your servers',
    status: 'complete',
    description: 'Pick machine types across providers and track server costs',
  },
  {
    title: 'Schedules and triggers',
    status: 'complete',
    description: 'Start agents on a schedule, from GitHub events, or from a webhook',
  },
  {
    title: 'AWS',
    status: 'planned',
    description: 'Run agents on Amazon Web Services',
  },
  {
    title: 'More team roles',
    status: 'planned',
    description: 'Give members maintainer or viewer access',
  },
];
---

<section id="roadmap" class="section">
  <div class="container">
    <div class="roadmap-header animate-on-scroll">
      <span class="section-label">Roadmap</span>
      <h2 class="section-title">What's shipped and what's planned</h2>
      <p class="section-subtitle">
        SAM is built in public on GitHub.
      </p>
    </div>

    <div class="timeline">
      {phases.map((phase, i) => (
        <div class="timeline-item animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
          <div class="timeline-marker-col">
            <div class={`timeline-dot ${phase.status}`} />
            {i < phases.length - 1 && <div class="timeline-line" />}
          </div>
          <div class="timeline-content">
            <div class="timeline-meta">
              <h3 class="timeline-title">{phase.title}</h3>
              <span class={`timeline-badge ${phase.status}`}>
                {phase.status === 'complete' ? 'Complete' : phase.status === 'in-progress' ? 'In Progress' : 'Planned'}
              </span>
            </div>
            <p class="timeline-desc">{phase.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .roadmap-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .roadmap-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .timeline {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: 20px;
  }

  .timeline-marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 20px;
  }

  /* Status markers are node tiles: lit green when shipped, amber in progress, outlined when planned. */
  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .timeline-dot.complete {
    background: linear-gradient(160deg, #4ade80, #16a34a);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 0 10px rgb(34 197 94 / 0.4);
  }

  .timeline-dot.in-progress {
    background: linear-gradient(160deg, #fbbf24, #d97706);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 0 10px rgb(245 158 11 / 0.35);
  }

  .timeline-dot.planned {
    background: transparent;
    border: 1.5px solid var(--color-fg-dim);
  }

  :global(html[data-theme='light']) .timeline-dot.complete {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 0 8px var(--shadow-accent-soft);
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    min-height: 20px;
    background: linear-gradient(to bottom, rgb(34 197 94 / 0.35), var(--color-border-subtle));
  }

  .timeline-content {
    padding-bottom: 32px;
  }

  .timeline-item:last-child .timeline-content {
    padding-bottom: 0;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-fg-primary);
  }

  .timeline-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 10px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .timeline-badge.complete {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .timeline-badge.in-progress {
    color: var(--color-warning);
    background: rgba(245, 158, 11, 0.1);
  }

  .timeline-badge.planned {
    color: var(--color-fg-dim);
    background: var(--glass-bg-subtle);
    border: 1px solid var(--glass-border);
  }

  .timeline-desc {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
  }
</style>
