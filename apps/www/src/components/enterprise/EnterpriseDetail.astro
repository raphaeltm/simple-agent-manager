---
/**
 * Shared layout for the /enterprise/<slug>/ deep-dive pages: header, hero, prose body (slot),
 * previous/next navigation and the support call to action.
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import CtaFooter from '../CtaFooter.astro';
import { enterprisePages } from '../../data/enterprise';

interface Props {
  slug: string;
  seoTitle: string;
  seoDescription: string;
  title: string;
  subtitle: string;
}

const { slug, seoTitle, seoDescription, title, subtitle } = Astro.props;
const index = enterprisePages.findIndex((p) => p.slug === slug);
if (index === -1) throw new Error(`Unknown enterprise page: ${slug}`);
const page = enterprisePages[index];
const prev = index > 0 ? enterprisePages[index - 1] : null;
const next = index < enterprisePages.length - 1 ? enterprisePages[index + 1] : null;
---

<Base title={seoTitle} description={seoDescription}>
  <Header />
  <main>
    <section class="ent-detail-hero">
      <div class="container ent-detail-narrow">
        <a href="/enterprise/" class="back-link animate-on-scroll">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          Enterprise overview
        </a>
        <span class="section-label animate-on-scroll">{page.label}</span>
        <h1 class="ent-detail-title animate-on-scroll">{title}</h1>
        <p class="ent-detail-subtitle animate-on-scroll">{subtitle}</p>
      </div>
    </section>

    <hr class="divider" />

    <section class="section">
      <div class="container ent-detail-narrow ent-prose">
        <slot />

        <nav class="ent-pager" aria-label="Enterprise pages">
          {prev ? (
            <a href={`/enterprise/${prev.slug}/`} class="ent-pager-link">
              <span class="ent-pager-dir">Previous</span>
              <span>{prev.label}</span>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/enterprise/${next.slug}/`} class="ent-pager-link ent-pager-next">
              <span class="ent-pager-dir">Next</span>
              <span>{next.label}</span>
            </a>
          ) : (
            <a href="/enterprise/" class="ent-pager-link ent-pager-next">
              <span class="ent-pager-dir">Back to</span>
              <span>Enterprise overview</span>
            </a>
          )}
        </nav>
      </div>
    </section>

    <hr class="divider" />
    <CtaFooter variant="support" />
  </main>
</Base>

<style>
  .ent-detail-hero {
    padding: 140px 0 48px;
  }

  @media (min-width: 768px) {
    .ent-detail-hero {
      padding: 160px 0 64px;
    }
  }

  .ent-detail-narrow {
    max-width: 760px;
  }

  /* The back link sits on its own line, above the section label. */
  .back-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    margin-bottom: 20px;
  }

  .back-link:hover {
    color: var(--color-fg-primary);
  }

  .ent-detail-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-fg-primary);
    margin: 8px 0 20px;
  }

  .ent-detail-subtitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
  }

  .ent-prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-fg-primary);
    margin: 48px 0 14px;
  }

  .ent-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .ent-prose :global(p),
  .ent-prose :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
  }

  .ent-prose :global(p) {
    margin-bottom: 14px;
  }

  .ent-prose :global(ul) {
    padding-left: 20px;
    margin-bottom: 14px;
  }

  .ent-prose :global(li) {
    margin-bottom: 6px;
  }

  .ent-prose :global(strong) {
    color: var(--color-fg-primary);
    font-weight: 600;
  }

  .ent-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .ent-prose :global(.cmp-wrap),
  .ent-prose :global(.shot-frame) {
    margin: 20px 0 8px;
  }

  .ent-prose :global(.callout) {
    padding: 16px 20px;
    margin: 20px 0;
    border: 1px solid var(--glass-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
  }

  .ent-prose :global(.callout p:last-child) {
    margin-bottom: 0;
  }

  .ent-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--glass-border);
  }

  .ent-pager-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-fg-primary);
    font-weight: 500;
  }

  .ent-pager-link:hover {
    border-color: var(--glass-border-hover);
  }

  .ent-pager-next {
    text-align: right;
  }

  .ent-pager-dir {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
