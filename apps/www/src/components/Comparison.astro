---
const rows = [
  {
    label: 'Where your code runs',
    sam: 'Your own cloud account (Hetzner, Scaleway, Vultr, Infomaniak, DigitalOcean, UpCloud, GCP), or Instant workspaces with no cloud provider account',
    managed: 'Their infrastructure',
    selfHosted: 'Your infra (AWS, GCP, K8s)',
    samWins: true,
  },
  {
    label: 'Which agents you can use',
    sam: 'Claude Code, Codex, Gemini CLI, Mistral Vibe, OpenCode, Amp',
    managed: 'Their proprietary agent',
    selfHosted: 'Native agent with configurable LLM providers; third-party agents in workspaces',
    samWins: true,
  },
  {
    label: 'Open source',
    sam: 'Yes, AGPL-3.0',
    managed: 'Proprietary',
    selfHosted: 'Open-source core',
    samWins: true,
  },
  {
    label: 'Running SAM itself',
    sam: 'A Cloudflare Workers Paid plan',
    managed: 'Bundled into pricing',
    selfHosted: 'You host it (K8s / Docker)',
    samWins: true,
  },
  {
    label: 'What you pay for compute',
    sam: 'Your cloud provider bills you directly for your servers',
    managed: 'From $20/mo (compute + inference)',
    selfHosted: 'Your cloud bill + license fees',
    samWins: true,
  },
  {
    label: 'Can you host it yourself?',
    sam: 'Yes, all of it: SAM and the servers it uses',
    managed: 'Managed service; enterprise VPC deployment available',
    selfHosted: 'Yes: standalone server, Docker, or K8s; Terraform workspaces',
    samWins: true,
  },
  {
    label: 'Team projects',
    sam: 'Invite links, approval, and owner and admin roles',
    managed: 'Seat-based team plans',
    selfHosted: 'Workspace access control and read-only agent chat sharing',
    samWins: true,
  },
  {
    label: 'Comments the agent reads',
    sam: 'Comment on agent replies; the agent answers and resolves the thread',
    managed: 'Bundled or unavailable',
    selfHosted: 'No agent-level comments',
    samWins: true,
  },
  {
    label: 'Mixing cloud providers',
    sam: '7 providers; you pick the machine types and how work is spread',
    managed: 'Single vendor',
    selfHosted: 'You wire it yourself',
    samWins: true,
  },
  {
    label: 'Usage and budgets',
    sam: 'Server hours per person and an admin cost summary; AI usage tracking when AI goes through SAM',
    managed: 'Bundled into one bill',
    selfHosted: 'AI usage reporting and licensed AI Gateway budgets',
    samWins: true,
  },
  {
    label: 'Work that starts on its own',
    sam: 'Schedules, GitHub events, and authenticated webhooks',
    managed: 'Schedules, GitHub/integration events, and custom webhooks',
    selfHosted: 'Agent API for custom webhook and scheduled automation',
    samWins: true,
  },
  {
    label: 'Picking up where you left off',
    sam: 'Sessions sleep and wake with their files for up to 7 days',
    managed: 'Varies by vendor',
    selfHosted: 'Persistent agent chats; workspace storage depends on template',
    samWins: true,
  },
  {
    label: 'Setup effort',
    sam: 'Deploy to your Cloudflare account; connect a cloud provider for your own servers',
    managed: 'Zero config',
    selfHosted: 'Server deployment + Terraform workspace templates',
    samWins: false,
  },
  {
    label: 'Where your data lives',
    sam: 'Workspaces run on your servers; chats, session snapshots, and SAM data are stored in your Cloudflare account',
    managed: 'Vendor-managed',
    selfHosted: 'Full: your infrastructure',
    samWins: true,
  },
];
---

<section id="comparison" class="section">
  <div class="container">
    <div class="comparison-header animate-on-scroll">
      <span class="section-label">Comparison</span>
      <h2 class="section-title">How SAM compares</h2>
      <p class="section-subtitle">
        SAM runs the agent you choose on servers you own, at your cloud provider's prices.
      </p>
    </div>

    <div class="table-wrapper sam-glass sam-glass-rim animate-on-scroll" tabindex="0" role="region" aria-label="Comparison table">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-label"><span class="sr-only">Capability</span></th>
            <th class="col-sam">
              <div class="col-header-content">
                <img src="/images/sam-head.png" width="20" height="20" alt="" aria-hidden="true" style="border-radius: 4px;" />
                SAM
              </div>
            </th>
            <th class="col-other">
              <div class="col-header-content col-header-managed">
                Hosted agent platforms
                <span class="col-examples">Devin</span>
              </div>
            </th>
            <th class="col-other">
              <div class="col-header-content col-header-selfhosted">
                Self-hosted dev environments
                <span class="col-examples">Coder</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="col-label">{row.label}</td>
              <td class={`col-sam ${row.samWins ? 'highlight' : ''}`} data-label="SAM">{row.sam}</td>
              <td class="col-other" data-label="Hosted agent platforms">{row.managed}</td>
              <td class="col-other" data-label="Self-hosted dev environments">{row.selfHosted}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="comparison-footnote animate-on-scroll">
      Compute costs don't include AI usage, which usually goes on your own key or plan. Hosted platforms
      bundle compute and AI usage into one price. For a local alternative, read
      <a href="/compare/paseo/">how SAM compares with Paseo</a>, a local-first app for coding agents.
    </p>
  </div>
</section>

<style>
  .comparison-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .comparison-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-xl);
    padding: 8px;
  }

  .comparison-table {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 14px 20px;
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
  }

  /* SAM's column is a raised, lit band rather than green text. */
  .comparison-table .col-sam {
    background: rgb(34 197 94 / 0.07);
    box-shadow:
      inset 1px 0 0 rgb(34 197 94 / 0.22),
      inset -1px 0 0 rgb(34 197 94 / 0.22);
  }

  .comparison-table th.col-sam {
    border-radius: 12px 12px 0 0;
    box-shadow:
      inset 1px 0 0 rgb(34 197 94 / 0.22),
      inset -1px 0 0 rgb(34 197 94 / 0.22),
      inset 0 1px 0 rgb(34 197 94 / 0.35);
  }

  .comparison-table tbody tr:last-child td.col-sam {
    border-radius: 0 0 12px 12px;
    box-shadow:
      inset 1px 0 0 rgb(34 197 94 / 0.22),
      inset -1px 0 0 rgb(34 197 94 / 0.22),
      inset 0 -1px 0 rgb(34 197 94 / 0.35);
  }

  :global(html[data-theme='light']) .comparison-table .col-sam {
    background: rgb(21 128 61 / 0.06);
  }

  /* Where SAM does not win, the band goes neutral so the column does not oversell. */
  .comparison-table td.col-sam:not(.highlight) {
    background: rgb(255 255 255 / 0.03);
    color: var(--color-fg-muted);
  }

  :global(html[data-theme='light']) .comparison-table td.col-sam:not(.highlight) {
    background: rgb(17 39 29 / 0.03);
  }

  .col-header-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .col-header-managed,
  .col-header-selfhosted {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .col-examples {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-fg-dim);
  }

  .col-label {
    color: var(--color-fg-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Below tablet width the four-column table cannot fit: stack each row as a
     card (label, then SAM / Managed / Self-hosted values with inline headings)
     so every cell stays readable without horizontal scrolling. */
  @media (max-width: 767px) {
    .table-wrapper {
      overflow-x: visible;
      padding: 4px;
    }

    .comparison-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .comparison-table,
    .comparison-table tbody,
    .comparison-table tr,
    .comparison-table td {
      display: block;
    }

    .comparison-table tr {
      padding: 14px 12px 6px;
      border-bottom: 1px solid var(--glass-border);
    }

    .comparison-table tr:last-child {
      border-bottom: none;
    }

    .comparison-table td {
      border-bottom: none;
      padding: 4px 0;
    }

    .comparison-table .col-sam,
    .comparison-table th.col-sam,
    .comparison-table tbody tr:last-child td.col-sam {
      margin: 4px -8px;
      padding: 8px;
      border-radius: 10px;
      box-shadow: inset 0 0 0 1px rgb(34 197 94 / 0.22);
    }

    .col-label {
      white-space: normal;
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--color-fg-primary);
      padding-bottom: 8px;
    }

    .comparison-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-fg-dim);
      margin-bottom: 2px;
    }

    .col-sam[data-label]::before {
      color: var(--color-accent);
    }
  }

  .col-sam {
    color: var(--color-fg-primary);
  }

  .col-sam.highlight {
    font-weight: 500;
  }

  .col-other {
    color: var(--color-fg-muted);
  }

  .comparison-footnote {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-fg-dim);
    margin-top: 24px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .comparison-footnote a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .comparison-footnote a:hover {
    color: var(--color-accent-hover);
  }
</style>
