---
const rows = [
  {
    label: 'Your code runs on',
    sam: 'Your cloud (Hetzner, Scaleway, Vultr, Infomaniak, DigitalOcean, UpCloud, GCP)',
    managed: 'Their infrastructure',
    selfHosted: 'Your infra (AWS, GCP, K8s)',
    samWins: true,
  },
  {
    label: 'Agent choice',
    sam: 'Claude Code, Codex, Gemini CLI, Mistral Vibe, OpenCode, Amp',
    managed: 'Their proprietary agent',
    selfHosted: 'Varies (Claude, OpenAI)',
    samWins: true,
  },
  {
    label: 'Open source',
    sam: 'AGPL-3.0 license',
    managed: 'Proprietary',
    selfHosted: 'Open-source core',
    samWins: true,
  },
  {
    label: 'Control plane',
    sam: 'Workers Paid base plan',
    managed: 'Bundled into pricing',
    selfHosted: 'You host it (K8s / Docker)',
    samWins: true,
  },
  {
    label: 'Infrastructure cost',
    sam: 'Cloud bill direct to provider',
    managed: 'From $20/mo (compute + inference)',
    selfHosted: 'Your cloud bill + license fees',
    samWins: true,
  },
  {
    label: 'Self-hostable',
    sam: 'Fully — control plane + VMs',
    managed: 'No',
    selfHosted: 'Yes — Terraform + K8s required',
    samWins: true,
  },
  {
    label: 'Shared projects & roles',
    sam: 'Invite link, approval, owner/admin roles, credential attribution',
    managed: 'Seat-based team plans',
    selfHosted: 'Workspace access control; no agent-level sharing',
    samWins: true,
  },
  {
    label: 'Comments that become agent context',
    sam: 'Comment on chat or files, send to agent, agent replies and resolves',
    managed: 'Bundled or unavailable',
    selfHosted: 'No agent-level comments',
    samWins: true,
  },
  {
    label: 'Compute pools across clouds',
    sam: '7 providers, real SKUs, strategy + exhaustion policy per pool',
    managed: 'Single vendor, opaque sizing',
    selfHosted: 'You wire it yourself',
    samWins: true,
  },
  {
    label: 'Token & compute usage reporting',
    sam: 'Per-user usage by model/day + monthly budget, node-hours, admin cost summary',
    managed: 'Bundled into one bill',
    selfHosted: 'No built-in reporting',
    samWins: true,
  },
  {
    label: 'Event triggers & webhooks',
    sam: 'Cron, GitHub events, authenticated webhooks, standing watches',
    managed: 'Vendor-defined integrations only',
    selfHosted: 'No agent-level triggers',
    samWins: true,
  },
  {
    label: 'Durable sleep/wake sessions',
    sam: '7-day snapshot resumes agent state and repo work',
    managed: 'Varies, usually opaque',
    selfHosted: 'Workspace volumes persist; agent session state does not',
    samWins: true,
  },
  {
    label: 'Setup effort',
    sam: 'Deploy to Cloudflare + connect cloud',
    managed: 'Zero config',
    selfHosted: 'Terraform + cluster management',
    samWins: false,
  },
  {
    label: 'Data sovereignty',
    sam: 'Code runs on your cloud; control plane data in Cloudflare',
    managed: 'Vendor-managed',
    selfHosted: 'Full — your infrastructure',
    samWins: true,
  },
];
---

<section id="comparison" class="section">
  <div class="container">
    <div class="comparison-header animate-on-scroll">
      <span class="section-label">Comparison</span>
      <h2 class="section-title">How SAM stacks up</h2>
      <p class="section-subtitle">
        Own your infrastructure. Choose your agent. Pay cloud prices.
      </p>
    </div>

    <div class="table-wrapper animate-on-scroll" tabindex="0" role="region" aria-label="Comparison table">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-label"></th>
            <th class="col-sam">
              <div class="col-header-content">
                <img src="/images/sam-head.png" width="20" height="20" alt="" aria-hidden="true" style="border-radius: 4px;" />
                SAM
              </div>
            </th>
            <th class="col-other">
              <div class="col-header-content col-header-managed">
                Managed AI Platforms
                <span class="col-examples">Devin</span>
              </div>
            </th>
            <th class="col-other">
              <div class="col-header-content col-header-selfhosted">
                Self-Hosted CDEs
                <span class="col-examples">Coder</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="col-label">{row.label}</td>
              <td class={`col-sam ${row.samWins ? 'highlight' : ''}`} data-label="SAM">{row.sam}</td>
              <td class="col-other" data-label="Managed AI Platforms">{row.managed}</td>
              <td class="col-other" data-label="Self-Hosted CDEs">{row.selfHosted}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="comparison-footnote animate-on-scroll">
      SAM infrastructure costs are compute only — bring your own API keys for AI providers.
      Managed platform pricing bundles compute and model inference.
      Read the <a href="/compare/paseo/">SAM vs Paseo comparison</a>.
    </p>
  </div>
</section>

<style>
  .comparison-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .comparison-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-shadow), 0 0 60px rgba(22, 163, 74, 0.04);
    padding: 8px;
  }

  .comparison-table {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 14px 20px;
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .comparison-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
  }

  .col-header-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .col-header-managed,
  .col-header-selfhosted {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .col-examples {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-fg-dim);
  }

  .col-label {
    color: var(--color-fg-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Below tablet width the four-column table cannot fit: stack each row as a
     card (label, then SAM / Managed / Self-hosted values with inline headings)
     so every cell stays readable without horizontal scrolling. */
  @media (max-width: 767px) {
    .table-wrapper {
      overflow-x: visible;
      padding: 4px;
    }

    .comparison-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .comparison-table,
    .comparison-table tbody,
    .comparison-table tr,
    .comparison-table td {
      display: block;
    }

    .comparison-table tr {
      padding: 14px 12px 6px;
      border-bottom: 1px solid var(--glass-border);
    }

    .comparison-table tr:last-child {
      border-bottom: none;
    }

    .comparison-table td {
      border-bottom: none;
      padding: 4px 0;
    }

    .col-label {
      white-space: normal;
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--color-fg-primary);
      padding-bottom: 8px;
    }

    .comparison-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-fg-dim);
      margin-bottom: 2px;
    }

    .col-sam[data-label]::before {
      color: var(--color-accent);
    }
  }

  .col-sam {
    color: var(--color-fg-primary);
  }

  .col-sam.highlight {
    color: var(--color-accent);
    font-weight: 500;
  }

  .col-other {
    color: var(--color-fg-dim);
  }

  .comparison-footnote {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-fg-dim);
    margin-top: 24px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .comparison-footnote a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .comparison-footnote a:hover {
    color: var(--color-accent-hover);
  }
</style>
