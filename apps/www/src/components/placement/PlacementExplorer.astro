---
import { PROVIDER_CATALOG, PROVIDER_IDS } from './catalog';
import { EXHAUSTION_POLICIES, HOST_ORDERING, STRATEGIES, WORKLOAD_PRESETS } from './model';

const strategyLabels: Record<string, string> = {
  pack: 'Pack',
  spread: 'Spread',
  balanced: 'Balanced',
  'smallest-fit': 'Smallest fit',
};
const policyLabels: Record<string, string> = {
  fail: 'fail',
  queue: 'queue',
  'fallback-chain': 'fallback-chain',
};
---

<p class="explorer-intro">
  Four strategies, one pool, the same pile of work. Pick a provider, throw workloads at it, and
  watch where they land — then switch strategy and watch them land somewhere else.
</p>

<placement-explorer class="placement-lab" aria-label="Interactive placement strategy explorer">
  <div class="lab-heading">
    <div>
      <span class="eyebrow">SAM / SYSTEMS LAB 002</span>
      <h2>Where does the work go?</h2>
    </div>
    <span class="lab-badge"><i></i> INTERACTIVE EXPLAINER</span>
  </div>

  <noscript>
    <p class="noscript-note">
      Enable JavaScript to run the explorer. The full explanation, including every ordering key it
      demonstrates, is written out below.
    </p>
  </noscript>

  <div class="lab-body" hidden data-lab-body>
    <section class="panel" aria-label="Pool configuration">
      <div class="panel-title">01 · The pool</div>
      <div class="field-row">
        <label class="field">
          <span>Provider</span>
          <select data-provider>
            {PROVIDER_IDS.map((id) => <option value={id}>{PROVIDER_CATALOG[id].label}</option>)}
          </select>
        </label>
        <label class="field">
          <span>On stockout</span>
          <select data-policy>
            {EXHAUSTION_POLICIES.map((policy) => (
              <option value={policy}>{policyLabels[policy]}</option>
            ))}
          </select>
        </label>
      </div>
      <fieldset class="regions" data-regions>
        <legend>Regions <span class="hint">tick a region to include it; the flame marks it out of stock</span></legend>
      </fieldset>
      <p class="catalog-note" data-catalog-note></p>
    </section>

    <section class="panel" aria-label="Placement strategy">
      <div class="panel-title">02 · The strategy</div>
      <div class="strategies" role="group" aria-label="Placement strategy">
        {STRATEGIES.map((strategy, index) => (
          <button type="button" data-strategy={strategy} aria-pressed={index === 2}>
            {strategyLabels[strategy]}
          </button>
        ))}
      </div>
      <p class="ordering" data-ordering>{HOST_ORDERING.balanced}</p>
    </section>

    <section class="panel" aria-label="Workloads">
      <div class="panel-title">03 · The work</div>
      <div class="submit-row">
        {Object.entries(WORKLOAD_PRESETS).map(([shape, preset]) => (
          <button type="button" data-shape={shape} title={preset.note}>
            ＋ {preset.label}
            <em>{preset.cpuMillis / 1000} vCPU · {preset.memoryMb / 1024} GB</em>
          </button>
        ))}
        <button type="button" class="primary" data-action="batch">⚡ Generate a batch</button>
      </div>
      <div class="transport">
        <button type="button" data-action="step">Step ▸</button>
        <button type="button" data-action="play">Play ▸▸</button>
        <button type="button" data-action="reset">Reset</button>
        <span class="clock" data-clock>STEP 00</span>
      </div>
    </section>

    <section class="panel fleet-panel" aria-label="Fleet">
      <div class="panel-title">
        04 · The fleet <span class="summary" data-fleet-summary></span>
      </div>
      <ul class="fleet" data-fleet aria-live="polite"></ul>
    </section>

    <div class="readout">
      <section class="panel" aria-label="Workloads in flight">
        <div class="panel-title">05 · Workloads</div>
        <ul class="workloads" data-workloads></ul>
      </section>
      <section class="panel" aria-label="Decision log">
        <div class="panel-title">06 · Decisions</div>
        <ol class="events" data-events></ol>
      </section>
    </div>

    <section class="panel" aria-label="Strategy comparison">
      <div class="panel-title">
        07 · Same work, every strategy
        <span class="summary">run to completion from the current pool</span>
      </div>
      <div class="compare-scroll" tabindex="0" role="region" aria-label="Strategy comparison table, scrolls horizontally">
        <table class="compare" data-compare>
          <thead>
            <tr>
              <th scope="col">Strategy</th>
              <th scope="col">Ordering key</th>
              <th scope="col">Bought</th>
              <th scope="col">Fleet cost</th>
              <th scope="col">Work per host</th>
              <th scope="col">Regions</th>
              <th scope="col">Rejected</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p class="compare-note" data-compare-note></p>
    </section>

    <p class="model-note">
      A teaching model, not production scheduling code. The host memory reserve (512 MB) and the
      co-tenant cap (4) are real defaults; boot, run, warm and wait durations are compressed into
      countable steps and are <strong>illustrative values, not SAM defaults</strong>. Machine
      names, sizes and prices are snapshotted from the provider catalogs in
      <code>packages/providers</code>, with one price per SKU across regions.
    </p>
  </div>
</placement-explorer>

<script>
  import './explorer';
</script>

<style>
  .explorer-intro {
    font-size: 1.16rem;
    color: var(--color-fg-muted);
  }
</style>

<style is:global>
  /*
   * Rooted at the `placement-explorer` custom element rather than relying on Astro's scoped
   * styles. Astro scopes by adding a class to elements IN THE TEMPLATE, so a selector compiles to
   * `.fleet:where(.astro-xxx) li:where(.astro-xxx)` — and every node this component builds at
   * runtime (fleet cards, workload rows, event lines, comparison rows) is created by
   * `document.createElement` and never receives that class. Scoped styles would leave the entire
   * dynamic surface unstyled while the markup and behaviour tests still passed.
   */

  placement-explorer {
    --lab-line: #2a4434;
    --lab-dim: #a8bdaf;
    --lab-green: #9dffb8;
    display: block;
    width: min(1080px, calc(100vw - 48px));
    margin: 36px 0 48px;
    margin-left: 50%;
    transform: translateX(-50%);
    color: #e6f2ee;
    color-scheme: dark;
    border: 1px solid #365a46;
    border-radius: 22px;
    overflow: hidden;
    background: #09130f;
    box-shadow:
      0 30px 110px #0004,
      0 0 70px #22c55e0a;
    font-size: 14px;
    line-height: 1.5;
  }
  placement-explorer .lab-heading {
    padding: 28px 30px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    background: radial-gradient(ellipse at 70% 0, #2b5d3338, transparent 65%);
  }
  placement-explorer .lab-heading h2 {
    margin: 6px 0 0;
    font-size: 24px;
    line-height: 1.2;
    color: #fff;
  }
  placement-explorer .eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--lab-green);
    text-transform: uppercase;
  }
  placement-explorer .lab-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--lab-dim);
    border: 1px solid var(--lab-line);
    border-radius: 999px;
    padding: 6px 12px;
    white-space: nowrap;
  }
  placement-explorer .lab-badge i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lab-green);
  }
  placement-explorer .noscript-note,
  placement-explorer .model-note {
    color: var(--lab-dim);
    font-size: 11px;
    padding: 15px 30px;
    border-top: 1px solid var(--lab-line);
    background: #0b1811;
    margin: 0;
  }
  /* `strong` and `code` inherit the site's light-theme prose colours, which land at 1.15:1 and
     1.9:1 on this dark panel. Set both explicitly. */
  placement-explorer p.model-note strong {
    color: #e6f2ee;
  }
  placement-explorer p.model-note code {
    color: var(--lab-green);
    background: #12241a;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 11px;
  }

  placement-explorer .panel {
    border-top: 1px solid var(--lab-line);
    padding: 18px 30px;
    min-width: 0;
  }
  placement-explorer .panel-title {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lab-green);
    margin-bottom: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
  }
  placement-explorer .summary {
    color: var(--lab-dim);
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 11px;
  }

  placement-explorer .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }
  placement-explorer .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    flex: 1 1 160px;
  }
  placement-explorer .field > span {
    font-size: 11px;
    color: var(--lab-dim);
  }
  placement-explorer select {
    background: #0f1f16;
    color: #e6f2ee;
    border: 1px solid var(--lab-line);
    border-radius: 8px;
    padding: 8px 10px;
    font: inherit;
    font-size: 13px;
    width: 100%;
    min-width: 0;
  }

  placement-explorer .regions {
    border: 1px solid var(--lab-line);
    border-radius: 10px;
    padding: 12px;
    margin: 0 0 10px;
    min-width: 0;
  }
  placement-explorer .regions legend {
    font-size: 11px;
    color: var(--lab-dim);
    padding: 0 6px;
  }
  placement-explorer .regions .hint {
    color: #6f8a79;
  }
  placement-explorer .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(126px, 1fr));
    gap: 7px;
  }
  placement-explorer .region-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--lab-line);
    border-radius: 8px;
    padding: 6px 8px;
    background: #0d1c14;
    min-width: 0;
  }
  placement-explorer .region-chip label {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    min-width: 0;
    cursor: pointer;
  }
  placement-explorer .region-chip .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
  }
  placement-explorer .region-chip button {
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 5px;
    filter: grayscale(1) opacity(0.45);
  }
  placement-explorer .region-chip button[aria-pressed='true'] {
    filter: none;
    background: #3a1414;
  }
  placement-explorer .catalog-note {
    margin: 0;
    font-size: 11px;
    color: var(--lab-dim);
  }

  placement-explorer .strategies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 7px;
  }
  placement-explorer button {
    font: inherit;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  placement-explorer .strategies button {
    background: #0f1f16;
    color: #cfe6d8;
    border: 1px solid var(--lab-line);
    border-radius: 9px;
    padding: 10px 8px;
    font-size: 13px;
    min-width: 0;
  }
  placement-explorer .strategies button[aria-pressed='true'] {
    background: #163a24;
    border-color: var(--lab-green);
    color: #fff;
  }
  placement-explorer .ordering {
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--lab-dim);
  }
  placement-explorer .ordering::before {
    content: 'host ordering — ';
    color: #6f8a79;
  }

  placement-explorer .submit-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 7px;
  }
  placement-explorer .submit-row button {
    background: #0f1f16;
    color: #cfe6d8;
    border: 1px solid var(--lab-line);
    border-radius: 9px;
    padding: 9px 10px;
    font-size: 13px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  placement-explorer .submit-row button em {
    font-style: normal;
    font-size: 10.5px;
    color: #6f8a79;
  }
  placement-explorer .submit-row .primary {
    background: #163a24;
    border-color: #3f7a55;
    color: #fff;
    justify-content: center;
  }
  placement-explorer .transport {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
  }
  placement-explorer .transport button {
    background: #0f1f16;
    color: #cfe6d8;
    border: 1px solid var(--lab-line);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
  }
  placement-explorer .transport .clock {
    margin-left: auto;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--lab-dim);
  }

  placement-explorer .fleet,
  placement-explorer .workloads,
  placement-explorer .events {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  placement-explorer .fleet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(214px, 1fr));
    gap: 9px;
  }
  placement-explorer .fleet li {
    border: 1px solid var(--lab-line);
    border-radius: 11px;
    padding: 11px;
    background: #0d1c14;
    min-width: 0;
  }
  placement-explorer .fleet .node-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  placement-explorer .fleet .sku {
    font-weight: 600;
    color: #fff;
    overflow-wrap: anywhere;
  }
  placement-explorer .fleet .state {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 2px 8px;
    border: 1px solid var(--lab-line);
    white-space: nowrap;
  }
  placement-explorer .fleet .state[data-state='active'] {
    color: var(--lab-green);
    border-color: #3f7a55;
  }
  placement-explorer .fleet .state[data-state='booting'] {
    color: #ffd479;
    border-color: #6b5a2a;
  }
  placement-explorer .fleet .state[data-state='warm'] {
    color: #79c8ff;
    border-color: #2a566b;
  }
  placement-explorer .fleet .state[data-state='destroyed'] {
    color: #8b8b8b;
  }
  placement-explorer .fleet .meta {
    font-size: 11px;
    color: var(--lab-dim);
    margin: 3px 0 8px;
    overflow-wrap: anywhere;
  }
  placement-explorer .bar {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 7px;
    align-items: center;
    font-size: 10.5px;
    color: var(--lab-dim);
    margin-top: 4px;
  }
  placement-explorer .bar .track {
    height: 6px;
    border-radius: 999px;
    background: #16281d;
    overflow: hidden;
  }
  placement-explorer .bar .fill {
    display: block;
    height: 100%;
    background: var(--lab-green);
  }
  placement-explorer .bar .fill[data-over='true'] {
    background: #ff8080;
  }

  placement-explorer .readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  placement-explorer .readout .panel + .panel {
    border-left: 1px solid var(--lab-line);
  }
  placement-explorer .workloads li,
  placement-explorer .events li {
    font-size: 12px;
    padding: 6px 0;
    border-bottom: 1px dashed #1c3325;
    overflow-wrap: anywhere;
  }
  placement-explorer .workloads .tag {
    display: inline-block;
    min-width: 62px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lab-dim);
  }
  placement-explorer .workloads li[data-state='rejected'] .tag {
    color: #ff9b9b;
  }
  placement-explorer .workloads li[data-state='running'] .tag {
    color: var(--lab-green);
  }
  placement-explorer .workloads .why {
    color: var(--lab-dim);
  }
  placement-explorer .events li {
    color: var(--lab-dim);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
  }
  placement-explorer .empty {
    color: #6f8a79;
    font-size: 12px;
    padding: 6px 0;
  }

  placement-explorer .compare-scroll {
    overflow-x: auto;
  }
  placement-explorer .compare {
    /* `max-content` + `min-width: 100%` keeps the WRAPPER the only scrollable element. With a
       fixed `min-width` the table itself overflowed at mobile widths, which made the table the
       scroll container — and an unfocusable one (axe scrollable-region-focusable). */
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  placement-explorer .compare th,
  placement-explorer .compare td {
    text-align: left;
    padding: 7px 9px;
    border-bottom: 1px solid #1c3325;
    white-space: nowrap;
  }
  placement-explorer /* Set explicitly: inheriting the site's muted table colour gives 2.48:1 on this dark panel. */
  .compare td {
    color: #cfe6d8;
  }
  placement-explorer .compare-scroll:focus-visible {
    outline: 2px solid var(--lab-green);
    outline-offset: 2px;
  }
  placement-explorer .compare th {
    color: var(--lab-dim);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  placement-explorer .compare tr[data-current='true'] {
    background: #12281b;
  }
  placement-explorer .compare tr[data-current='true'] td {
    color: #fff;
  }
  placement-explorer .compare-note {
    margin: 10px 0 0;
    font-size: 11.5px;
    color: var(--lab-dim);
  }

  @media (max-width: 860px) {
    placement-explorer .readout {
      grid-template-columns: 1fr;
    }
    placement-explorer .readout .panel + .panel {
      border-left: 0;
    }
  }
  @media (max-width: 650px) {
    placement-explorer {
      width: calc(100vw - 24px);
      border-radius: 14px;
      font-size: 13px;
    }
    placement-explorer .lab-heading {
      padding: 20px 16px;
    }
    placement-explorer .lab-heading h2 {
      font-size: 20px;
    }
    placement-explorer .lab-badge {
      display: none;
    }
    placement-explorer .panel {
      padding: 16px;
    }
    placement-explorer .noscript-note,
  placement-explorer .model-note {
      padding: 14px 16px;
    }
    placement-explorer .fleet {
      grid-template-columns: 1fr;
    }
    placement-explorer .region-grid {
      grid-template-columns: 1fr 1fr;
    }
    placement-explorer .submit-row {
      grid-template-columns: 1fr 1fr;
    }
    placement-explorer .transport .clock {
      margin-left: 0;
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    placement-explorer button {
      transition: none;
    }
  }

</style>
