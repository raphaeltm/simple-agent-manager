---
/**
 * Homepage security warning: one amber line at the top of the hero that sends self-hosters to the
 * setup-takeover advisory. It shows only while that post is pinned on the blog, so the advisory's
 * `pinned` / `pinnedUntil` frontmatter controls both; the copy below is specific to that advisory.
 */
import { getEntry } from 'astro:content';
import { isPinnedAt } from '../../lib/blog-utils';

const ADVISORY_ID = 'security-advisory-setup-takeover';
const advisory = await getEntry('blog', ADVISORY_ID);
const show = Boolean(advisory && !advisory.data.draft && isPinnedAt(advisory.data, new Date()));
---

{show && (
  <a class="fh-notice" href={`/blog/${ADVISORY_ID}/`}>
    <svg class="fh-notice-icon" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 1.5 15 14H1L8 1.5Z" />
      <path class="fh-notice-mark" d="M8 6v3.5M8 11.6v.1" />
    </svg>
    <span class="fh-notice-tag">Security advisory</span>
    <span class="fh-notice-text">Self-hosting SAM? Check that your setup wizard is closed.</span>
    <span class="fh-notice-cta">Check now <span aria-hidden="true">→</span></span>
  </a>
)}

<style>
  .fh-notice {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    max-width: 100%;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-warning) 80%, transparent);
    background: color-mix(in srgb, var(--color-warning) 14%, var(--color-bg-surface));
    color: var(--color-fg-primary);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: left;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .fh-notice:hover {
    color: var(--color-fg-primary);
    border-color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 22%, var(--color-bg-surface));
  }

  .fh-notice:focus-visible {
    outline: 2px solid var(--color-warning);
    outline-offset: 3px;
  }

  .fh-notice-icon {
    flex: none;
    width: 16px;
    height: 16px;
    fill: var(--color-warning);
  }

  .fh-notice-mark {
    fill: none;
    stroke: var(--color-bg-body);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .fh-notice-tag {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-warning-ink);
  }

  .fh-notice-cta {
    font-weight: 600;
    color: var(--color-warning-ink);
    white-space: nowrap;
  }

  /* Phones: tag and CTA share the first row so the card stays two lines tall and the hero's
     second button stays above the fold. Visual order only; DOM and reading order are unchanged. */
  @media (max-width: 640px) {
    .fh-notice {
      border-radius: var(--radius-lg);
      padding: 8px 14px;
      justify-content: space-between;
    }

    .fh-notice-text {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
