---
/**
 * The hero's real SAM screens as a 3D stack: the machines underneath, the home screen, and cards
 * from one project in front (an agent's profile, a workflow, an agent waiting on a person, a pull
 * request whose checks passed). hero-motion.ts starts it exploded with each layer labelled,
 * assembles it, then lets the cards take turns lighting up while the stack floats and follows the
 * pointer. The markup is the resting frame: no-JS and reduced-motion visitors see it composed.
 */
import Shot from './Shot.astro';

const planes = [
  { id: 'machine', shot: 'machine', label: 'Machines in your cloud', z: -150 },
  { id: 'app', shot: 'dashboard', label: 'Your team’s work', z: 0 },
  { id: 'agent', shot: 'agent-chip', label: 'Agents you choose', z: 110 },
  { id: 'wf', shot: 'wf-chip', label: 'Steps they run', z: 80 },
  { id: 'review', shot: 'idea-review', label: 'Checks passed', z: 150 },
  { id: 'needs', shot: 'needs-you', label: 'Needs you', z: 190 },
] as const;
---

<div class="hs" data-fh-stage>
  <div class="hs-stack" data-fh-stack>
    {planes.map((p, i) => (
      <div class={`hs-plane hs-${p.id}`} style={`--z:${p.z};--i:${i}`} data-plane={p.id}>
        <div class="hs-float">
          <div class="hs-card">
            <Shot name={p.shot} eager decorative={p.id !== 'app'} />
          </div>
          <span class="hs-fig" aria-hidden="true">{String(i + 1).padStart(2, '0')} · {p.label}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .hs {
    --ease-pose: cubic-bezier(0.16, 0.84, 0.22, 1);
    position: relative;
    width: min(1080px, 100%);
    aspect-ratio: 16 / 10.4;
    margin-top: 8px;
    perspective: 2000px;
    perspective-origin: 50% 30%;
  }

  /* Pose: resting tilt plus the pointer (--rx/--ry). Intro: exploded, seen from above. */
  .hs-stack {
    --sx: 16deg;
    --sy: -14deg;
    --sz: 2deg;
    --sc: 1;
    --spread: 1;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateY(var(--ty, 0px)) rotateX(calc(var(--sx) + var(--rx, 0deg)))
      rotateY(calc(var(--sy) + var(--ry, 0deg))) rotateZ(var(--sz)) scale(var(--sc));
    transition: transform 1800ms var(--ease-pose);
  }

  :global([data-motion='intro']) .hs-stack {
    --sx: 52deg;
    --sy: 0deg;
    --sz: -28deg;
    --sc: 0.74;
    --spread: 1.9;
    --ty: 90px;
  }

  .hs-plane {
    position: absolute;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--z) * var(--spread) * 1px));
    transition: transform 1800ms var(--ease-pose);
    transition-delay: calc(var(--i) * 70ms);
  }

  :global([data-motion='intro']) .hs-plane {
    transition-delay: 0ms;
  }

  :global([data-motion-snap]) .hs-stack,
  :global([data-motion-snap]) .hs-plane,
  :global([data-motion-snap]) .hs-fig {
    transition: none !important;
  }

  /* Gentle float while the hero is live: each layer bobs on its own beat. */
  .hs-float {
    position: relative;
    transform-style: preserve-3d;
  }

  :global([data-motion='live']) .hs-float {
    animation: hs-float calc(5s + var(--i) * 0.7s) ease-in-out calc(var(--i) * -1.3s) infinite alternate;
  }

  :global([data-paused]) .hs-float {
    animation-play-state: paused;
  }

  @keyframes hs-float {
    from {
      transform: translate3d(0, -5px, 0);
    }
    to {
      transform: translate3d(0, 6px, 12px);
    }
  }

  .hs-card {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--glass-border-hover);
    background: var(--color-bg-inset);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 26px 60px -22px rgb(0 0 0 / 0.85),
      0 0 0 0 transparent;
    transition:
      box-shadow 600ms ease,
      transform 600ms cubic-bezier(0.2, 1.3, 0.3, 1);
  }

  :global(html[data-theme='light']) .hs-card {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 24px 50px -24px rgb(16 40 28 / 0.4);
  }

  /* Placement in the stage, as percentages of the stage box. */
  .hs-machine {
    left: 0;
    top: 34%;
    width: 46%;
  }

  .hs-machine .hs-card {
    filter: brightness(0.82);
  }

  :global(html[data-theme='light']) .hs-machine .hs-card {
    filter: none;
  }

  .hs-app {
    left: 15%;
    top: 3%;
    width: 70%;
  }

  .hs-app .hs-card {
    border-radius: 16px;
  }

  .hs-agent {
    left: 3%;
    top: 8%;
    width: 30%;
  }

  .hs-wf {
    right: 0;
    top: 46%;
    width: 33%;
  }

  .hs-review {
    right: 2%;
    top: 4%;
    width: 30%;
  }

  .hs-needs {
    left: 6%;
    bottom: 3%;
    width: 44%;
  }

  /* Labels show while the stack is exploded. */
  .hs-fig {
    position: absolute;
    left: 0;
    top: -28px;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    white-space: nowrap;
    color: var(--color-fg-primary);
    background: color-mix(in srgb, var(--color-bg-body) 80%, transparent);
    border: 1px solid var(--glass-border-hover);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  :global([data-motion='intro']) .hs-fig {
    opacity: 1;
  }

  /* Beats: one card at a time lights up (hero-motion.ts sets data-beat on the stage). */
  :global([data-beat='needs']) .hs-needs .hs-card {
    transform: translateZ(30px) scale(1.03);
    box-shadow:
      0 0 0 2px var(--fh-amber),
      0 0 46px -6px var(--fh-amber),
      0 30px 60px -20px rgb(0 0 0 / 0.8);
  }

  :global([data-beat='agent']) .hs-agent .hs-card,
  :global([data-beat='wf']) .hs-wf .hs-card,
  :global([data-beat='review']) .hs-review .hs-card {
    transform: translateZ(30px) scale(1.04);
    box-shadow:
      0 0 0 2px var(--fh-ring),
      0 0 46px -6px var(--fh-ring),
      0 30px 60px -20px rgb(0 0 0 / 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-stack,
    .hs-plane,
    .hs-card,
    .hs-fig {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .hs {
      aspect-ratio: 4 / 3.6;
      margin-top: 44px;
      perspective: 1300px;
    }

    :global([data-motion='intro']) .hs-stack {
      --spread: 1.4;
      --ty: 30px;
    }

    .hs-stack {
      --sx: 12deg;
      --sy: -8deg;
      --sz: 1deg;
    }

    .hs-app {
      left: 4%;
      top: 8%;
      width: 92%;
    }

    .hs-machine,
    .hs-agent {
      display: none;
    }

    .hs-wf {
      right: -2%;
      top: 52%;
      width: 46%;
    }

    .hs-review {
      right: 0;
      top: 4%;
      width: 52%;
    }

    .hs-needs {
      left: -2%;
      bottom: 0;
      width: 72%;
    }

    .hs-fig {
      font-size: 0.625rem;
    }
  }
</style>
