---
/**
 * Mobile hero: the same session on SAM's real mobile UI, streaming inside a phone, with a
 * comment thread floating beside it. The resting markup is the final frame.
 */
import StreamingWindow from './StreamingWindow.astro';
import { heroCrop, themedImage } from './layers';

const comment = heroCrop('comment');
---

<div class="hero-phone" aria-hidden="true">
  <div class="phone-floor"></div>
  <div class="phone">
    <StreamingWindow name="phone" class="phone-window" />
  </div>
  <div class="phone-chip sam-glass sam-glass-rim" data-hero-phone-chip>
    <div class="hero-img" style={themedImage(comment.files, comment)}></div>
  </div>
</div>

<style>
  /* Phone layers load only where the phone is shown. */
  @media (max-width: 699.98px) {
    .hero-phone :global(.hero-img) {
      background-image: var(--img-dark);
    }

    :global(html[data-theme='light']) .hero-phone :global(.hero-img) {
      background-image: var(--img-light);
    }
  }

  .hero-phone {
    position: relative;
    height: 600px;
    perspective: 1200px;
  }

  .phone {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 252px;
    margin-left: -116px;
    padding: 9px;
    border-radius: 38px;
    background: linear-gradient(160deg, #1d2d28, #0b1110 42%, #13201d);
    transform: rotateX(9deg) rotateY(-16deg) rotateZ(2deg);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 40px 70px -24px rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(0 0 0 / 0.7);
  }

  :global(html[data-theme='light']) .phone {
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 40px 70px -24px rgb(16 40 28 / 0.45),
      0 0 0 1px rgb(0 0 0 / 0.5);
  }

  .phone :global(.phone-window) {
    border-radius: 30px;
  }

  /* The phone's own light on the floor below it. */
  .phone-floor {
    position: absolute;
    left: 50%;
    bottom: 30px;
    width: 360px;
    height: 160px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(34 197 94 / 0.28), transparent 75%);
    filter: blur(10px);
  }

  :global(html[data-theme='light']) .phone-floor {
    opacity: 0.5;
  }

  .phone-chip {
    position: absolute;
    /* Overlaps the phone's left edge but never the screen's, down to 360px wide. */
    left: max(14px, calc(50% - 177px));
    top: 66px;
    width: 124px;
    border-radius: 12px;
    transform: rotateY(-8deg) translateZ(40px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .phone-chip > .hero-img {
    border-radius: 11px;
  }

  :global([data-motion='intro']) .phone-chip,
  .phone-chip.is-hidden {
    opacity: 0;
    transform: rotateY(-8deg) translateZ(40px) translateY(10px);
  }

  :global([data-motion-snap]) .phone-chip {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-chip {
      transition: none;
    }
  }
</style>
