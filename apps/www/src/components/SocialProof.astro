---
// Agents named as plain text chips (as the app shows agent profiles) rather than invented marks.
const agents = ['Claude Code', 'OpenAI Codex', 'Gemini CLI', 'Mistral Vibe', 'OpenCode', 'Amp'];
const facts = ['AGPL-3.0 Licensed', 'Self-Hosted', 'BYOC'];
---

<section class="social-proof" aria-labelledby="supports-label">
  <div class="container">
    <div class="dock-area animate-on-scroll">
      <span id="supports-label" class="proof-label">Supports</span>
      <div class="dock sam-glass sam-glass--chrome sam-glass-rim">
        <ul class="agents" aria-labelledby="supports-label">
          {agents.map((agent) => (
            <li class="agent"><span class="agent-dot" aria-hidden="true"></span>{agent}</li>
          ))}
        </ul>
        <span class="dock-sep" aria-hidden="true"></span>
        <ul class="facts" aria-label="Licensing and hosting">
          {facts.map((fact) => <li class="fact">{fact}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof {
    position: relative;
    padding: 24px 0 56px;
  }

  .dock-area {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 16px;
  }

  /* The dock sits in its own pool of light. */
  .dock-area::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -36px;
    z-index: -1;
    width: min(760px, 100%);
    height: 120px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(34 197 94 / 0.18), transparent 75%);
    filter: blur(8px);
    pointer-events: none;
  }

  :global(html[data-theme='light']) .dock-area::before {
    opacity: 0.6;
  }

  .proof-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }

  .dock {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    padding: 9px;
    border-radius: 20px;
  }

  .agents,
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 13px;
    font-size: 0.875rem;
    font-weight: 520;
    color: var(--color-fg-primary);
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 0 0 1px rgb(255 255 255 / 0.07);
  }

  :global(html[data-theme='light']) .agent {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.6));
    box-shadow:
      inset 0 1px 0 #fff,
      0 0 0 1px rgb(17 39 29 / 0.12);
  }

  .agent-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-strong);
    box-shadow: 0 0 8px rgb(34 197 94 / 0.7);
  }

  .dock-sep {
    width: 1px;
    height: 26px;
    margin: 0 4px;
    background: rgb(255 255 255 / 0.1);
  }

  :global(html[data-theme='light']) .dock-sep {
    background: rgb(17 39 29 / 0.14);
  }

  .fact {
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .dock {
      flex-direction: column;
      gap: 12px;
      padding: 12px;
    }

    .dock-sep {
      width: 60%;
      height: 1px;
      margin: 0;
    }
  }
</style>
