---
/** A real-UI screenshot in a bordered frame with a caption. Light/dark variants are picked by OptimizedFeatureImage. */
import OptimizedFeatureImage from './OptimizedFeatureImage.astro';

interface Props {
  src: string;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="shot-frame animate-on-scroll">
  <a href={src} class="shot-link" target="_blank" rel="noopener" aria-label={`Open full-size screenshot: ${caption}`}>
    <OptimizedFeatureImage src={src} alt={alt} />
  </a>
  <figcaption>{caption} <a href={src} target="_blank" rel="noopener" class="shot-full">Full size</a></figcaption>
</figure>

<style>
  .shot-frame {
    margin: 0;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-surface);
  }

  .shot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-link {
    display: block;
  }

  .shot-full {
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .shot-frame figcaption {
    padding: 12px 16px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
    border-top: 1px solid var(--glass-border);
  }
</style>
