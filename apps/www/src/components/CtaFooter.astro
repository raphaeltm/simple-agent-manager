---
const getStartedUrl = 'https://www.simple-agent-manager.org/self-host/';
import Footer from "../../../../packages/ui/src/brand/Footer.astro";
---

<section class="cta-section">
  <div class="container">
    <div class="cta-content sam-glass sam-glass-rim animate-on-scroll">
      <h2 class="cta-title">Get your coding agents off your laptop</h2>
      <p class="cta-subtitle">
        SAM is open source. Deploy it to your Cloudflare account and connect your agent. Add a cloud provider when you want full environments on your own servers.
      </p>
      <div class="cta-actions">
        <a href={getStartedUrl} class="sam-btn sam-btn--primary">
          Deploy SAM
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="https://github.com/raphaeltm/simple-agent-manager" class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<Footer />

<style>
  .cta-section {
    padding: 80px 0;
  }

  @media (min-width: 768px) {
    .cta-section {
      padding: 120px 0;
    }
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 32px;
    border-radius: var(--radius-xl);
    text-align: center;
  }

  /* A pool of light under the card, like the dock and the feature frames. */
  .cta-section .container {
    position: relative;
  }

  .cta-section .container::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -48px;
    width: min(680px, 90%);
    height: 140px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(34 197 94 / 0.2), transparent 75%);
    filter: blur(10px);
    pointer-events: none;
  }

  :global(html[data-theme='light']) .cta-section .container::before {
    opacity: 0.55;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--color-fg-primary);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .cta-subtitle {
    font-size: 1.0625rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

</style>
