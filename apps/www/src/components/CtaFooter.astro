---
const getStartedUrl = 'https://www.simple-agent-manager.org/self-host/';
const currentYear = new Date().getFullYear();
---

<section class="cta-section">
  <div class="container">
    <div class="cta-content sam-glass sam-glass-rim animate-on-scroll">
      <h2 class="cta-title">Put your coding agents to work in parallel</h2>
      <p class="cta-subtitle">
        SAM is open source. You deploy it to your own Cloudflare account (a Workers Paid plan and a domain on Cloudflare), then connect a cloud provider and the agent you already use.
      </p>
      <div class="cta-actions">
        <a href={getStartedUrl} class="sam-btn sam-btn--primary">
          Self-Host SAM
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="https://github.com/raphaeltm/simple-agent-manager" class="sam-btn sam-btn--glass" target="_blank" rel="noopener noreferrer">
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/images/sam-head.png" width="24" height="24" alt="" aria-hidden="true" style="border-radius: 4px;" />
      <span>Simple Agent Manager</span>
    </div>

    <div class="footer-links">
      <a href="/features/">Features</a>
      <a href="/blog/">Blog</a>
      <a href="/integrations/">Integrations</a>
      <a href="https://github.com/raphaeltm/simple-agent-manager" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://bsky.app/profile/simple-agent-manager.org" target="_blank" rel="noopener noreferrer">Bluesky</a>
      <a href="https://x.com/simpleagentman" target="_blank" rel="noopener noreferrer">X</a>
      <a href="/docs/guides/self-hosting/">Self-Hosting Guide</a>
      <a href="/docs/reference/contributing/">Contributing</a>
      <a href="https://github.com/raphaeltm/simple-agent-manager/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">AGPL-3.0 License</a>
    </div>

    <p class="footer-copy">&copy; {currentYear} Simple Agent Manager. Open source under AGPL-3.0.</p>
  </div>
</footer>

<style>
  .cta-section {
    padding: 80px 0;
  }

  @media (min-width: 768px) {
    .cta-section {
      padding: 120px 0;
    }
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 32px;
    border-radius: var(--radius-xl);
    text-align: center;
  }

  /* A pool of light under the card, like the dock and the feature frames. */
  .cta-section .container {
    position: relative;
  }

  .cta-section .container::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -48px;
    width: min(680px, 90%);
    height: 140px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(34 197 94 / 0.2), transparent 75%);
    filter: blur(10px);
    pointer-events: none;
  }

  :global(html[data-theme='light']) .cta-section .container::before {
    opacity: 0.55;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--color-fg-primary);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .cta-subtitle {
    font-size: 1.0625rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: 40px 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .footer-links a {
    font-size: 0.8125rem;
    color: var(--color-fg-dim);
  }

  .footer-links a:hover {
    color: var(--color-fg-muted);
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-fg-dim);
  }
</style>
