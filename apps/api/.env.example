# Interactive HTML previews
# PREVIEW_BASE_DOMAIN=preview.example.com
# PREVIEW_URL_TTL_SECONDS=300
# PREVIEW_SIGNING_KEY= # Pulumi-managed Worker secret in deployed environments

# Local development configuration

# Wrangler port (default: 8787)
WRANGLER_PORT=8787

# Deployment script tuning (GitHub Actions / local deploy helpers; not Worker runtime)
# WORKER_SECRET_BULK_MAX_OPS=100  # Max queued wrangler secret bulk operations (1-100)

# Base domain used for app/api/ws-vhost URL construction
BASE_DOMAIN=workspaces.example.com
# Generated deployments inject a stable 32-character hex identity automatically.
# Leave unset for local development; destructive provider orphan reconciliation then fails closed.
# SAM_INSTALLATION_ID=0123456789abcdef0123456789abcdef

# Local development secrets (optional, for testing auth)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Optional GitLab OAuth fallback (runtime setup/admin config takes precedence)
# GITLAB_HOST=https://gitlab.com
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_API_TIMEOUT_MS=30000  # Timeout for GitLab API calls (default: 30000)

# Cloudflare credentials (for DNS, Origin CA certificate issuance, and optional managed registry cache)
# Requires Account → SSL and Certificates → Edit for per-node Origin CA certificates.
# CF_API_TOKEN=
# CF_AIG_TOKEN=
# CF_ACCOUNT_ID=
# CF_ZONE_ID=

# Optional narrower credentials for Cloudflare managed devcontainer cache
# DEVCONTAINER_CACHE_CLOUDFLARE_API_TOKEN=
# DEVCONTAINER_CACHE_CLOUDFLARE_ACCOUNT_ID=
# DEVCONTAINER_CACHE_REGISTRY_HOST=registry.cloudflare.com
# DEVCONTAINER_CACHE_REPOSITORY_PREFIX=sam-
# DEVCONTAINER_CACHE_CREDENTIAL_EXPIRATION_MINUTES=120

# Deployment image tag resolution safety limits (optional; defaults shown)
# DEPLOYMENT_IMAGE_RESOLVE_REQUEST_TIMEOUT_MS=10000
# DEPLOYMENT_IMAGE_RESOLVE_TOTAL_TIMEOUT_MS=60000
# DEPLOYMENT_IMAGE_RESOLVE_MAX_FETCH_ATTEMPTS=200
# DEPLOYMENT_IMAGE_RESOLVE_MAX_REDIRECTS=2
# DEPLOYMENT_IMAGE_RESOLVE_TOKEN_RESPONSE_MAX_BYTES=65536
# DEPLOYMENT_IMAGE_RESOLVE_MAX_CONCURRENT_FETCHES=4
# DEPLOYMENT_IMAGE_RESOLVE_MAX_SERVICES=50

# Security keys (optional locally; production deploys auto-generate them with Pulumi)
# ENCRYPTION_KEY=       # Shared fallback key — used when purpose-specific keys below are not set
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# DEPLOY_SIGNING_PRIVATE_KEY=   # Base64 Ed25519 private key for signed deployment apply payloads
# DEPLOY_SIGNING_PUBLIC_KEY=    # Base64 Ed25519 public key delivered to deployment nodes
# VAPID_PRIVATE_KEY=            # Base64url P-256 private scalar for Web Push
# VAPID_PUBLIC_KEY=             # Base64url uncompressed P-256 public key
# VAPID_SUBJECT=https://app.example.com # RFC 8292 mailto or HTTPS contact URI

# Purpose-specific secret overrides (recommended for production)
# When set, these take precedence over ENCRYPTION_KEY for their respective domain.
# When unset, ENCRYPTION_KEY is used as a backwards-compatible fallback.
# BETTER_AUTH_SECRET=            # BetterAuth session management (cookie signing/encryption)
# CREDENTIAL_ENCRYPTION_KEY=    # AES-GCM encryption of user cloud credentials (Hetzner tokens, etc.)
# GITHUB_WEBHOOK_SECRET=        # GitHub webhook HMAC-SHA256 signature verification

# Generic webhook triggers (optional; defaults shown)
# WEBHOOK_TRIGGERS_ENABLED=true
# WEBHOOK_TRIGGER_MAX_BODY_BYTES=65536
# WEBHOOK_TRIGGER_MAX_FILTERS=10
# WEBHOOK_TRIGGER_MAX_FILTER_PATH_LENGTH=200
# WEBHOOK_TRIGGER_MAX_FILTER_PATH_DEPTH=8
# WEBHOOK_TRIGGER_MAX_INCLUDED_HEADERS=10
# WEBHOOK_TRIGGER_MAX_HEADER_NAME_LENGTH=100
# WEBHOOK_TRIGGER_MAX_SOURCE_LABEL_LENGTH=100
# WEBHOOK_TRIGGER_MAX_IDEMPOTENCY_KEY_LENGTH=200
# WEBHOOK_INGRESS_RATE_LIMIT_PER_MINUTE=120
# WEBHOOK_TRIGGER_RATE_LIMIT_PER_MINUTE=60
# WEBHOOK_INVALID_TOKEN_RATE_LIMIT_PER_MINUTE=30
# WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# WEBHOOK_DELIVERY_RETENTION_DAYS=7
# WEBHOOK_DELIVERY_CLEANUP_BATCH_SIZE=500
# WEBHOOK_DELIVERY_DEFAULT_PAGE_SIZE=25
# WEBHOOK_DELIVERY_MAX_PAGE_SIZE=100
# WEBHOOK_DELIVERY_PROCESSING_LEASE_SECONDS=300

# Guided agent credential setup via Cloudflare Sandbox
# MAX_CONCURRENT_SETUP_SESSIONS=2
# SETUP_SESSION_TTL_MS=900000
# SETUP_SESSION_CAPTURE_POLL_MS=3000
# CODEX_DEVICE_AUTH_REQUEST_TIMEOUT_MS=30000
# Claude Code v2.1.220 treats a large pasted code plus inline carriage return as
# text; keep Enter as a separate write after this settle delay.
# CLAUDE_SETUP_ENTER_DELAY_MS=1000
# CLAUDE_SETUP_EXCHANGE_TIMEOUT_MS=120000
# Wait for Ink redraw output to settle before classifying a mangled OAuth error.
# CLAUDE_SETUP_REJECTION_SETTLE_MS=400
# CLAUDE_SETUP_VERIFICATION_POLL_MS=500
# CLAUDE_SETUP_TTY_COLUMNS=512
# CLAUDE_SETUP_OUTPUT_BUFFER_BYTES=32768
# CLAUDE_VERIFICATION_CODE_MAX_LENGTH=1024
# CLAUDE_SETUP_ERROR_DETAIL_MAX_LENGTH=160
# CLAUDE_OAUTH_TOKEN_MAX_LENGTH=8192
# SETUP_SESSION_SWEEP_MAX_CANDIDATES=50
# POOL_LEASE_BUFFER_MS=300000

# NOTE: Hetzner tokens are NOT platform secrets.
# Users provide their own Hetzner API tokens through the Settings UI.
# These are stored encrypted (per-user) in the database.

# Cloudflare Container instant sessions
# Generated deployment environments default this to true. Set false to force
# profile/runtime resolution back to cloud VMs.
# CF_CONTAINER_ENABLED=true
# CF_CONTAINER_SLEEP_AFTER=1h
# Maximum active-work keepalive lifetime and renewal interval.
# CF_CONTAINER_ACTIVE_WORK_MAX_MS=7200000
# CF_CONTAINER_KEEPALIVE_RENEW_INTERVAL_MS=300000
# CF_CONTAINER_VM_AGENT_PORT=8080
# CF_CONTAINER_PORT_READY_TIMEOUT_MS=30000
# Budget for a sleeping/recovering runtime to launch, restore, and accept work.
# CF_CONTAINER_WAKE_TIMEOUT_MS=120000
# Maximum snapshot restore attempts before terminal status reconciliation.
# CF_CONTAINER_RECOVERY_MAX_ATTEMPTS=2
# Freshness margin for rejecting destructive (error/failed) callbacks from a
# superseded Instant container generation after a completed recovery.
# INSTANT_STALE_CALLBACK_MARGIN_MS=60000
# CF_CONTAINER_WORKSPACE_BASE_DIR=/workspaces
# Budget for the synchronous standalone create-workspace request (includes the
# repository clone inside the container). Default 120000 (120s).
# CF_CONTAINER_CREATE_WORKSPACE_TIMEOUT_MS=120000
# Git partial-clone filter forwarded to the container as STANDALONE_CLONE_FILTER.
# The vm-agent defaults to blob:none; set "off" to force full clones.
# CF_CONTAINER_CLONE_FILTER=blob:none
# SESSION_SNAPSHOT_TTL_DAYS=7
# SESSION_SNAPSHOT_TOTAL_BUDGET_BYTES=268435456
# SESSION_SNAPSHOT_ENTRY_THRESHOLD_BYTES=268435456
# SESSION_SNAPSHOT_TRANSFER_IDLE_TIMEOUT_MS=30000
# SESSION_SNAPSHOT_UPLOAD_URL_TTL_SECONDS=900
# SESSION_SNAPSHOT_REQUEST_TIMEOUT_MS=300000
# SESSION_SNAPSHOT_PROGRESS_IDLE_TIMEOUT_MS=120000
# SESSION_SNAPSHOT_POLL_INTERVAL_MS=1000
# SESSION_SNAPSHOT_OPERATION_TIMEOUT=15m
# SESSION_SNAPSHOT_PROGRESS_REPORT_INTERVAL=15s
# SESSION_SNAPSHOT_PROGRESS_REPORT_TIMEOUT=5s
# SESSION_SNAPSHOT_JSON_BODY_MAX_BYTES=262144
# SESSION_SNAPSHOT_R2_PREFIX=session-snapshots
# SESSION_SNAPSHOT_RECOVERY_MAX_ATTEMPTS=3
# SESSION_SLEEP_AFTER_MS=900000
# SESSION_SLEEP_SWEEP_BATCH_SIZE=10
# SESSION_SLEEP_SWEEP_WALL_BUDGET_MS=20000
# SESSION_SLEEP_RETRY_DELAY_MS=300000
# SESSION_SLEEP_MAX_ATTEMPTS=9
# SESSION_SLEEP_CLAIM_LEASE_MS=600000
# HARNESS_BACKGROUND_WORK_LEASE_MS=300000
# Absolute ceiling (from the last harness lifecycle PROGRESS edge) on how long
# background work may defer sleep. Bounds an abandoned background process, whose
# heartbeats would otherwise renew the sliding lease above forever.
# HARNESS_BACKGROUND_WORK_MAX_DURATION_MS=1800000
# SESSION_SNAPSHOT_RECOVERY_CLAIM_LEASE_MS=600000
# SESSION_LIFECYCLE_ERROR_MAX_LENGTH=2048
# SESSION_SNAPSHOT_PURGE_ENABLED=true
# SESSION_SNAPSHOT_PURGE_BATCH_SIZE=250
# LIBRARY_PROJECT_DELETE_CLEANUP_BATCH_SIZE=1000

# User approval / invite-only mode
# When "true", new users require admin approval before accessing the platform.
# The first user to register automatically becomes superadmin.
# REQUIRE_APPROVAL=true

# API tokens
# Tokens are generated per-user from the Settings UI and can authenticate the CLI.
# API_TOKEN_BYTES=32
# MAX_API_TOKENS_PER_USER=10
# MAX_API_TOKEN_NAME_LENGTH=100
# API_TOKEN_SESSION_DURATION_SECONDS=604800

# OAuth device flow for CLI login
# DEVICE_FLOW_CODE_TTL_SECONDS=900
# DEVICE_FLOW_POLL_INTERVAL_SECONDS=5
# RATE_LIMIT_DEVICE_CODE_CREATE=20
# RATE_LIMIT_DEVICE_POLL=360

# ========================================
# Platform Config Resolution
# ========================================
# Per-isolate cache TTL for the resolved platform integration config (OAuth client ids/secrets,
# GitHub App credentials). Resolving costs 13 D1 queries and runs on the auth preamble of every
# authenticated request. Set to 0 to disable caching and always re-read D1.
# PLATFORM_CONFIG_CACHE_MS=60000

