# Multi-Terminal UI Configuration

# Maximum number of concurrent terminal sessions (default: 10)
VITE_MAX_TERMINAL_SESSIONS=10

# Tab switch animation duration in milliseconds (default: 200)
VITE_TAB_SWITCH_ANIMATION_MS=200

# Terminal scrollback buffer size in lines (default: 1000)
VITE_TERMINAL_SCROLLBACK_LINES=1000

# Feature flag for multi-terminal UI (default: false)
# Set to true to enable multi-terminal tabs
VITE_FEATURE_MULTI_TERMINAL=false

# Base domain for the application (set to your domain when self-hosting)
VITE_BASE_DOMAIN=example.com

# API URL (if different from default)
VITE_API_URL=

# WebSocket protocol (ws or wss)
VITE_WS_PROTOCOL=wss

# Public website URL for the "Learn more" link on the sign-in page
# Defaults to https://simple-agent-manager.org — set this to your own marketing
# site URL when self-hosting, or leave empty to use the default
VITE_PUBLIC_WEBSITE_URL=

# Debug mode
VITE_DEBUG=false

# Command palette search limits
# Maximum number of projects fetched for the command palette (default: 50)
VITE_CMD_PALETTE_PROJECT_FETCH_LIMIT=50

# Maximum number of chat sessions fetched per project for the command palette (default: 20)
VITE_CMD_PALETTE_CHAT_FETCH_LIMIT=20

# Maximum number of results shown per category in the command palette (default: 10)
VITE_CMD_PALETTE_MAX_RESULTS_PER_CATEGORY=10

# Project query cache, refresh, and intent-prefetch behavior
# Maximum number of projects loaded into shared list caches (default: 50)
# VITE_PROJECT_LIST_LIMIT=50
# Background refresh cadence for project-list pages; 0 disables polling (default: 30s)
# VITE_PROJECT_POLL_INTERVAL_MS=30000
# Background refresh cadence for the app-shell project list; 0 disables polling (default: 60s)
# VITE_SIDEBAR_PROJECT_POLL_INTERVAL_MS=60000
# Mouse-hover dwell before project detail prefetch; focus/touch stay immediate (default: 120ms)
# VITE_PROJECT_PREFETCH_DELAY_MS=120
# Delay before background query activity is shown and announced (default: 150ms)
# VITE_BACKGROUND_FETCH_DELAY_MS=150

# Code-splitting / lazy route chunk recovery
# Wait before retrying a lazy route-chunk import that failed to fetch (default: 350ms)
# VITE_CHUNK_LOAD_RETRY_DELAY_MS=350
# Minimum gap between chunk-recovery page reloads; guards against a reload loop when a
# chunk is genuinely gone after a redeploy (default: 15s)
# VITE_CHUNK_RELOAD_COOLDOWN_MS=15000
# Delay before the route loading spinner fades in, so a fast chunk load shows no flash
# (default: 180ms)
# VITE_ROUTE_FALLBACK_REVEAL_DELAY_MS=180

# Query-cache persistence (IndexedDB)
# An allowlisted slice of the TanStack Query cache is written to IndexedDB so a full
# page reload paints from cache instead of refetching. Records are namespaced by
# authenticated user and deleted on sign-out and account switch.
# How long a persisted record may be restored after it was written (default: 24h)
# VITE_QUERY_PERSIST_MAX_AGE_MS=86400000
# Minimum gap between IndexedDB writes (default: 1s)
# VITE_QUERY_PERSIST_THROTTLE_MS=1000
# Budget for the initial restore before failing open to an empty cache. Kept tight because
# rendering is gated on it and it can only add to first paint (default: 250ms)
# VITE_QUERY_PERSIST_RESTORE_TIMEOUT_MS=250

# Maximum event pages fetched for one durable diagnosis timeline (default: 100)
# VITE_DEBUG_DIAGNOSIS_EVENT_MAX_PAGES=100

# File preview size thresholds (image rendering in file browser and chat)
# VITE_FILE_PREVIEW_INLINE_MAX_BYTES=10485760   # Inline render threshold (default: 10MB)
# VITE_FILE_PREVIEW_LOAD_MAX_BYTES=52428800     # Click-to-load threshold; above this is download-only (default: 50MB)

# Analytics geo map TopoJSON URL — override for CSP-strict or air-gapped deployments
# VITE_GEO_TOPOJSON_URL=https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json

# Prompt template for executing an idea (use {ideaId} as placeholder)
# VITE_EXECUTE_IDEA_PROMPT_TEMPLATE=Read idea {ideaId} using the get_idea tool for full context, then execute it using the /do skill.

# WebSocket heartbeat timing — must match server-side ACP_PING_INTERVAL / ACP_PONG_TIMEOUT on the VM agent
# VITE_WS_PING_INTERVAL_MS=30000   # Interval between JSON ping messages (default: 30s)
# VITE_WS_PONG_TIMEOUT_MS=10000    # Deadline for pong response before force-close (default: 10s)

# ACP recovery — auto-recover when agent connection gives up while session is active
# VITE_ACP_RECOVERY_DELAY_MS=5000       # Initial delay before first recovery attempt (default: 5s)
# VITE_ACP_RECOVERY_INTERVAL_MS=30000   # Interval between subsequent recovery retries (default: 30s)
# VITE_ACP_RECOVERY_MAX_ATTEMPTS=10     # Max recovery attempts before giving up (default: 10)

# Connection banner debounce — suppress "Reconnecting..." for brief WebSocket blips
# VITE_RECONNECT_BANNER_DELAY_MS=3000   # Delay before showing reconnecting banner (default: 3s)

# Library client-side search index — sub-cap projects sweep the full file list into the
# browser for instant ranked search; over-cap projects fall back to the server search path.
# VITE_LIBRARY_CLIENT_SWEEP_CAP=300            # Max files before falling back to server search (default: 300)
# VITE_LIBRARY_CLIENT_MAX_SWEEP_PAGES=10       # Runaway guard on sweep pagination (default: 10)
# VITE_LIBRARY_INDEX_MAX_CACHE_CHARS=2097152   # Max localStorage chars for a cached index (default: ~2M)
# VITE_LIBRARY_CACHE_TTL_MS=300000             # Client cache TTL in ms (default: 5m)
# VITE_LIBRARY_CACHE_MAX_EVICTIONS=5           # Max LRU evictions on a quota error (default: 5)
# VITE_LIBRARY_SEARCH_DEBOUNCE_MS=300          # Debounce for the screen-reader search announcement (default: 300ms)

# Chat timeline drawer — runaway guards on the pagination it runs when opened.
# Both loops previously paged to exhaustion with no cap, so a server that kept
# reporting hasMore/nextCursor would spin forever.
# VITE_CHAT_TIMELINE_MAX_PAGES=200             # Max pages fetched per loop when the drawer opens (default: 200)
# VITE_CHAT_LOAD_UNTIL_MAX_PAGES=400           # Max older pages chased while resolving a timeline jump (default: 400)
