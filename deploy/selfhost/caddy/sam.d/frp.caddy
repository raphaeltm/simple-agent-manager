# Reverse-tunnel transport: nodes' frpc dial wss://api.{SAM_DOMAIN}/~!frp (frp's fixed
# WebSocket path). Caddy terminates TLS with the box's public certificate (frpc verifies it,
# useSystemCa) and hands the socket to frps on loopback.
@sam_frp {
	host api.{$SAM_DOMAIN}
	path /~!frp
}
handle @sam_frp {
	reverse_proxy 127.0.0.1:{$FRPS_BIND_PORT:7000} {
		import sam_client_ip
	}
}

# Internal gateway endpoints (frps plugin, forward_auth) are reached by frps and Caddy on
# loopback only, straight to celld. They are never served on the public listener, on any host.
@sam_gateway_internal path /api/self-host/gateway /api/self-host/gateway/*
handle @sam_gateway_internal {
	respond "Not found" 404
}

# Any other spelling of the internal namespace on a non-workspace host: case, encoded or doubled
# separators, dot segments, path parameters, NULs. Matched on the decoded path and on the raw
# request path (before the query), so neither Caddy's nor celld's normalization can turn an
# unmatched form into the gateway route. No public SAM route contains "self-host". Workspace
# hosts (ws-*) are exempt: the Worker sends every ws-* request to the workspace proxy before any
# route, and a preview app may legitimately serve such paths.
@sam_gateway_internal_variant expression `!{host}.matches("(?i)^ws-[a-z0-9]+(--[0-9]+)?[.]") && ({path}.matches("(?i)self-host") || {http.request.uri}.matches("(?i)^[^?]*self(-|%2d|%252d)host"))`
handle @sam_gateway_internal_variant {
	respond "Not found" 404
}
