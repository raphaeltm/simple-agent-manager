# Copy to .env, then `chmod 600 .env`: the bucket credential below controls the whole install
# (celld keeps Worker secrets in plaintext in the bucket's deploy manifests).

# Base domain. Point a wildcard DNS record *.SAM_DOMAIN at this box. SAM serves api., app.,
# ws-<id>. and ws-<id>--<port>. under it; the apex is not used.
SAM_DOMAIN=sam.example.com

# TLS: `internal` (Caddy's local CA, local proofs only) or `dns-googleclouddns` (Let's Encrypt
# wildcard via DNS-01; needs GCP_PROJECT, and the VM's service account must be able to edit the
# Cloud DNS zone). Other providers: add caddy/tls/dns-<provider>.caddy and set CADDY_DNS_MODULE.
# ACME_EMAIL is optional (empty registers an account with no contact address). Set ACME_CA to
# https://acme-staging-v02.api.letsencrypt.org/directory for a first trial issuance, then unset
# it (Let's Encrypt production) and restart caddy.
SAM_TLS_MODE=internal
ACME_EMAIL=
# ACME_CA=
GCP_PROJECT=
# CADDY_DNS_MODULE=github.com/caddy-dns/googleclouddns@v1.1.0

# Optional services: `tunnel` runs frps for nodes; `local-store` runs the bundled object store;
# `gce` runs the metadata token proxy a gs:// bucket needs (the egress fence blocks the metadata
# server itself). `pnpm selfhost:deploy` refuses a gs:// bucket without `gce`.
COMPOSE_PROFILES=tunnel,gce

# Fleet bucket. Google Cloud Storage via Application Default Credentials (on GCE, the VM's
# service account needs roles/storage.objectAdmin on the bucket):
CELLD_BUCKET=gs://my-sam-bucket/celld
# Or the bundled store (add local-store to COMPOSE_PROFILES):
# CELLD_BUCKET=s3://celld-fleet
# S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=sam-objectstore
# AWS_SECRET_ACCESS_KEY=   # openssl rand -hex 24

# Loopback ports (host network). Change only on conflict.
# CELLD_PORT=8080
# CELLD_INTERNAL_PORT=7001
# FRPS_BIND_PORT=7000
# OBJECTSTORE_PORT=9000
# OBJECTSTORE_CONSOLE_PORT=9001
# HTTP_PORT=80
# HTTPS_PORT=443

# Presigned browser uploads (attachments, snapshots) go straight to the fleet bucket. Set the
# store's public HTTPS endpoint here and a credential scoped to <bucket>/<prefix>/r2/<R2 bucket>/*
# as R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in .state/secrets.env (never the fleet credential).
# The deploy derives the bucket and key prefix. Unset: presigned uploads stay off.
# R2_S3_ENDPOINT=https://storage.googleapis.com
# R2_S3_REGION=auto

# Email sign-in (README, Email sign-in). Either an SMTP relay (SMTP_PASSWORD goes in
# .state/secrets.env):
# SMTP_HOST=smtp.example.com
# SMTP_TLS=starttls
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_FROM=sign-in@sam.example.com
# or, on a TEST install only, add `mail-collector` to COMPOSE_PROFILES: Mailpit catches every
# sign-in email for https://mail.SAM_DOMAIN, and anyone who can read it can sign in as any
# account. Its loopback ports and UI host label:
# MAIL_COLLECTOR_SMTP_PORT=1025
# MAIL_COLLECTOR_UI_PORT=8025
# MAIL_COLLECTOR_HOST_LABEL=mail

# Inbound agent email (README, Inbound agent email): add `mail-in` to COMPOSE_PROFILES (needs
# SMTP_HOST or the mail collector for replies), an MX record agents.SAM_DOMAIN -> mx.SAM_DOMAIN
# and inbound tcp/25. Optional limits and settings:
# SAM_MX_MAX_MESSAGE_BYTES=5242880
# SAM_MX_MAX_CONNECTIONS=20
# SAM_MX_MAX_CONNECTIONS_PER_IP=3
# SAM_MX_MAX_SESSION=15m
# SAM_MX_CONNECTIONS_PER_IP_PER_MINUTE=30
# SAM_MX_MESSAGES_PER_CONNECTION=10
# Smoke tests from the box only (skips SPF/DKIM/DMARC for these loopback networks):
# SAM_MX_TRUSTED_NETWORKS=127.0.0.1/32

# Loopback ports frps may bind for node tunnels (default 20000-29999, at most 20000 ports). The
# deploy script writes the resolved range to both the Worker and .state/gateway.env, so change
# it here only. The deploy fails if the range contains any port above or a size over the cap.
# REVERSE_TUNNEL_PORT_RANGE_START=20000
# REVERSE_TUNNEL_PORT_RANGE_END=29999
# frps drops a node that has not heartbeated for this many seconds (60-3600, default 90); the
# Worker gets the same value and never reissues a released port before twice this age.
# REVERSE_TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=90
# Optional: a longer minimum age before a released port is reissued (default and floor 2 x the
# heartbeat timeout).
# REVERSE_TUNNEL_PORT_REUSE_MIN_AGE_SECONDS=180

# Egress fence (see README). celld runs as this uid and the fence matches its sockets. Pick an
# unused uid if 7101 is taken on the host.
# CELLD_UID=7101
# GCE metadata token proxy: on for a gs:// bucket. Set off when celld gets Google credentials
# another way (then also drop `gce` from COMPOSE_PROFILES).
# GCE_METADATA_PROXY=off
# GCE_METADATA_PROXY_PORT=7180
# The scope the proxy requests (Cloud Storage scopes only; comma-separated). GCE ignores it and
# returns the VM's own scopes, so grant the VM's service account the fleet bucket only (README).
# GCE_METADATA_PROXY_SCOPES=https://www.googleapis.com/auth/devstorage.read_write
# Extra addresses celld may reach on this box or the private network, as IP:PORT pairs
# (IPv6 in brackets), comma-separated. Needed for a local model server used with the admin
# setting llm.openAICompatible.allowPrivateNetwork, e.g. SAM_EGRESS_ALLOW=127.0.0.1:11434
# SAM_EGRESS_ALLOW=
# How often the fence service re-checks and re-applies the table (seconds).
# SAM_EGRESS_FENCE_RECHECK_SECONDS=5
# How often celld's entrypoint probes the fence, and the oldest fence-service attestation it
# accepts, before it kills celld (seconds; see README "Worst-case unfenced window").
# SAM_EGRESS_FENCE_CHECK_SECONDS=1
# SAM_EGRESS_FENCE_ATTESTATION_MAX_AGE_SECONDS=20

# Where `pnpm selfhost:deploy` keeps platform keys, gateway.env and the celld project.
# SAM_SELFHOST_STATE_DIR=./.state

# Keep-warm (README "Cold starts"): Caddy pings celld's /health so a retired Worker isolate is
# restarted by the ping, not by a user's request. off turns it off; the interval must be 1s-6s.
# SAM_KEEP_WARM=on
# SAM_KEEP_WARM_INTERVAL=5s
# Caddy's access log is capped at about CADDY_LOG_MAX_SIZE x CADDY_LOG_MAX_FILES on disk.
# CADDY_LOG_MAX_SIZE=50m
# CADDY_LOG_MAX_FILES=5

# celld tuning (defaults shown).
# CELLD_LTX_RETENTION_SECS=86400
# CELLD_FETCH_TIMEOUT_S=3600

# Guided credential login (README "Guided credential login"): off by default. Needs Docker, the
# runtime registered with it, and the compose override. celld never gets the Docker socket: it
# talks to the docker-proxy service, whose policy `pnpm selfhost:deploy` writes.
# SAM_GUIDED_LOGIN=on
# SAM_GUIDED_LOGIN_RUNTIME=runsc
# SAM_GUIDED_LOGIN_INSTANCE_TYPE=basic
# DOCKER_SOCKET_GID=
# docker-proxy: its uid (must differ from CELLD_UID and SAM_MX_UID; the deploy checks), and the age past which a sign-in sandbox is removed (seconds).
# SAM_DOCKER_PROXY_UID=7103
# SAM_DOCKER_PROXY_MAX_SANDBOX_AGE_SECONDS=1800
# Most celld containers at once (sandboxes and fence runs; each sandbox may use 1 GiB with basic).
# SAM_DOCKER_PROXY_MAX_CONTAINERS=4
# COMPOSE_FILE=docker-compose.yml:docker-compose.guided-login.yml

# Sealed secrets (README, Sealed secrets): ON BY DEFAULT. Leave SAM_KEY_PROVIDER unset and
# `pnpm selfhost:deploy --init` picks the key provider itself (cloud KMS through this VM's own
# identity when a key is set up for it, otherwise a key file on this box) and records why in
# .state/key-agent/choice.json (`pnpm selfhost:secrets status`). Set it only to override:
# SAM_KEY_PROVIDER=file            # or transit | gcp-kms | azure-kv
# SAM_KEY_PROVIDER=legacy-plaintext  # LEGACY: every Worker secret stored in plaintext in the bucket
# SAM_KEY_AGENT_UID=0              # optional: pin the agent's uid (`id -u` of the .state owner)
# SAM_TRANSIT_ADDR=https://vault.example.com:8200
# SAM_TRANSIT_KEY=sam-box
# SAM_TRANSIT_ROLE_ID=...          # secret id in .state/key-agent/credentials/transit-secret-id
# SAM_GCP_KMS_KEY=projects/P/locations/L/keyRings/R/cryptoKeys/K
# SAM_GCP_KMS_LOCATION=global      # location of the bootstrap-created key ring (automatic choice)
# SAM_AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net   # Azure: the vault (key name defaults to sam-<hash>)
# SAM_METADATA_PROBE_TIMEOUT_MS=1500  # how long --init waits for each cloud metadata service
