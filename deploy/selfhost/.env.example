# EXPERIMENTAL single-box install for the SAM team's test box (README.md). Not a supported
# deployment option.
#
# Copy to .env, then `chmod 600 .env`: the bucket credential below controls the whole install.
# Worker secrets are sealed (README, Sealed secrets): the bucket holds no secret value unless
# SAM_KEY_PROVIDER=legacy-plaintext.

# Base domain. Point a wildcard DNS record *.SAM_DOMAIN at this box. SAM serves api., app.,
# ws-<id>. and ws-<id>--<port>. under it; the apex is not used.
SAM_DOMAIN=sam.example.com

# TLS: `internal` (Caddy's local CA, local proofs only), `dns-rfc2136` (Let's Encrypt wildcard via
# DNS-01 against the box's own DNS server: needs the `dns` profile below and
# CADDY_DNS_MODULE=github.com/caddy-dns/rfc2136@v1.0.0) or `dns-googleclouddns` (via Cloud DNS;
# needs GCP_PROJECT, and the VM's service account must be able to edit the Cloud DNS zone).
# Other providers: add caddy/tls/dns-<provider>.caddy and set CADDY_DNS_MODULE.
# ACME_EMAIL is optional (empty registers an account with no contact address). Set ACME_CA to
# https://acme-staging-v02.api.letsencrypt.org/directory for a first trial issuance, then unset
# it (Let's Encrypt production) and restart caddy.
SAM_TLS_MODE=internal
ACME_EMAIL=
# ACME_CA=
GCP_PROJECT=
# CADDY_DNS_MODULE=github.com/caddy-dns/googleclouddns@v1.1.0

# Optional services: `tunnel` runs frps for nodes; `local-store` runs the bundled object store
# (trials only); `mail-collector` and `mail-in` are described below.
COMPOSE_PROFILES=tunnel,gce
# Required before running Compose: run `pnpm selfhost:deploy --init`, then copy the
# installation-specific project name it prints here. Never share it with another installation.
# COMPOSE_PROJECT_NAME=sam-selfhost-<printed suffix>
# Also printed by `--init`: the uid that owns .state (`id -u`). The key-agent container runs as it,
# never as root; every sealing deploy refuses a missing or different value.
# SAM_KEY_AGENT_UID=1000

# Fleet bucket. Google Cloud Storage via Application Default Credentials (on GCE, the VM's
# service account needs roles/storage.objectAdmin on the bucket):
CELLD_BUCKET=gs://my-sam-bucket/celld
# Or, for a trial only, the bundled store: a community MinIO build; celld does not qualify it for
# production (README, Object store). Replace gce with local-store in COMPOSE_PROFILES and set:
# CELLD_BUCKET=s3://celld-fleet
# S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=sam-objectstore
# R2_S3_REGION=us-east-1   # REQUIRED for every s3:// operator store
# AWS_SECRET_ACCESS_KEY=   # at least 24 characters (the store refuses less): openssl rand -hex 24

# Loopback ports (host network). Change only on conflict, and only here: a variable set in the
# shell overrides this file for docker compose (and the deploy), and Caddy refuses to start if any
# port lies in the reverse-tunnel range below.
# CELLD_PORT=8080
# CELLD_INTERNAL_PORT=7001
# FRPS_BIND_PORT=7000
# OBJECTSTORE_PORT=9000
# OBJECTSTORE_CONSOLE_PORT=9001
# HTTP_PORT=80
# HTTPS_PORT=443
# MAIL_COLLECTOR_SMTP_PORT=1025 and MAIL_COLLECTOR_UI_PORT=8025 (below), and the port of
# SAM_MX_LISTEN (sam-mx, default :25), are box ports too.

# Presigned browser uploads (attachments, snapshots) go straight to the fleet bucket. Set the
# store's public HTTPS endpoint here and a credential scoped to <bucket>/<prefix>/r2/<R2 bucket>/*
# as R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in .state/secrets.env (never the fleet credential).
# The deploy derives the bucket and key prefix. Unset: presigned uploads stay off.
# R2_S3_REGION is the store's SigV4 signing region: "auto" by default for a gs:// bucket,
# REQUIRED for every s3:// operator store (MinIO usually us-east-1), including backup/restore.
# R2_S3_ENDPOINT=https://storage.googleapis.com
# R2_S3_REGION=auto

# Email sign-in (README, Email sign-in). Either an SMTP relay (SMTP_PASSWORD goes in
# .state/secrets.env):
# SMTP_HOST=smtp.example.com
# SMTP_TLS=starttls
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_FROM=sign-in@sam.example.com
# or, on a TEST install only, add `mail-collector` to COMPOSE_PROFILES: Mailpit catches every
# sign-in email for https://mail.SAM_DOMAIN, and anyone who can read it can sign in as any
# account. Its loopback ports and UI host label:
# MAIL_COLLECTOR_SMTP_PORT=1025
# MAIL_COLLECTOR_UI_PORT=8025
# MAIL_COLLECTOR_HOST_LABEL=mail

# Inbound agent email (README, Inbound agent email): add `mail-in` to COMPOSE_PROFILES (needs
# SMTP_HOST or the mail collector for replies), an MX record agents.SAM_DOMAIN -> mx.SAM_DOMAIN
# and inbound tcp/25. Optional limits and settings:
# SAM_MX_MAX_MESSAGE_BYTES=5242880
# SAM_MX_MAX_CONNECTIONS=20
# SAM_MX_MAX_CONNECTIONS_PER_IP=3
# SAM_MX_MAX_SESSION=15m
# SAM_MX_CONNECTIONS_PER_IP_PER_MINUTE=30
# SAM_MX_MESSAGES_PER_CONNECTION=10
# Smoke tests from the box only (skips SPF/DKIM/DMARC for these loopback networks):
# SAM_MX_TRUSTED_NETWORKS=127.0.0.1/32

# DNS on the box (README, DNS on the box): add `dns` to COMPOSE_PROFILES, delegate SAM_DOMAIN to
# this box once (NS + glue in the parent zone), open inbound udp/53 and tcp/53, and set
# SAM_TLS_MODE=dns-rfc2136. The box then answers for SAM_DOMAIN itself (app deployment routes
# included) and no wildcard record is needed in the parent zone.
# SAM_DNS_PUBLIC_IPV4=203.0.113.5
# SAM_DNS_PUBLIC_IPV6=
# NS name; default ns1.SAM_DOMAIN (needs glue). A name outside SAM_DOMAIN needs no glue.
# SAM_DNS_NAMESERVER=
# SAM_DNS_TTL=3600
# SAM_DNS_RATE_LIMIT=20
# SAM_DNS_UPDATE_PORT=8053

# Loopback ports frps may bind for node tunnels (default 20000-29999, at most 20000 ports). The
# deploy script writes the resolved range to both the Worker and .state/gateway.env, so change
# it here only. The deploy fails if the range contains any port above or a size over the cap.
# REVERSE_TUNNEL_PORT_RANGE_START=20000
# REVERSE_TUNNEL_PORT_RANGE_END=29999
# frps drops a node that has not heartbeated for this many seconds (60-3600, default 90); the
# Worker gets the same value and never reissues a released port before twice this age.
# REVERSE_TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=90
# Optional: a longer minimum age before a released port is reissued (default and floor 2 x the
# heartbeat timeout).
# REVERSE_TUNNEL_PORT_REUSE_MIN_AGE_SECONDS=180

# Where `pnpm selfhost:deploy` keeps platform keys, gateway.env and the celld project.
# SAM_SELFHOST_STATE_DIR=./.state

# Encrypted backups and automatic upgrade recovery require a separate operator-owned raw
# 32-byte key, mode 0600. Keep it outside state and backup directories, with an offline copy.
# Generate it directly into a private file; never print it (README, Backup and restore).
# Use an absolute path: this file does not expand $HOME.
# SAM_BACKUP_KEY_FILE=/absolute/private/path/to/backup.key

# frp connections Caddy accepts per client address per window at wss://api.SAM_DOMAIN/~!frp
# (each one is a Login the Worker checks). Nodes keep one connection each; raise it if many nodes
# share one public address (a NAT gateway). Window: 1s-99s, 1m-99m or 1h.
# SAM_FRP_LOGIN_RATE_LIMIT_EVENTS=60
# SAM_FRP_LOGIN_RATE_LIMIT_WINDOW=1m

# Keep-warm: Caddy pings celld's /health so a retired Worker isolate is restarted by the ping,
# not by a user's request. off turns it off; the interval must be 1s-6s.
# SAM_KEEP_WARM=on
# SAM_KEEP_WARM_INTERVAL=5s
# Caddy's access log is capped at about CADDY_LOG_MAX_SIZE x CADDY_LOG_MAX_FILES on disk.
# CADDY_LOG_MAX_SIZE=50m
# CADDY_LOG_MAX_FILES=5

# celld tuning (defaults shown).
# CELLD_LTX_RETENTION_SECS=86400
# CELLD_FETCH_TIMEOUT_S=3600
# Per-isolate V8 heap ceiling in MB (not a reservation). SAM's bundle idles near 100 MB, and celld
# serves a heap-condemned isolate again only below 75% of this, so keep it well above 133.
# CELLD_V8_HEAP_LIMIT_MB=384
# Restart celld after this many consecutive cron ticks hit celld's heap refusal; 0 disables
# (use 0 to stop a restart loop while investigating).
# SAM_CELLD_HEAP_RESTART_TICKS=2

# Kernel egress fence: celld must have a uid distinct from Caddy7101/mx7102/proxy65532.
CELLD_UID=7103
# Extra exact IP:TCP-port endpoints; metadata/reserved addresses and Caddy admin2019 refused.
SAM_EGRESS_ALLOW=
# gs:// requires the gce profile; the broker returns only fleet-bucket object access.
# GCE_METADATA_PROXY=on
GCE_METADATA_PROXY_PORT=7180
GCE_METADATA_PROXY_SCOPES=https://www.googleapis.com/auth/devstorage.read_write
# Only 0.01/0.05/0.1 are supported to maintain the <=1s measured stop contract.
SAM_EGRESS_FENCE_CHECK_SECONDS=0.1
SAM_EGRESS_FENCE_RECHECK_SECONDS=0.1
# Deploy/init existing-stack discovery/reconciliation command timeout (milliseconds).
# SELFHOST_COMPOSE_TIMEOUT_MS=60000

# Sealed secrets (README, Sealed secrets): ON BY DEFAULT. Leave SAM_KEY_PROVIDER unset and
# `pnpm selfhost:deploy --init` picks the key provider itself (cloud KMS through this VM's own
# identity when a key is set up for it, otherwise a key file on this box) and records why in
# .state/key-agent/choice.json (`pnpm selfhost:secrets status`). A box sealed with the key file
# can never be replaced or rebuilt on another machine. Set it only to override:
# SAM_KEY_PROVIDER=file            # or transit | gcp-kms | azure-kv | aws-kms
# SAM_KEY_PROVIDER=legacy-plaintext  # LEGACY: every Worker secret stored in plaintext in the bucket
# SAM_KEY_AGENT_PORT=7190          # loopback port of the key agent (outside the node lease range)
# Limits (defaults shown): how long the Worker keeps secrets before asking again and for how long
# at most it rides out an unreachable agent on its copy, how long the agent rides out an
# unreachable key service on a copy it opened, and its connection limits. Each cache window
# (TTL, CACHE_SECONDS) is capped by its MAX_STALE bound.
# SAM_RUNTIME_SECRETS_TTL_MS=300000
# SAM_RUNTIME_SECRETS_MAX_STALE_MS=21600000
# SAM_KEY_AGENT_TIMEOUT_MS=3000
# SAM_KEY_AGENT_CACHE_SECONDS=300
# SAM_KEY_AGENT_STALE_WAIT_MS=1000
# SAM_KEY_AGENT_MAX_STALE_SECONDS=21600
# SAM_KEY_AGENT_CONNECTION_TIMEOUT_MS=5000
# SAM_KEY_AGENT_MAX_CONNECTIONS=64
# SAM_TRANSIT_ADDR=https://vault.example.com:8200
# SAM_TRANSIT_KEY=sam-box
# SAM_TRANSIT_ROLE_ID=...          # secret id in .state/key-agent/credentials/transit-secret-id
# SAM_GCP_KMS_KEY=projects/P/locations/L/keyRings/R/cryptoKeys/K
# SAM_GCP_KMS_LOCATION=global      # location of the bootstrap-created key ring (automatic choice)
# SAM_AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net   # Azure: the vault (key name defaults to sam-<hash>)
# SAM_METADATA_PROBE_TIMEOUT_MS=1500  # how long --init waits for each cloud metadata service
# SAM_AWS_KMS_KEY_ID=alias/sam-<hash>  # AWS: key id, ARN or alias (default: the setup's alias)
# SAM_AWS_KMS_REGION=eu-west-1     # AWS: defaults to the instance's region
