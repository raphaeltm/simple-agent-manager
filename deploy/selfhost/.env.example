# Copy to .env, then `chmod 600 .env`: the bucket credential below controls the whole install
# (celld keeps Worker secrets in plaintext in the bucket's deploy manifests).

# Base domain. Point a wildcard DNS record *.SAM_DOMAIN at this box. SAM serves api., app.,
# ws-<id>. and ws-<id>--<port>. under it; the apex is not used.
SAM_DOMAIN=sam.example.com

# TLS: `internal` (Caddy's local CA, local proofs only) or `dns-googleclouddns` (Let's Encrypt
# wildcard via DNS-01; needs GCP_PROJECT, and the VM's service account must be able to edit the
# Cloud DNS zone). Other providers: add caddy/tls/dns-<provider>.caddy and set CADDY_DNS_MODULE.
# ACME_EMAIL is optional (empty registers an account with no contact address). Set ACME_CA to
# https://acme-staging-v02.api.letsencrypt.org/directory for a first trial issuance, then unset
# it (Let's Encrypt production) and restart caddy.
SAM_TLS_MODE=internal
ACME_EMAIL=
# ACME_CA=
GCP_PROJECT=
# CADDY_DNS_MODULE=github.com/caddy-dns/googleclouddns@v1.1.0

# Optional services: `tunnel` runs frps for nodes; `local-store` runs the bundled object store.
COMPOSE_PROFILES=tunnel

# Fleet bucket. Google Cloud Storage via Application Default Credentials (on GCE, the VM's
# service account needs roles/storage.objectAdmin on the bucket):
CELLD_BUCKET=gs://my-sam-bucket/celld
# Or the bundled store (add local-store to COMPOSE_PROFILES):
# CELLD_BUCKET=s3://celld-fleet
# S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=sam-objectstore
# AWS_SECRET_ACCESS_KEY=   # openssl rand -hex 24

# Loopback ports (host network). Change only on conflict.
# CELLD_PORT=8080
# CELLD_INTERNAL_PORT=7001
# FRPS_BIND_PORT=7000
# OBJECTSTORE_PORT=9000
# OBJECTSTORE_CONSOLE_PORT=9001
# HTTP_PORT=80
# HTTPS_PORT=443

# Presigned browser uploads (attachments, snapshots) go straight to the fleet bucket. Set the
# store's public HTTPS endpoint here and a credential scoped to <bucket>/<prefix>/r2/<R2 bucket>/*
# as R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in .state/secrets.env (never the fleet credential).
# The deploy derives the bucket and key prefix. Unset: presigned uploads stay off.
# R2_S3_ENDPOINT=https://storage.googleapis.com
# R2_S3_REGION=auto

# Email sign-in (README, Email sign-in). Either an SMTP relay (SMTP_PASSWORD goes in
# .state/secrets.env):
# SMTP_HOST=smtp.example.com
# SMTP_TLS=starttls
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_FROM=sign-in@sam.example.com
# or, on a TEST install only, add `mail-collector` to COMPOSE_PROFILES: Mailpit catches every
# sign-in email for https://mail.SAM_DOMAIN, and anyone who can read it can sign in as any
# account. Its loopback ports and UI host label:
# MAIL_COLLECTOR_SMTP_PORT=1025
# MAIL_COLLECTOR_UI_PORT=8025
# MAIL_COLLECTOR_HOST_LABEL=mail

# Loopback ports frps may bind for node tunnels (default 20000-29999, at most 20000 ports). The
# deploy script writes the resolved range to both the Worker and .state/gateway.env, so change
# it here only. The deploy fails if the range contains any port above or a size over the cap.
# REVERSE_TUNNEL_PORT_RANGE_START=20000
# REVERSE_TUNNEL_PORT_RANGE_END=29999
# frps drops a node that has not heartbeated for this many seconds (60-3600, default 90); the
# Worker gets the same value and never reissues a released port before twice this age.
# REVERSE_TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=90
# Optional: a longer minimum age before a released port is reissued (default and floor 2 x the
# heartbeat timeout).
# REVERSE_TUNNEL_PORT_REUSE_MIN_AGE_SECONDS=180

# Where `pnpm selfhost:deploy` keeps platform keys, gateway.env and the celld project.
# SAM_SELFHOST_STATE_DIR=./.state

# celld tuning (defaults shown).
# CELLD_LTX_RETENTION_SECS=86400
# CELLD_FETCH_TIMEOUT_S=3600
